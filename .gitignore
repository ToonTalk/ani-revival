# Large or regenerable source material (see sources/README.md)
sources/pdf/
sources/film/frames/
sources/pages/
sources/flipbook/frames/
sources/flipbook/flipbook.mp4
node_modules/
__pycache__/
*.pyc

# Regenerable code listings (tools/fasl.py --all, tools/pdump.py --all)
reports/fasl/code/
reports/pdump/*.code.txt

# A digitized signature of someone else (Fannie, in the Scrabble program),
# kept out of git. Ken's own digitized photos are in git (his decision, 8 Oct).
reports/images/*fannie.window*
reports/archives/3100153_fannie.scrab/fannie.signit
reports/archives/3100153_fannie.scrab/fannie.window

# The film's frames and videos (tools/run-scene.mjs --png, make-film.py, compare-flipbook.py)
reports/film/*/*.png
!reports/film/compare/*.png
reports/film/**/*.mp4

# Built by tools/build-ani-bundle.mjs and tools/bundle-js.mjs (test/rerun.html reads them)
app/data/ani-bundle.json
app/data/ani-runtime.js

# The narration of "Cinderella 1978", taken off the MP4 and cleaned (tools/clean-narration.sh)
reports/film/narration/*.wav
reports/film/narration/*.m4a
reports/film/narration/*.webm
reports/film/narration/frames.json
