{
  "name": "ani-revival",
  "private": true,
  "description": "Reviving Ani, Ken Kahn's 1979 story-to-animation system, from the original MacLisp and Director code",
  "type": "module",
  "scripts": {
    "test": "node --test \"test/*.test.js\"",
    "test:golden": "node tools/check-1978.mjs",
    "test:stress": "node tools/check-stress.mjs",
    "test:no-change": "node tools/check-no-change.mjs",
    "test:ext": "node tools/check-ext.mjs --extensions appear",
    "test:ext24": "node tools/check-ext.mjs --extensions mend,appear --fps 24",
    "test:appear": "node tools/check-appear.mjs",
    "xref": "node tools/xref.mjs"
  }
}
