

(TIME-OF (BEGINNING-OF AGN) (SAME-AS (BEGINNING-OF ACUTE-PHASE))) 

(TIME-OF (BEGINNING-OF ACUTE-PHASE)
	 (SAME-AS (BEGINNING-OF (ANOREXIA HEMATURIA
					  WEAKNESS
					  OLIGURIA
					  PROTEINURIA
					  HYPERTENSION
					  PERIORIBITAL
					  EDEMA
					  HEADACHES)))) 

(TIME-OF (BEGINNING-OF LATENT-PHASE)
	 (SAME-AS (BEGINNING-OF STREP-INFECTION))) 

(TIME-OF (END-OF LATENT-PHASE) (SAME-AS (BEGINNING-OF ACUTE-PHASE))) 

(DURATION LATENT-PHASE
	  (NEVER (INTERVAL (DAYS 0.) (DAYS 2.)))
	  (VERY-RARELY (INTERVAL (DAYS 2.) (DAYS 6.)))
	  (USUALLY (INTERVAL (WEEKS 1.) (WEEKS 2.)))
	  (OCCASSIONALY (INTERVAL (WEEKS 2.) (WEEKS 4.)))
	  (NEVER (INTERVAL (WEEKS 4.) (YEARS 99.)))) 

;;;SHOULD THE NEVERS BE IMPLICIT OR (LESS-THAN (DAYS 2)) AND
;;;(GREATER-THAN (WEEKS 4))

(TIME-OF (END-OF ACUTE-PHASE)
	 (SAME-AS (DIURESIS (LESS HYPERTENSION)
			    (STATUS EDEMA ABSENT)))) 

(DURATION ACUTE-PHASE
	  (RARELY (INTERVAL (DAYS 1.) (DAYS 2.)))
	  (USUALLY (INTERVAL (DAYS 3.) (DAYS 10.)))
	  (POSSIBLY (INTERVAL (DAYS 10.) (WEEKS 3.)))
	  ;;;5-10%
	  (RARELY (INTERVAL (WEEKS 3.) (WEEKS 4.)))) 

;;;2%

(DURATION ALBUMURIA (USUALLY (INTERVAL (WEEKS 3.) (MONTHS 6.)))) 

(DURATION MICROSCOPIC-HEMATURIA
	  (USUALLY (INTERVAL (MONTHS 3.) (MONTHS 6.)))) 

(TIME-OF STREP-EXPOSURE
	 (BEFORE (BEGINNING-OF STREP-INFECTION)
		 (USUALLY (INTERVAL (DAYS 2.) (DAYS 6.)))
		 (SOMETIMES (INTERVAL (WEEKS 1.) (MONTHS 1.))))) 

(DURATION STREP-INFECTION
	  (USUALLY (INTERVAL (DAYS 4.) (DAYS 10.)))
	  (SOMETIMES (INTERVAL (DAYS 1.) (DAYS 4.)))
	  (OCCASSIONALY (INTERVAL (DAYS 10.) (MONTHS 1.)))) 

(TIME-OF (BEGINNING-OF STREP-INFECTION)
	 (SAME-AS (*1 FEVER
		      MALAISE
		      SORE-THROAT
		      PHARYNGTIS
		      OR
		      TONSILITIS))) 

(TIME-OF (END-OF STREP-INFECTION) (SAME-AS (DISAPEARENCE-OF *1))) 

(DIFFERNTIAL-DIAGNOSIS CHRONIC-GLOMERULNEPHRITIS
		       (DURATION LATENT-PERIOD
				 (INTERVAL (DAYS 0.) (DAYS 2.)))) 
