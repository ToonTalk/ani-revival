

(TYPICALLY (TIME-OF (BEGINNING-OF AGN)
		    (SAME-AS (BEGINNING-OF (*1 (AND (OR PHARYNGTIS
							TONSILLITIS)
						    (AND FEVER
							 MALAIS))))))) 

(TIME-OF (END-OF *1) (AFTER (BEGINNING-OF AGN) A-FEW-DAYS)) 

(TIME-OF (*2 AND ANOREXIA WEAKNESS SCANTY-URINE SMOKY-URINE)
	 (AFTER (BEGINNING-OF AGN) (INTERVAL (WEEKS 1.) (WEEKS 2.)))) 

(TIME-OF (AND PERIORBITAL-EDEMA SHORTNESS-OF-BREATH HEADACHE)
	 (AFTER *2 (INTERVAL (DAYS 0.) (DAYS 1.))))

(TIME-OF (BEGINNING-OF ACUTE-OF-PHASE-AGN) (SAME-AS *2))
 

(TIME-OF (LOTSA DOCTOR FINDINGS) (SAME-AS (BEGINNING-OF ACUTE-OF-PHASE-AGN))) 

(TIME-OF (GRADUAL-ABATEMENT SYMPTOMS) (AFTER (BEGINNING-OF ACUTE-OF-PHASE-AGN) A-FEW-DAYS)) 

(TIME-OF (STATUS PROTEINURIA ABSENT) (AFTER *1 MANY-MONTHS)) 

;;;THAT WAS FROM THE "GENERAL PICTURE" NOW THE NITTY GRITTY.

(TIME-OF (RISE-IN ASO-TITER)
	 (AFTER STREP-INFECTION (INTERVAL (WEEKS 3.) (WEEKS 1.)))) 

(TIME-OF (MAXIMUM ASO-TITER)
	 (AFTER STREP-INFECTION (INTERVAL (WEEKS 5.) (WEEKS 3.)))) 

(TIME-OF (BEGINNING-OF LATENT-PERIOD) (SAME-AS (END-OF *1))) 

(TIME-OF (END-OF LATENT-PERIOD) (SAME-AS (BEGINNING-OF ACUTE-OF-PHASE-AGN))) 

(USUALLY (DURATION LATENT-PERIOD (INTERVAL (WEEKS 1.) (WEEKS 2.)))) 

(SOMETIMES (DURATION LATENT-PERIOD  (INTERVø3(‰AYS 3.) (DAYS 7.)))) 

(OCCASIONALLY (DURATION LATENT-PERIOD
			(INTERVAL (WEEKS 3.) (WEEKS 4.)))) 

(NEVER (DURATION LATENT-PERIOD (INTERVAL (MONTHS ö+” QYEARS 99.)))) 

(ALMOST-ALWAYS (TIME-OF (INCREASE-IN ERYTHROCYTE-SEDIMENTATION-RATE)
			(DURING (?EARLY-PHASE-OF-AGN?)))) 

(INFREQUENTLY (TIME-OF NEPROTIC-SYNDROME
