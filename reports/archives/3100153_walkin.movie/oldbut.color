
MAKE 'STICKMEN 'NIL
MAKE 'LOGOBREAK 'T
MAKE 'GAP '78.975
MAKE 'NOTCHES '20
MAKE 'NOTCH.Y '370
MAKE 'LEGS.Y '-25
MAKE 'TWO.LEGS 'NIL
MAKE 'STATIONARY.CAMERA 'T
MAKE 'LISPBREAK 'T
MAKE 'EDITMODE 'NIL
MAKE 'REDEFINE 'NIL
MAKE 'OUTLINE 'NIL

TO SHOOT.MAN :ANGLE
5 IF :ANGLE < 0 THEN STOP
10 CLEARSCREEN
20 PENUP FORWARD 100 PENDOWN
30 STICKMAN :ANGLE
40 MAKE 'STICKMEN CONS SNAP :STICKMEN
50 STOOT.MAN :ANGLE-5
END

TO VEE :ANGLE
10 RIGHT :ANGLE
20 FORWARD 100
25 BACK 100
30 LEFT :ANGLE * 2
40 FORWARD 100
45 BACK 100
50 RIGHT :ANGLE
END

TO STICKMAN :ANGLE
10 CIRCLE 60
20 PENUP
30 BACK 60
40 PENDOWN
50 BACK 100
60 VEE 45
70 BACK 100
80 RIGHT 180
90 VEE :ANGLE
END

TO PROJECT :SPOKES :SIZE :SPEED :TIME
3 TVSIZE FIX (:NOTCHES * :GAP * ((CADR (TVSIZE)) / (CADR (TURTLESIZE)))) (CADR (TVSIZE))
4 PENUP
5 IF :SPOKES = 2 THEN FILLARRAY 'THE.COLORS [RED RED] ELSE FILLARRAY 'THE.COLORS [YELLOW CYAN PINK RED ORANGE MAGENTA PURPLE BLUE WHITE GREY BROWN GOLD GREEN]
6 DELX (CAR (TURTLESIZE)) * 0.5 - :SPEED
7 SETHEAD 185 DELY :LEGS.Y
8 PENUP
9 DELX :SPEED + LEG.SPEED :SPEED
10 DRAW.NOTCH
11 DELX $-$ ((LEG.SPEED :SPEED) + :SPEED)
15 PENDOWN
20 IF BOTH :SPOKES = 2 HEADING = 160 THEN TWO.LEGS :SIZE ELSE WHEEL :SPOKES :SIZE
30 PAUSE.OR.BREAK :TIME
35 PENCOLOR :ERASERCOLOR ERASERDOWN
40 IF BOTH :SPOKES = 2 HEADING = 160 THEN TWO.LEGS :SIZE ELSE WHEEL :SPOKES :SIZE
43 IF NOT :STATIONARY.CAMERA THEN ERASE.NOTCHS
45 ERASERUP
50 LEFT 5
52 IF :SPOKES = 2 THEN IF HEADING = 155 THEN RIGHT 30
53 PENUP
55 DELX LEG.SPEED :SPEED
57 PENDOWN
60 IF :STATIONARY.CAMERA THEN GO 20 ELSE GO 8
END

TO ERASE.NOTCHS
5 LOCAL 'BEGIN
8 MAKE 'BEGIN HERE
10 PENUP DELY '-0.5 * :NOTCH.Y
15 SETX 0
20 ERASERDOWN
30 FILLWINDOW (FIX (FIRST (TURTLESIZE)) * 0.49) 50
40 ERASERUP
50 SETTURTLE :BEGIN
END

TO DRAW.NOTCH
10 PENUP DELY $-$ :NOTCH.Y
20 NOTCH (FIRST (TURTLESIZE)) :GAP
30 PENUP DELY :NOTCH.Y
35 DELX '-3
40 PENDOWN
END

TO NOTCH :DIST :GAP
1 IF :DIST < 0 THEN STOP
5 PENDOWN
10 RIGHT 90 FORWARD 100 BACK 100 LEFT 90 PENUP FORWARD :GAP
30 NOTCH :DIST - :GAP :GAP
END

TO INIT
10 ARRAY THE.COLORS T 16
20 CLEARSCREEN
30 WRAP
END

TO WHEEL :N :SIZE
10 WHEEL1 :N :SIZE
20 LEFT 30 * :N
END

TO WHEEL1 :N :SIZE
10 IF :N = 0 THEN STOP
15 PENCOLOR THE.COLORS :N
20 FORWARD :SIZE RIGHT 90 FORWARD :SIZE / 10
30 BACK :SIZE / 10 LEFT 90 BACK :SIZE
40 RIGHT 30
50 WHEEL1 :N - 1 :SIZE
END

TO SUPERWIPE
10 IF (STATUS FEATURE COLOR) THEN ERASERDOWN FILLWINDOW ERASERUP ELSE WIPECLEAN
END

TO PAUSE.OR.BREAK :TIME
10 IF NUMBERP :TIME THEN SLEEP :TIME ELSE PRINT 'SHOOT (TYI)
END

TO WALK
5 MAKE 'LEGS.Y '-25
8 MAKE 'NOTCH.Y 370
10 MAKE 'GAP 78.975
15 MAKE 'NOTCHES 20
20 PROJECT 2 300 26.75 0.2
END

TO TWO.LEGS :SIZE
3 IF NOT :TWO.LEGS THEN WHEEL 2 :SIZE STOP
5 RIGHT 20
7 PENCOLOR THE.COLORS 2
10 WHEEL 1 :SIZE
20 RIGHT 10
25 PENCOLOR THE.COLORS 1
30 WHEEL 1 :SIZE
40 LEFT 30
END

TO LEG.SPEED :SPEED
5 IF :STATIONARY.CAMERA THEN OUTPUT $-$ :SPEED
10 IF XCOR > 0 THEN OUTPUT $-$ XCOR / (CAR (TURTLESIZE)) * :SPEED * 2.0 ELSE OUTPUT 0
END
