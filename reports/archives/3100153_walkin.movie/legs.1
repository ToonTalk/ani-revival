
MAKE 'OUTLINE 'NIL
MAKE 'WHEEL.LIST '(G0017 G0016 G0015 G0014 G0013)
MAKE 'GAP '87.646153

TO PROJ2 :FRAME
10 SHOWWINDOW :FRAME
20 DISPLAY 'NOTCHES
30 SLEEP :TIME
40 WIPE
50 FORWARD :STEP
END

TO MAKE.WHEEL :SPOKES
1 CLEARSCREEN
2 WRAP
5 TURTLESIZE 2000
10 MAKE 'WHEEL.LIST NIL
20 TVSIZE 550 300
25 IF :SPOKES = 2 THEN RIGHT 155
30 MOVE.WHEEL 5 :SPOKES
END

TO TURN
10 SHOWWINDOW 'FOO
15 SLEEP 0.1
18 WIPE
20 TURN
END

TO MOVIE :N
1 IF :N = 0 THEN STOP
4 PENUP
5 SETXY 0 0
6 PENDOWN
10 FORWARD 100 RIGHT 90 FORWARD 100
20 MAKE 'SHOW CONS SNAP :SHOW
25 WIPE
30 RIGHT 10
40 MOVIE :N - 1
END

TO WHEEL :N
10 IF :N = 0 THEN STOP
20 FORWARD 200 RIGHT 90 FORWARD 20
25 LEFT 90
30 PENUP SETXY 0 0 PENDOWN
40 RIGHT 30
50 WHEEL :N - 1
END

TO MOVE.WHEEL :N :SPOKES
10 IF :N = 0 THEN STOP
20 WHEEL :SPOKES
25 LEFT 60
30 MAKE 'WHEEL.LIST CONS SNAP :WHEEL.LIST
40 WIPE
50 RIGHT 5
60 MOVE.WHEEL :N - 1 :SPOKES
END

TO PROJECT :FILM :TIME :MOVE.NOTCHES?
10 IF :MOVE.NOTCHES? THEN MAPC 'PROJ2 :FILM ELSE MAPC 'PROJ1 :FILM
20 GO 10
END

TO PROJ1 :FRAME
10 DISPLAY :FRAME
20 SLEEP :TIME
30 WIPE :FRAME
40 FORWARD :STEP
END

TO PROJ :STEP :MOVE.NOTCHES?
6 DRAW.NOTCH
7 HOME LEFT 90
10 PROJECT :WHEEL.LIST 0.1 :MOVE.NOTCHES?
END

TO NOTCH :DIST :GAP
1 IF :DIST < 0 THEN STOP
5 PENDOWN
10 RIGHT 90 FORWARD 100 BACK 100 LEFT 90 PENUP FORWARD :GAP
30 NOTCH :DIST - :GAP :GAP
END

TO DRAW.NOTCH
5 TVSIZE FIX (40 * :GAP * 3.0 / 20) 300
10 CLEARSCREEN PENUP BACK 250 LEFT 90
20 NOTCH (FIRST (TURTLESIZE)) :GAP
END
