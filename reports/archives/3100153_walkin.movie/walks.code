
MAKE 'OUTLINE 'T
MAKE 'REDEFINE 'NIL
MAKE 'EDITMODE 'NIL
MAKE 'LISPBREAK 'NIL
MAKE 'STICKMEN '(G0038 G0039 G0040 G0041 G0042 G0043 G0044 G0045 G0046 G0047 G0046 G0045 G0044 G0043 G0042 G0041 G0040 G0039)
MAKE 'LOGOBREAK 'T
MAKE 'GAP '52.65
MAKE 'NOTCHES '25
MAKE 'NOTCH.Y '275
MAKE 'LEGS.Y '0
MAKE 'TWO.LEGS 'NIL
MAKE 'STATIONARY.CAMERA 'T
MAKE 'LEGS.X '-75
MAKE 'NOTCHES? 'NIL
MAKE 'NOTCH? 'T

TO WALKMEN
10 ERASE WINDOWS
20 GETWINDOWS STICK MEN
30 MAKE 'STICKMEN APPEND :WINDOWS CDR (REVERSE (CDR :WINDOWS))
40 SHOW.WINDOWS :STICKMEN '-17.5 T
END

TO SHOW.EACH :THE.WINDOW
10 DISPLAY :THE.WINDOW
20 PAUSE.OR.BREAK :TIME
25 WIPE :THE.WINDOW
30 DELX :SPEED
END

TO SHOW.WINDOWS :WINDOWS :SPEED :TIME
10 MAPC 'SHOW.EACH :WINDOWS
20 GO 10
END

TO VEE :ANGLE
10 RIGHT :ANGLE
20 FORWARD 100
25 BACK 100
30 LEFT :ANGLE * 2
40 FORWARD 100
45 BACK 100
50 RIGHT :ANGLE
END

TO STICKMAN :ANGLE
10 CIRCLE 60
20 PENUP
30 BACK 60
40 PENDOWN
50 BACK 100
60 VEE 45
70 BACK 100
80 RIGHT 180
90 VEE :ANGLE
END

TO PROJECT :SPOKES :SIZE :SPEED :TIME
4 PENUP
6 DELX (CAR (TURTLESIZE)) * 0.5 - :SPEED
7 SETHEAD 185 DELY :LEGS.Y
8 PENUP
9 DELX :SPEED + LEG.SPEED :SPEED
10 IF :NOTCHES? THEN DRAW.NOTCH
11 DELX $-$ ((LEG.SPEED :SPEED) + :SPEED)
11.5 PENUP
12 DELX :LEGS.X
15 PENDOWN
20 IF BOTH :SPOKES = 2 HEADING = 160 THEN TWO.LEGS :SIZE ELSE WHEEL :SPOKES :SIZE
30 PAUSE.OR.BREAK :TIME
35 ERASERDOWN
40 IF BOTH :SPOKES = 2 HEADING = 160 THEN TWO.LEGS :SIZE ELSE WHEEL :SPOKES :SIZE
43 IF NOT :STATIONARY.CAMERA THEN ERASE.NOTCHS
45 ERASERUP
50 LEFT 5
52 IF :SPOKES = 2 THEN IF HEADING = 155 THEN RIGHT 30
53 PENUP
55 DELX LEG.SPEED :SPEED
57 PENDOWN
60 IF :STATIONARY.CAMERA THEN GO 20 ELSE GO 8
END

TO ERASE.NOTCHS
5 LOCAL 'BEGIN
8 MAKE 'BEGIN HERE
10 PENUP DELY '-0.5 * :NOTCH.Y
15 SETX 0
20 ERASERDOWN
30 FILLWINDOW (FIX (FIRST (TURTLESIZE)) * 0.49) 50
40 ERASERUP
50 SETTURTLE :BEGIN
END

TO DRAW.NOTCH
10 PENUP DELY $-$ :NOTCH.Y
20 NOTCH (FIRST (TURTLESIZE)) :GAP
30 PENUP DELY :NOTCH.Y
35 DELX '-3
40 PENDOWN
END

TO NOTCH :DIST :GAP
1 IF :DIST < 0 THEN STOP
5 PENDOWN
10 DELY 100
20 DELY -100
22 PENUP
25 DELX :GAP
30 NOTCH :DIST - :GAP :GAP
END

TO WHEEL :N :SIZE
10 WHEEL1 :N :SIZE
20 LEFT 30 * :N
END

TO WHEEL1 :N :SIZE
10 IF :N = 0 THEN STOP
20 FORWARD :SIZE RIGHT 90 FORWARD :SIZE / 10
30 BACK :SIZE / 10 LEFT 90 BACK :SIZE
40 RIGHT 30
50 WHEEL1 :N - 1 :SIZE
END

TO SUPERWIPE
10 IF (STATUS FEATURE COLOR) THEN ERASERDOWN FILLWINDOW ERASERUP ELSE WIPECLEAN
END

TO PAUSE.OR.BREAK :TIME
10 IF NUMBERP :TIME THEN SLEEP :TIME ELSE (TYI)
END

TO TWO.LEGS :SIZE
3 IF NOT :TWO.LEGS THEN WHEEL 2 :SIZE STOP
5 RIGHT 20
10 WHEEL 1 :SIZE
20 RIGHT 10
30 WHEEL 1 :SIZE
40 LEFT 30
END

TO LEG.SPEED :SPEED
5 IF :STATIONARY.CAMERA THEN OUTPUT $-$ :SPEED
10 IF XCOR > 0 THEN OUTPUT $-$ XCOR / (CAR (TURTLESIZE)) * :SPEED * 2.0 ELSE OUTPUT 0
END

TO WALK1
5 MAKE 'LEGS.Y 0
7 MAKE 'LEGS.X '-75
8 MAKE 'NOTCH.Y 275
17 MAKE 'NOTCHES? NIL
20 PROJECT 12 200 12 T
END

TO WALK2
5 MAKE 'LEGS.Y 0
7 MAKE 'LEGS.X 0
8 MAKE 'NOTCH.Y 275
17 MAKE 'NOTCHES? T
20 PROJECT 12 200 12 T
END

TO WALK3
5 MAKE 'LEGS.Y 0
7 MAKE 'LEGS.X 0
8 MAKE 'NOTCH.Y 275
17 MAKE 'NOTCHES? T
20 PROJECT 12 200 26.25 T
END

TO WALK4
5 MAKE 'LEGS.Y 0
7 MAKE 'LEGS.X '-75
8 MAKE 'NOTCH.Y 275
17 MAKE 'NOTCH? T
18 MAKE 'TWO.LEGS NIL
20 PROJECT 12 200 17.5 T
END

TO WALK6
5 MAKE 'LEGS.Y 0
7 MAKE 'LEGS.X '-75
8 MAKE 'NOTCH.Y 275
17 MAKE 'NOTCHES? T
18 MAKE 'TWO.LEGS T
20 PROJECT 2 200 17.5 T
END

TO WALK5
5 MAKE 'LEGS.Y 0
7 MAKE 'LEGS.X '-75
8 MAKE 'NOTCH.Y 275
17 MAKE 'NOTCHES? T
18 MAKE 'TWO.LEGS NIL
20 PROJECT 2 200 17.5 T
END
