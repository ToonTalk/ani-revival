remprop 'random 'parse


TO DEFINE.FLOWER
;Logo syntax has been kept since this is built on top of Logo
10 my.declare 'flower '(kind.of obj)
15 flower [if receive handle ?obj (how.to.draw?) then list 'draw.flower (list 'quote :?obj)]
;DECLARE does 3 things:
;	1) updates the "Kind.of" tree with flower as a kind of OBJ
;	2) creates an actor named "Flower".
20 FLOWER [REMEMBER SIZE 10]
;This tells flower to remember that the default size of flowers is 20
;"Remember" is the standard kind of message for telling any actor something
; to remember
30 FLOWER [REMEMBER CENTER [0 1]]
;this tells the flower that for purposes of snaps (windows) that its center
;is size times 1 above the obj.state
40 flower [remember grain 5]
50 FLOWER [REMEMBER ROTATION.SPEED 25]
60 FLOWER [IF RECEIVE HANDLE ?OBJ [SWAY ?N] THEN SWAY :?N :?OBJ]
END


TO SWAY :TIMES :OBJ
10 TELL :OBJ [DO [RT 10] IN 1 FRAME]
20 TELL :OBJ [DO [LT 10] IN 2 FRAMES]
30 IF :TIMES > 1 TELL :OBJ (LIST 'DO (LIST 'SWAY :TIMES-1) 'IN 3 'FRAMES)
END


TO DEFINE.SEED
10 my.DECLARE 'SEED [KIND.OF ACTOR]
; Seed is not an Obj, since it does not do turtle-like things.
20 SEED [IF RECEIVE HANDLE ?SEED [START] THEN DO.SEED.THING :?SEED]
;This simply lets seeds take a "start" message and calls the appropriate procedure.
END

TO DO.SEED.THING :SEED
10 LOCAL 'FLOWER.NAME
;a thing to hold the name for the flower that seed will spawn is needed
20  MAKE 'FLOWER.NAME FLOWER [MAKE]
;After the buck is passed to "Actor", 
;this results in the call "MAKE.INSTANCE 'FLOWER 
;which will create an instantiation of flower with a generated name that is 
;put in the variable "Flower.name".
30 TELL :FLOWER.NAME [RIGHT 90]
;Flowers are objects so can take any turtle command
40 TELL :FLOWER.NAME (list 'FORWARD 1500*RANDOM - 750 )
50 TELL :FLOWER.NAME [LEFT 90]
60 TELL :FLOWER.NAME [DO (SHOW) IN 10 FRAMES]
;This results in the following call:
;   SCHEDULER [DO :FLOWER.NAME SHOW IN 10 FRAMES]
;which schedules the call,
;   TELL :FLOWER.NAME [SHOW],
;ten frames after line 60 is executed.
80 REPEAT.it 5 [TELL :FLOWER.NAME '( DO (GROW 10) AFTER 2 MORE FRAMES)]
70 tell seed [make] [do (start) at that time]
;"At that time" is equivalent to "after 0 more frames".
;	SEED [MAKE] followed by that seed the message "Start"
;at the same time as the last thing scheduled in line 80.
80 REPEAT.it 10 [TELL :FLOWER.NAME '( DO (GROW 10) AFTER 2 MORE FRAMES)]
;This schedules the call, 
;	TELL :FLOWER.NAME [GROW 10],
; 15 times, each time 2 frames after the last.
85 tell :flower.name [do [rt 90] after 35 more frames]
90 tell :flower.name [do [hide] after 15 more frames]
100 TELL :FLOWER.NAME [DO (UN.MAKE) AT that time]
;This schedules the suicide of the flower
END

to repeat.it :times :code
10 if :times = 0 stop
20 run :code
30 make 'times :times - 1
40 go 10
end


