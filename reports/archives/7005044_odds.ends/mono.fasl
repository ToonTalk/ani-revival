(DEFUN INIT NIL 


(SETQ BOARD (LIST '(GO-SQ)
		  'MEDITERANEAN
		  '(CC)
		  'BALTIC
		  '(INCOME-TAX)
		  'READING-RR
		  'ORIENTAL
		  '(CHANCE)
		  'VERMONT
		  'CONNECTICUTT
		  '(JAIL)
		  'ST-CHARLES
		  'ELECTRIC-CO
		  'STATES
		  'VIRGINIA
		  'PENNSYLVANIA-RR
		  'ST-JAMES
		  '(CC)
		  'TENNESEE
		  'NEW-YORK
		  '(FREE-PARKING)
		  'KENTUCKY
		  '(CHANCE)
		  'INDIANA
		  'ILLINOIS
		  'B&O-RR
		  'ATLANTIC
		  'VENTNOR
		  'WATER-WORKS
		  'MARVIN-GARDENS
		  '(GOTO-JAIL)
		  'PACIFIC
		  'NORTH-CAROLINA
		  '(CC)
		  'PENNSYLVANIA
		  'SHORT-LINE-RR
		  '(CHANCE)
		  'PARK-PLACE
		  '(LUXURY-TAX)
		  'BOARDWALK))
(SETQ PLAYERS '(KEN DAVE))       

       (MAPC 'PLAYER-INIT PLAYERS)
       (MAPC 'PROPERTY-INIT BOARD)
	(RPLACD (LAST BOARD) BOARD)
       (RPLACD (LAST PLAYERS) PLAYERS)
       'INITIALIZED) 

(DEFUN PLAYER-INIT (PLAYER) 
       (PUTPROP PLAYER BOARD 'POSITION)
       (PUTPROP PLAYER 1500. 'CASH)
       (PUTPROP PLAYER NIL 'DEEDS)
       (PUTPROP PLAYER NIL 'TURNS-IN-JAIL))

(DEFUN PROPERTY-INIT (PLACE)
(AND (ATOM PLACE)
 (REMPROP PLACE 'OWNER)))
 

(DEFUN TOP-LEVEL NIL 
(PROG NIL
 LOOP
(SETQ PLAYERS (CDR PLAYERS))
       (TURN (CAR PLAYERS))
       (GO 'LOOP)) )

(DEFUN TURN (PLAYER) 
((LAMBDA ( DOUBLE-SW DOUBLES)
(PROG (SHAKE IN-JAIL)
AGAIN
(SETQ IN-JAIL (GET PLAYER 'TURNS-IN-JAIL))
(SETQ SHAKE (SHAKE))
	 	 (COND (IN-JAIL
		   (COND (DOUBLE-SW 
				 (PUTPROP
				  PLAYER
				  NIL
				  'TURNS-IN-JAIL)
				(MOVE PLAYER SHAKE)
				 (GO 'AGAIN))
			 ((> IN-JAIL 2.)
			  (PAY PLAYER
			       'BANK
			       50.
			       'TO-GET-OUTA-JAIL)
			  (PUTPROP PLAYER
				   NIL 'TURNS-IN-JAIL)
			  (MOVE PLAYER SHAKE))
			 (T (PRINT (LIST 
				    PLAYER 'STAYED-IN-JAIL))
			    (PUTPROP
			     PLAYER
			     (1+ IN-JAIL)
			     'TURNS-IN-JAIL))))
	       ((< DOUBLES 3.)
		(MOVE PLAYER SHAKE)
		(AND DOUBLE-SW
		     (GO 'AGAIN)))
	       (T (SEND-TO-JAIL PLAYER)))))
 NIL 0.)) 

(DEFUN SHAKE NIL 
       ((LAMBDA (D1 D2) (PRINT (LIST PLAYER
				     'SHOOK
				     D1
				     '&
				     D2
				     '=
				     (+ D1 D2)))
			(AND (SETQ DOUBLE-SW (= D1 D2))
			     (SETQ DOUBLES (1+ DOUBLES)))
			(+ D1 D2))
	(1+ (RANDOM 6.))
	(1+ (RANDOM 6.)))) 

(DEFUN MOVE (PLAYER SHAKE) 
       (DO-SQ (CAR (PUTPROP PLAYER
			    (MOVE1 SHAKE
				   (GET PLAYER 'POSITION))
			    'POSITION)))) 

(DEFUN MOVE1 (NUMBER PRESENT-POSITION) 
       (DO ((COUNT 1. (1+ COUNT))
	    (POS (CDR PRESENT-POSITION) (CDR POS)))
	   ((= COUNT NUMBER) POS)
	   (AND (EQ (CAAR POS) 'GO-SQ)
		(COLLECT PLAYER
			 'BANK
			 200.
			 'PASSED-GO)))) 

(DEFUN DO-SQ (SQUARE) 
       (PRINC (LIST 'AND 'LANDED 'ON SQUARE))
       (COND ((ATOM SQUARE) (DO-PROPERTY SQUARE)) (T (EVAL SQUARE)))) 

(DEFUN DO-PROPERTY (PLACE) 
       ((LAMBDA (OWNER) (COND ((NULL OWNER) (BUY? PLACE))
			      ((EQ OWNER PLAYER)
			       (PRINT (LIST 'YOU
					    'ALREADY
					    'OWN
					    PLACE)))
			      (T(PAY-RENT PLAYER OWNER PLACE))))
	(GET PLACE 'OWNER))) 

(DEFUN COLLECT (RECIEVER PAYER AMOUNT REASON) 
       (OR (EQ RECIEVER 'BANK)
	   (AND
	    (PRINT (LIST RECIEVER
		    'COLLECTED
		    AMOUNT
		    'DOLLARS
		    'FROM
		    PAYER
		    'BECAUSE
		    REASON))
       (PUTPROP RECIEVER
		(+ (GET RECIEVER 'CASH) AMOUNT)
		'CASH)
       (PAY1 PAYER AMOUNT)))) 

(DEFUN PAY (PAYER RECIEVER AMOUNT REASON)
       (OR (EQ PAYER 'BANK)
	   (AND
	    (PRINT (LIST PAYER 'MUST 'PAY
			RECIEVER AMOUNT
			'CUZ REASON))
	    (PAY1 PAYER AMOUNT)
	    (COLLECT RECIEVER PAYER AMOUNT REASON))))


(DEFUN PAY1 (PAYER AMOUNT) 
       (OR (EQ PAYER 'BANK)
	   ((LAMBDA (CASH) (COND ((< AMOUNT CASH)
				  (PUTPROP PAYER
					   (- CASH AMOUNT)
					   'CASH))
				 (T (PUTPROP PAYER 0. 'CASH)
				    (MUST-RAISE PAYER
					(- AMOUNT CASH)))))
			   (GET PAYER 'CASH)))) 

(DEFUN BUY? (PLACE) 
       (PRINT (LIST 'DO
		    'YOU
		    'WANT
		    'TO
		    'BUY
		    PLACE))
       (PRINT (LIST 'IT 'COSTS (GET PLACE 'PRICE)))
       (COND ((YES?)(PAY PLAYER 'BANK (GET PLACE 'PRICE)
			 (LIST 'BOUGHT PLACE))
		     (PUTPROP PLACE PLAYER 'OWNER)
		     (ADD-TO-LIST  PLAYER 'DEEDS PLACE)
		     (PRINT 'DONE))
	     (T (PRINT'OK))))

(DEFUN PAY-RENT (PLAYER OWNER PLACE)
(PAY PLAYER OWNER (FIGUIRE-RENT  PLACE OWNER)
     (LIST OWNER 'OWNS PLACE)))

(DEFUN FIGUIRE-RENT (PLACE OWNER )
;;;NO HOUSES NOW
((LAMBDA (RENT)
(COND ((EQ RENT 'SPECIAL)
       (COND ((EQ (GET PLACE 'COLOR) 'RR)
	      ((LAMBDA (NO-OF-RR)
		       (COND ((= NO-OF-RR 1.) 25.)
			     ((= NO-OF-RR 2.) 50.)
			     ((= NO-OF-RR 3.) 100.)
			     ((= NO-OF-RR 4.) 200.)))
	       (NO-IN-MONOPOLY PLACE OWNER)))
	     ((EQ (GET PLACE 'COLOR) 'UTILITIES)
	      (COND ((= (NO-IN-MONOPOLY PLACE OWNER) 1.)
		     (* 4. SHAKE))
		    (T (* 10. SHAKE))))))
      ((MONOPOLYP PLACE OWNER)
       (* 2. (CAR RENT)))
      (T (CAR RENT))))
 (GET PLACE 'RENT)))


(DEFUN NO-IN-MONOPOLY (PLACE OWNER)
       (PROG (COLOR-GROUP TEMP)
	     (SETQ TEMP 0.)
	     (SETQ COLOR-GROUP
		   (GET (GET PLACE 'COLOR)
			'MONOPOLY))
LOOP	     (COND ((NULL COLOR-GROUP)
		    (RETURN TEMP))
		   ((EQ (GET (CAR COLOR-GROUP)
			     'OWNER)
			OWNER)
		    (SETQ TEMP (+ TEMP 1.))
		    (SETQ COLOR-GROUP
			  (CDR COLOR-GROUP)))
		   (T (SETQ COLOR-GROUP
			    (CDR COLOR-GROUP))))
	     (GO 'LOOP)))

(DEFUN MONOPOLYP (PLACE OWNER)
       (PROG (COLOR-GROUP)
	     (SETQ COLOR-GROUP
		   (GET
		    (GET PLACE 'COLOR)
		    'MONOPOLY))
LOOP	     (COND
	      ((NULL COLOR-GROUP)
	       (RETURN T))
	      ((NOT (EQ
		     (GET (CAR COLOR-GROUP)
			  'OWNER)
		     OWNER))
	       (RETURN NIL))
	      (T (SETQ COLOR-GROUP
		       (CDR COLOR-GROUP))))
	     (GO 'LOOP)))
		   





(DEFUN ADD-TO-LIST (ATOM PROP ADDITION)
       ((LAMBDA (VALUE)
		(COND (VALUE
		       (RPLACD (LAST VALUE)
			       (LIST ADDITION)))
		      (T (PUTPROP
			  ATOM
			  (LIST ADDITION)
			  PROP))))
	(GET ATOM PROP)))
(DEFUN YES? NIL
(TERPRI)
(PRINC '*)
(EQ (CAR (EXPLODE (READ))) 'Y))


	     
(DEFUN CHANCE NIL 'CHANCE) 

(DEFUN CC NIL 'CC) 

(DEFUN JAIL NIL (PRINT 'JUST-VISITING-JAIL))

(DEFUN GO-SQ NIL 
(COLLECT PLAYER 'BANK 200. 'YOU-LANDED-ON-GO))

(DEFUN GOTO-JAIL NIL
       (SEND-TO-JAIL PLAYER))

(DEFUN SEND-TO-JAIL (PLAYER)
       (SETQ DOUBLE-SW NIL)
       	(PUTPROP PLAYER
		1.
		'TURNS-IN-JAIL)
       (PUTPROP PLAYER
		(MEMBER
		 '(JAIL)
		  BOARD)
		'POSITION)
       (PRINT
	(LIST PLAYER 'SENT-TO-JAIL)))
 

(DEFUN LUXURY-TAX NIL 
       (PAY PLAYER 'BANK 75. 'LUXURY-TAX))

(DEFUN INCOME-TAX NIL 'INC-TAX) 

(DEFUN FREE-PARKING NIL NIL) 
