(DEFUN CONSERV (SUBLIST TRIPLE-LIST)
       (COND ((NULL TRIPLE-LIST) SUBLIST)
	     (T (DO ((I (CAR TRIPLE-LIST) (CDR I)))
		    ((NULL I) 'FOO)
		    (PRINT*
		     (CONSERV (APPEND SUBLIST
				      (LIST (CAR I)))
			      (CDR TRIPLE-LIST)))))))

(DEFUN PRINT* (L) (AND (NULL (EQUAL L 'FOO)) 
		       (GOOD-ENUF L)
		       (SETQ COUNT (1+ COUNT))
		       (PRINT1 L)))



(DEFUN PRINT1 (V)
 (COND ((GOOD-ENUF V)
       (AND (> (CDR (CURSORPOS)) 50.)
	    (TERPRI))
       (PRINC (MAKNAM V))
       (PRINC '/ / / ))))


;;;CHECKS FOR TWO VOWELS
(DEFUN GOOD-ENUF (L)
(AND (VOWELP (CDR (VOWELP  L)))
     (NEXT-LETTER-FOLLOWS L)))

(DEFUN VOWELP (L)
(DO ((I L (CDR I))
     (VOWELS '(A E I O U Y)))
    ((NULL I) NIL)
    (AND (MEMQ (CAR I) VOWELS)
	 (RETURN I))))

(DEFUN NEXT-LETTER-FOLLOWS (L)
       (DO ((I L (CDR I))
	    (TEMP NIL))
	   ((NULL I) T)
	   (OR (NULL (SETQ TEMP (GET (CAR I) 'CAN-FOLLOW)))
	       (NULL (CADR I))
	       (MEMQ (CADR I) TEMP)
	       (RETURN NIL))))
	       



(DEFUN PHONE-NUMBER N
((LAMBDA (NUMBER-LIST)
  (COND ((OR (MEMQ 1. NUMBER-LIST)
	    (MEMQ 0. NUMBER-LIST))
	 (STORE (NUMBER 4.) '(G H))
	 (STORE (NUMBER 6.) '(M N )))
	(T (STORE (NUMBER 4.) '(G H I))
	   (STORE (NUMBER 6.) '(M N O))))
  (DO ((I NUMBER-LIST
	  (CDR I))
       (COUNT 0.)
       (ANS (TERPRI)))
      ((NULL I) (CONSERV NIL (NREVERSE ANS))COUNT)
      (SETQ ANS (CONS (NUMBER (CAR I)) ANS))))
 (EXPLODE-NUMBER
  (COND ((= N 1.) (ARG 1.))
	(T (AND (PRINT 'PHONE#)
		(READ)))))))

(DEFUN EXPLODE-NUMBER (N)
(DO ((I N (// I 10.))
     (ANS NIL))
    ((ZEROP I) ANS)
    (SETQ ANS (CONS (\ I 10.) ANS))))