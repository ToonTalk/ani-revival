(defun
 compute.y
  (:y :direction) 
   
   10.	(cond
	 ((equal :direction 'standing)
	  (output (plus :y 1.)))
	 (t
	  (cond
	   ((equal :direction 'sleeping) (output :y))
	   (t (logo-print (square-brackets (wrong input
						  to
						  compute.y)))))))
	))
  

(defun
 compute.x
  (:x :direction) 
   
   10.	(cond
	 ((equal :direction 'sleeping)
	  (output (plus :x 1.)))
	 (t
	  (cond
	   ((equal :direction 'standing) (output :x))
	   (t (logo-print (square-brackets (wrong input
						  to
						  compute.x)))))))
	))
  

(defun
 score.letters1
  (:x :y :subtotal) 
   
   10.	(cond ((null (letters :x :y)) (output :subtotal)))
   20.	(cond
	 ((equal (bonus :x :y) 'double.letter)
	  (output
	   (score.letters1
	    (compute.x :x :direction)
	    (compute.y :y :direction)
	    (plus
	     :subtotal
	     (times 2. (value.letter (letters :x :y))))))))
   30.	(cond
	 ((equal (bonus :x :y) 'triple.letter)
	  (output
	   (score.letters1
	    (compute.x :x :direction)
	    (compute.y :y :direction)
	    (plus
	     :subtotal
	     (times 3. (value.letter (letters :x :y))))))))
   40.	(output
	 (score.letters1
	  (compute.x :x :direction)
	  (compute.y :y :direction)
	  (plus :subtotal (value.letter (letters :x :y)))))
	))
  

