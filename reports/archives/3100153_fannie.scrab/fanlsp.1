(defun
 check.word
  (:x :y :direction :word :temp.hand :count.word) 
   
   10.	(cond ((null :word)
	       (cond ((equal :count.word 7.)
		      (output 'bonus))
		     (t (output :temp.hand)))))
   15.	(make 'tile (car :word))
   20.	(cond ((either (both (greaterp (count :word)
					     (difference 16.
							       :x))
			     (equal :direction
					  'sleeping))
		       (both (greaterp (count :word)
					     (difference 16.
							       :y))
			     (equal :direction
					  'standing)))
	       (logo-print (square-brackets (word is
						  too
						  long
						  it
						  wont
						  fit
						  on
						  the
						  board,
						  try
						  again)))
	       (output 'try.again)))
   30.	(cond
	 ((not (equal (letters :x :y) (car :word)))
	  (cond
	   ((not (null (letters :x :y)))
	    (logo-print
	      (sentence (square-brackets (you cant enter))
				   (car :word)
				   (square-brackets (in the
							space
							where))
				   (letters :x :y)
				   (square-brackets (is))))
	    (output 'try.again)))))
   33.	(cond ((equal :direction 'standing)
	       (check.stand :x :y)))
   35.	(cond ((equal :direction 'sleeping)
	       (check.sleep :x :y)))
   36.	(cond ((letters :x :y)
	       (make 'tile 'nothing)
	       (go 40.))
	      (t (make 'count.word
		       (plus :count.word 1.))))
   37.	(cond ( (member (car :word) :temp.hand)
	       (go 40.)))
   38.	(cond ((member (space) :temp.hand)
	       (make 'blank.word
		     (replace (car :word) (space) (car :play)))
	       (make 'blank (car :word))
	       (make 'tile (space))
	       (go 40.)))
   39.	(logo-print
	  (sentence (car :word)
			       (square-brackets (is not
						    a
						    letter
						    in
						    your
						    hand))))
	(output 'try.again)
   40.	(cond ((equal :direction 'standing)
	       (output (check.word :x
				     (plus :y 1.)
				     :direction
				     (cdr :word)
				     (take.out :tile :temp.hand)
				     :count.word)))
	      (t (output (check.word (plus :x 1.)
				       :y
				       :direction
				       (cdr :word)
				       (take.out :tile :temp.hand)
				       :count.word))))
	))
  

