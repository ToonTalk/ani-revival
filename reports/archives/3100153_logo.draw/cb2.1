
MAKE "ORIENATATION" "NIL"
MAKE "NOSE.ORIENTATION" "NIL"
MAKE "RIGHT.ARM.ORIENTATION" "NIL"
MAKE "LEFT.ARM.ORIENTATION" "NIL"
MAKE "MOUTH.KIND" "SMILE"
MAKE "RARM.ORIENTATION" "DOWN"
MAKE "RO" "RARM.ORIENTATION"
MAKE "LARM.ORIENTATION" "DOWN"
MAKE "LO" "LARM.ORIENTATION"


TO DRAW.CB
10 HEAD
15 SETHEAD 270
20 FORWARD 75
30 BODY
40 LARM :LARM.ORIENTATION
60 SETHEAD 90
70 FORWARD 150
80 RARM :RARM.ORIENTATION
END

TO DRAW.PERSON :NAME :FEATURES
5 MAKE "MOUTH.KIND" NIL
6 MAKE "LEFT.ARM.ORIENTATION" NIL
7 MAKE "RIGHT.ARM.ORIENTATION" NIL
8 MAKE "NOSE.ORIENTATION" NIL
10 MAPC "RUN" :FEATURES
20 RUN WORD "DRAW." :NAME
END

TO ONE.EYE
10 RECT 5 10
END

TO EYES
10 PENUP
20 SETHEAD 90
30 FORWARD 30
40 PENDOWN
50 ONE.EYE
60 PENUP
80 BACK 60
90 PENDOWN
100 ONE.EYE
END

TO RIGHT.NOSE
2 SETHEAD 90
4 PENUP
6 FORWARD 10
8 PENDOWN
10 SETHEAD 60
20 POLY 1 5 0.666
END

TO LEFT.NOSE
10 SETHEAD 240
20 POLY 1 5 0.666
END

TO NOSE
4 LOCAL "ORIG.XCOR" "ORIG.YCOR" "ORIENTATION"
6 MAKE "ORIG.XCOR" XCOR
8 MAKE "ORIG.YCOR" YCOR
10 MAKE "ORIENTATION" :NOSE.ORIENTATION
18 IF :ORIENTATION = "LEFT" THEN LEFT.NOSE
20 IF :ORIENTATION = "RIGHT" THEN RIGHT.NOSE
25 IF :ORIENTATION = NIL THEN RIGHT.NOSE
30 PENUP
40 SETXY :ORIG.XCOR :ORIG.YCOR
50 PENDOWN
END

TO DO.ZIGZAG
10 PENUP
20 SETHEAD 270
30 FORWARD 40
40 PENDOWN
50 SETHEAD 45
60 FORWARD 20
70 RIGHT 90
80 FORWARD 30
90 LEFT 90
100 FORWARD 30
110 RIGHT 90
120 FORWARD 30
130 LEFT 90
140 FORWARD 20
END

TO DO.FROWN
10 PENUP
20 SETHEAD 270
30 FORWARD 35
40 SETHEAD 30
50 PENDOWN
60 POLY 4 5 0.3333
END

TO DO.SMILE
10 PENUP
20 SETHEAD 90
30 FORWARD 55
35 RIGHT (-90)
37 FORWARD 25
40 RIGHT 180
45 PENDOWN
50 POLY 4 5 0.5
END

TO DO.LINE
10 SETHEAD 90
20 FORWARD 40
30 RIGHT 180
40 FORWARD 80
END

TO MOUTH
5 LOCAL "ORIG.XCOR" "ORIG.YCOR" "KIND"
7 MAKE "ORIG.XCOR" XCOR
8 MAKE "ORIG.YCOR" YCOR
9 MAKE "KIND" :MOUTH.KIND
10 IF :KIND = NIL THEN MAKE "KIND" "LINE"
20 RUN WORD "DO." :KIND
25 PENUP
30 SETXY :ORIG.XCOR :ORIG.YCOR
40 PENDOWN
END

TO LARM
5 LOCAL "ORIENTATION"
7 MAKE "ORIENATATION" :LEFT.ARM.ORIENTATION
10 IF :ORIENTATION = "UP" THEN SETHEAD 225
20 IF :ORIENTATION = "OUT" THEN SETHEAD 180
30 IF :ORIENTATION = "DOWN" THEN SETHEAD 135
35 IF :ORIENTATION = NIL THEN SETHEAD 150
40 RECT 40 150
END

TO RARM
5 LOCAL "ORIENTATION"
7 MAKE "ORIENTATION" :RIGHT.ARM.ORIENTATION
10 IF :ORIENTATION = "UP" THEN SETHEAD (-225)
20 IF :ORIENTATION = "OUT" THEN SETHEAD (-180)
30 IF :ORIENTATION = "DOWN" THEN SETHEAD (-135)
35 IF :ORIENTATION = NIL THEN SETHEAD (-150)
40 RECT 40 (-150)
END

TO BODY
10 SETHEAD 90
20 RECT 150 250
END

TO RECT :SIDE1 :SIDE2
10 FORWARD :SIDE1
20 RIGHT 90
30 FORWARD :SIDE2
40 RIGHT 90
50 FORWARD :SIDE1
60 RIGHT 90
70 FORWARD :SIDE2
80 RIGHT 90
END

TO HEAD
4 LOCAL "ORIG.XCOR" "ORIG.YCOR"
6 MAKE "ORIG.XCOR" XCOR
8 MAKE "ORIG.YCOR" YCOR
10 SETHEAD 270
20 POLY 10 5 1
30 SETHEAD 0
40 PENUP
50 FORWARD 55
60 PENDOWN
70 MOUTH :MOUTH.KIND
80 SETHEAD 0
90 PENUP
100 FORWARD 88
105 PENDOWN
110 NOSE :NOSE.ORIENTATION
115 PENUP
117 SETHEAD 0
120 FORWARD 20
130 PENDOWN
140 EYES
200 PENUP
210 SETXY :ORIG.XCOR :ORIG.YCOR
220 PENDOWN
END

TO POLY :SIZE :TURN :FRACTION
10 LOCAL "TURNS" "STOP.TURNS"
20 MAKE "TURNS" 0
30 MAKE "STOP.TURNS" :FRACTION * 360
40 FORWARD :SIZE
50 RIGHT :TURN
60 MAKE "TURNS" :TURNS + :TURN
70 IF :TURNS > :STOP.TURNS THEN STOP ELSE GO 40
END
