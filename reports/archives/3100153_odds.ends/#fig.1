(defun box (length width message)
       ((lambda (start-state)
		(pu)
		(wf length width)
		(cond ((= (length message) 1.)(type-word (car message)))
		      (t (fd  width)
			 (do ((i message (cdr i))
			      (n (length message)))
			     ((null i) (sett start-state))
			     (bk (// (* width 2) (1+ n)))
			     (type-word (car i)))))
		(list start-state length width))
	(here)))
		    
(defun type-word (word)
       ((lambda (start-state x)
		(setheading -90)
		(fd (setq x (//$ (float (* (length (explode  word)) *char-width*))
			2.0)))
		(mark word)
		(sett start-state)
		(mw 'wordsnap :xcor (+$ :ycor 6.0) (+$ 5.0 x) 5.0)
		(xw 'wordsnap)
		(sw 'wordsnap :xcor :ycor))
	(here)
	nil))
		

(defun connect (box1 box2 features)
       (pu)
       ((lambda (start-state)
		((lambda (s1 l1 w1 s2 l2 w2)
			 (cond ((> (cadr s1) (cadr s2))
				(sett s1)
				(bk (1+ w1))
				(pd)
				(go-to (list
					(cond ((> (car s1) (car s2))
					       (+ (car s2)
						  (// l2 2)))
					      ((= (car s1) (car s2))
					       (car s2))
					      (t (- (car s2)
						    (// l2 2))))
					(+ (cadr s2)
					   w2
					   1))
				       features)
				(pu))
			       (t 
				(sett s1)
				(fd (1+ w1))
				(pd)
				(go-to (list
					(cond ((> (car s1) (car s2))
					       (+ (car s2)
						  (// l2 2)))
					      ((= (car s1) (car s2))
					       (car s2))
					      (t (- (car s2)
						    (// l2 2))))
					(- (cadr s2)
					   w2
					   1))
				       features)
				(pu)))
			 (sett start-state))
		 (car box1)
		 (cadr box1)
		 (caddr box1)
		 (car box2)
		 (cadr box2)
		 (caddr box2)))
	(here)))

(defun go-to (point features)
 (rt (towards point))
 ((lambda (start-state)
 (cond ((memq 'to+from features)
	(pu)
	(go-lt 16)
	(pd)
	(go-to (cons (- (car point) 16) (cdr point))
	       (list 'arrow 'label (cadr (memq 'to+from features))
		     'where-label 2.5))
	(pu)
	(go-rt 32)
	(pd)
	(go-to (cons (+ (car start-state) 16) (cdr start-state))
	       (list 'arrow 'label (caddr (memq 'to+from features))
		     'where-label 2.5)))
       (t
      (cond ((memq 'label features)
	      (pu)
	      (fd (//$ (float (range point))
		       (cond ((numberp
			       (cadr (memq 'where-label
					   features)))
			      (float
			       (cadr
				(memq 'where-label features))))
			     (t 2.0))))
	      (bk 12)
	      (setq label-state (here))
	      (fd 12)
	      (type-word (cadr (memq 'label features)))
	      (sett start-state)
	      (pd)))
       (cond ((memq 'label features)
	      (go-to label-state nil)
	      (pu)
	      (fd 24)
	      (pd)
	      (go-to point nil))
	     ((memq 'dashed features)
	      (dashed-fd (range point)))
	     ((memq 'double features)
	      (cond ((memq 'arrow features)
		     (double-fd (- (range point) 2))
		     (fd 2))
		    (t (double-fd (range point)))))
	     (t (fd (range point))))
       (cond ((memq 'arrow features)
	      (rt 35)
	      (bk 10)
	      (fd 10)
	      (lt 70)
	      (bk 10)
	      (pu)
	      (sett point))))))
  (here)))

(defun go-lt (n)
(sett (cons (- (car (here)) n)  (cdr (here)))))

(defun go-rt (n)
(sett (cons (+ (car (here)) n)  (cdr (here)))))

(defun dashed-fd (n)
(do ((dist 7 (+ dist 10)))
    ((> dist n)(pd))
    (fd 5)
    (pu)
    (fd 5)
    (pd)))

(defun double-fd (n)
(pu)
(go-lt 2)
(pd)
(fd n)
(pu)
(bk n)
(go-rt 4)
(pd)
(fd n)
(pu)
(go-lt 2)
(pd))
     
(defun ibox (l w message)
       (wf l w)
       (box l w message))


(defun diamond (size message left right)
((lambda (start-state)
       (pu)
       (fd (*$ (float size) .7))
       (rt 135)
       (pd)
       (fd size)
       (set left (list (here) 0 0))
       (rt 90)
       (fd size)
       (rt 90)
       (fd size)
       (set right (list (here) 0 0))
       (rt 90)
       (fd size)
       (pu)
       (sett start-state)
       (ibox (fix (*$ (float size)  .7))
	     (fix (*$ (float size)  .7))
	     message))
 (here)))


	   
