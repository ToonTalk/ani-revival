(defun dot (mess1 mess2)
((lambda (start-state)
       (circle 3)
       (shade)
       (pu)
       (fd (* (length mess1) 12))
       (do ((i mess1 (cdr i)))
	   ((null i) )
	   (type-word (car i))
	   (bk 12))
       (bk 18)
       (do ((i mess2 (cdr i)))
	   ((null i) )
	   (type-word (car i))
	   (bk 12))
       (sett start-state))
 (here)))
       
       
	    



	 
(defun phase (scale mess1 mess2 never boxes total)
(dot mess1 mess2)
(rt 90)
(pd)
(fd (times scale never))
(pu)
(setq begin (here))
(do ((i boxes (cdr i)))
    ((null i) (setq end (here))
	      (bk (times total scale .5)))
    (fd (times scale (caar i) ))
    (box (fix (times scale (caar i) ))
	 (cadr (car i))
	 (caddr (car i)))
    (fd (times scale (caar i) )))
(lt 90)
(bk 60)
(setq bottom (here))
(go-to begin '(dashed))
(sett bottom)
(go-to end '(dashed))
(sett bottom))

