(defun growc (initial inc pattern angle wait)
       (do ((init (progn (xorup) (pu) (sett '(-250 0 0))))
	    (i 36 (1- i))
	    (amt initial (+ inc amt)))
	   ((= i 0) 'done)		       
	   (ht)
	   (xordown)
	   (cond ((eq pattern 'poly) (poly amt angle))
		 ((memq Pattern '(lighttexture texture darktexture)) (shade pattern))
		 (t (sw Pattern)))
	   (xorup)
	   (fd 50)
	   (rt 10)
	   (st)
	   (and wait (tyi))
	   (wipe)))

(defun makefbturt (size)
       (pu)
       (cs)
       (delx -200)
       (pd)
       (fullbird size)
       (pu)
       (rt 30)
       (bk (times size 100.0))
       (shade )
       (mw 'fb)
       (hatch 'fbturt)
       (maketurtle (hw 'fb :xcor :ycor) (hw 'fb :xcor :ycor)))


(DEFPROP FULLBIRD (LAMBDA (:SIZE) (PROG NIL 10 (BIRD (TIMES :SIZE 2)) 20 (FORWARD (TIMES 90 :SIZE)) 30 (RIGHT -30) 40 (FORWARD (TIMES 160 :SIZE)) 50 (RIGHT -15) 60 (FORWARD (TIMES 20 :SIZE)) 70 (RIGHT -15) 80 (FORWARD (TIMES 120 :SIZE)) 90 (RIGHT -15) 100 (FORWARD (TIMES 30 :SIZE)) 110 (RIGHT -15) 120 (FORWARD (TIMES 90 :SIZE)) 130 (RIGHT 130) 140 (FORWARD (TIMES 170 :SIZE)) 150 (RIGHT -30) 160 (FORWARD (TIMES 180 :SIZE)) 170 (RIGHT -30) 180 (FORWARD (TIMES 100 :SIZE)) 190 (RIGHT -45) 200 (FORWARD (TIMES 60 :SIZE)) )) EXPR )


(DEFPROP BIRD2 (LAMBDA (:SIZE) (PROG NIL 10 (BIRD (TIMES :SIZE 1)) 20 (PENUP) 30 (HOME) 40 (FORWARD (TIMES 20 :SIZE)) 50 (PENDOWN) 60 (BIRD (TIMES :SIZE 1)) )) EXPR )


(DEFPROP BIRD (LAMBDA (:SIZE) (PROG NIL 10 (RIGHT 90) 20 (WING (TIMES :SIZE 4)) 30 (WING (TIMES :SIZE -4)) )) EXPR )


(DEFPROP WING (LAMBDA (:SIZE) (PROG NIL 10 (FORWARD (TIMES 10 :SIZE)) 20 (RIGHT 30) 30 (FORWARD (TIMES 20 :SIZE)) 40 (RIGHT 15) 50 (FORWARD (TIMES 10 :SIZE)) 60 (RIGHT 30) 70 (FORWARD (TIMES 30 :SIZE)) 80 (RIGHT 30) )) EXPR )



