(defun mwcirc (size name shadepat drawer)
       (cs)
       (drawer size)
       (or (eq shadepat 'dummy-window) (shade shadepat))
       (ht) (sleep .5)(and want-to-wait (tyi))
       (mw name (times size 1.1))
       (and want-to-wait (tyi))
       (st)
       name)

(defun init nil
       (cs)
       (setq want-to-wait nil)
       (setq lastpat (setq shadepat 'dummy-window))
       (ht)
       (mw 'dummy-window 10)
       (turn-turtle-to-circ)
       (st))

(defun turn-turtle-to-circ nil
       (maketurtle (xw shadepat :xcor :ycor)
		   (xw shadepat :xcor :ycor)))

(defun mwall (drawer number-of-circles initial-size factor want-to-wait)
       (do ((n-left number-of-circles (1- n-left))
	    (size initial-size (times size factor)))
	   ((= n-left 0)(ht))
	   (setq lastpat (mwcirc size (gensym) lastpat drawer))))

(defun move (window speed hide?)
       (cond (hide? (xw window :xcor :ycor))
	     (t (sw window :xcor :ycor)))
       (tyi)
       (and hide? (xw window :xcor :ycor))
       (fd speed)
       (move window speed hide?))



(defun poly1 (:size :angle :begin-heading)
		(forward :size) (and want-to-wait (tyi))
       		(right :angle)
		(cond ((= :begin-heading (heading)))
		      (t (poly1 :size :angle :begin-heading))))

(defun poly (:size :angle)
       (poly1 :size :angle (heading)))

(defun centerhex (size)
       (penup)
       (left 120)
       (forward size)
       (right 120)
       (pendown)
       (poly size 60)
       (pu)
       (right 60)
       (forward size)
       (left 60)
       (pd))

(defun center/.circle (size)
       (penup)
       (left 90)
       (forward size)
       (right 90)
       (pendown)
       (poly (*$ (//$ (float size) 36.0) 6.28) 10)
       (pu)
       (right 90)
       (forward size)
       (left 90)
       (pd))

(defun dummy nil nil)


(defun center/.sq (size)
       (penup)
       (back (//$ (float size) 2.0))
       (left 90)
       (forward (//$ (float size)  2.0))
       (right 90)
       (pendown)
       (poly size 90)
       (penup)
       (forward (//$ (float size) 2.0))
       (right 90)
       (forward (//$ (float size)  2.0))
       (left 90)       )