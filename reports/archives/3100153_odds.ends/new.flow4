
TO PETALS :SIZE :N :color.list
3 LOCAL 'TURN
6 MAKE 'TURN 360.0 / :N
10 RIGHT 45
20 IF :N = 0 THEN LEFT 45 STOP ELSE pencolor f :color.list PETAL :SIZE MAKE 'N :N - 1 RIGHT :TURN
25 make 'color.list se bf :color.list f :color.list
30 GO 20
END

TO PETAL :SIZE
3 LOCAL 'BEGIN
4 MAKE 'BEGIN HERE
5 LEFT 45
10 K.ARC :SIZE 90
20 RIGHT 90
30 K.ARC :SIZE 90
40 RIGHT 135
50 PENUP SETTURTLE :BEGIN
60 PENDOWN
END

TO K.ARC :SIZE :ANGLE
3 LOCAL 'STOP.HEADING
6 MAKE 'STOP.HEADING :HEADING + :ANGLE
10 FORWARD :SIZE
20 RIGHT 5
30 IF :HEADING > :STOP.HEADING THEN STOP ELSE GO 10
END

TO FLOWER :SIZE :N :color.list
10 LOCAL 'BEGIN
20 MAKE 'BEGIN HERE
30 PETALS :SIZE :N :color.list
35 pencolor 'green
40 BACK :SIZE * 32
50 RIGHT 22 PETAL :SIZE * 1.05
60 LEFT 22
70 BACK :SIZE * 8
80 LEFT 33
90 PETAL :SIZE * 0.9
100 RIGHT 33
110 BACK :SIZE * 13
120 PENUP SETTURTLE :BEGIN PENDOWN
END

TO TOP.ROW
10 PENUP FORWARD 300 RIGHT 90 FORWARD 200 LEFT 90
20 PENDOWN FLOWER 2 4 '(yellow red)
30 PENUP LEFT 90 FORWARD 180 RIGHT 90 BACK 30 PENDOWN
40 FLOWER 2.5 5 '(blue yellow)
50 PENUP LEFT 90 FORWARD 140 RIGHT 90 FORWARD 40 PENDOWN
60 FLOWER 1.8 4 '(orange yellow)
END

TO MID.ROW
10 PENUP BACK 125 RIGHT 90 FORWARD 80 LEFT 90 PENDOWN
20 FLOWER 3 6 '(red yellow orange)
30 PENUP BACK 40 RIGHT 90 FORWARD 130 LEFT 90 PENDOWN
40 FLOWER 3.5 8 '(orange yellow red blue)
END

to init.colors
10 makecolor 'orange 1.0 .5 0.0
end

to pencolor :foo
10 print (se 'pen 'is 'now :foo)
end