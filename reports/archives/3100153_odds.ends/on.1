(defun *first-person (number case)
       (cond ((eq number 'singular)
	      (case-rules (nominative 'ek);I
			  (accusative 'mik);me
			  (genitive '|MI'N|);mine
			  (dative '|ME'R|))) ;me as in "by me"? 
	     ((eq number 'dual)
	      (case-rules (nominative 'vit);we two
			  (accusative 'okkr);us two
			  (genitive 'okkar);the two of us's
			  (dative 'okkr)));by the two of us
	     ((eq number 'plural)
	      (case-rules (nominative '|VE'R|);we
			  (accusative 'oss);us
			  (genitive '|VA'R|);our
			  (dative 'oss)))));by us

(defun *second-person (number case)
       (cond ((eq number 'singular)
	      (case-rules (nominative '|#TH#U'|);YOU
			  (accusative '#TH#IK);TO YOU
			  (genitive '|#TH#E'R|);YOUR
			  (dative '|#TH#E'R|)));BY YOU
	     ((eq number 'dual)
	      (case-rules (nominative 'it);you two
			  (accusative 'ykkr);you two
			  (genitive 'ykkar);the two of you's
			  (dative 'ykkr)));by the two of you
	     ((eq number 'plural)
	      (case-rules (nominative '|E'R|);you all
			  (accusative '|Y#VOICED-TH#R|);YOU ALL
			  (genitive '|Y#VOICED-TH#AR|);YOU all's
			  (dative '|Y#VOICED-TH#R|)))));by you all

