(defun *third-person (number case gender)
       (cond ((eq gender 'masculine)
	      (cond ((eq number 'singular)
		     (case-rules (nominative 'hann);he
				 (accusative 'hann);him
				 (genitive 'hans);his
				 (dative 'honum)));to him
		    ((eq number 'plural)
		     (case-rules (nominative '|#TH#EIR|);THEY
				 (accusative '|#TH#A'|);THEM
				 (genitive '|#TH#EIR(R)A|);THEIR
				 (dative '|#TH#EIM|)))));to them
	     ((eq gender 'feminine)
	      (cond ((eq number 'singular)
		     (case-rules (nominative 'hon);she
				 (accusative 'hana);her
				 (genitive 'hennar);her
				 (dative 'henni)));to her
		    ((eq number 'plural)
		     (case-rules (nominative '|#TH##AE#R|);they
				 (accusative '|#TH##AE#R|);them
				 (genitive '|#TH#EIR(R)A|);their
				 (dative '|#TH#EIM|)))));to them
	    ((eq gender 'neuter)
	     (cond ((eq number 'singular)
		    (case-rules (nominative '|#TH#AT|);IT
				(accusative '|#TH#AT|);it
				(genitive '|#TH#EIR(R)A|);its
				(dative '|#TH#EIM|)));by it
		   ((eq number 'plural)
		    (case-rules (nominative '|#TH#AU|);they
				(accusative '|#TH#AU|);them
				(genitive '|#TH#EIR(R)A|);their
				(dative '|#TH#EIM|)))))))

(defun test (subject)
       (cond ((eq subject 'noun)
	      ((lambda (noun number case)
	       (print (list noun number case '?))
	       (read)
	       (print-as-word (strong-declensions noun number case)))
	       (pick-one *nouns*)
	       (pick-one '(singular plural))
	       (pick-one *cases*)))
	     ((eq subject 'pronoun)
	      ((lambda (person)
		       (cond ((eq person '*third-person)
			      ((lambda (number case gender)
				       (print (list person number case gender '?))
				       (read)
				       (*third-person number case gender))
			       (pick-one '(singular plural))
			       (pick-one *cases*)
			       (pick-one *genders*)))
			     (t ((lambda (number case)
					 (print (list person number case '?))
					 (read)
					 (funcall person number case))
				 (pick-one '(singular dual plural))
				 (pick-one *cases*)))))
	      (pick-one '(*first-person *second-person *third-person))))))

(defun tp nil
(print (test 'pronoun))
(tp))

(defun tn nil
(print (test 'noun))
(tn))


(setq *nouns* '(*barn *harmr))

(setq *cases* '(nominative accusative genitive dative))

(setq *genders* '(masculine feminine neuter))

(defun pick-one (list)
(nth list (1+ (random (length list)))))

(defun nth (list n)
 (do ((i list (cdr i))
     (count 1 (1+ count)))
     ((= count n) (car i))))

     