(defun sd fexpr (a)
(print-as-word (strong-declensions (car a) (cadr a) (caddr a))))

(defun print-as-word (list)
(terpri)  (mapc 'princ list) (ascii 0))



(defun strong-declensions (node number case)
;presently this only for a-stems
;node is the atom which info on word is hung
;number is singular or plural
;case is nominative, accusative, genitive, or dative
;accusative is typically a direct object or expresses the extent of time or space
;genitive is usually for possesive but is also for specification of amount or indentity
;dative usually the instrument or sometimes the indirect object
((lambda (root gender)
(mutate
  (cond ((eq gender 'masculine)
	 (cond ((eq number 'singular)
		(case-rules (nominative (append root '(r)))
			    (accusative root)
			    (genitive (append root '(s)))
			    (dative (append root '(i)))))
	       ((eq number 'plural)
		(case-rules (nominative (append root '(a r)))
			    (accusative (append root '(a)))
			    (genitive (append root '(a)))
			    (dative (mutate (append root '(n u m))))))
	       (t (complain (list number 'not 'number)))))
       ((eq gender 'neuter)
	(cond ((eq number 'singular)
	       (case-rules (nominative root)
			   (accusative root)
			   (genitive (append root '(s)))
			   (dative (append root '(i)))))
	      ((eq number 'plural)
	       (case-rules (nominative (subst '#q# 'a root))
			   (accusative (subst '#q# 'a root))
			   (genitive (append root '(a)))
			   (dative (append root '(u m)))))))
      ((eq gender 'feminine) '(|havent done yet|)))))
 (or (get node 'root)
     (complain (list node 'has 'no 'root)))
 (or (get node 'gender)
     (complain (list node 'has 'no 'gender)))))
			    

(defun case-rules fexpr (a)
       (eval (cons 'cond
		    (append
		     (mapcar
		      (function (lambda (rule)
				       (cons (list 'eq 'case (list 'quote (car rule)))
					     (cdr rule))))
			a)
			'((t (complain (list case 'not 'a 'case))))))))

(defun complain (complaint)
       (print complaint)
       (break complain complain-sw))

(setq complain-sw t)


;From page 273 sec 40 u-mutation only

(defun mutate (letters)
(or (u-mutate letters)
      letters))
       
(defun u-mutate (letters)
       (cond ((memq 'u (memq 'a letters))
	      (subst '#q# 'a letters))
	     ((memq 'u (memq '|#A'#| letters))
	      (subst '|#q'#| '|#A'#| letters))
	     ((memq 'u (memq 'e letters))
	      (subst '#0# 'e letters))))

