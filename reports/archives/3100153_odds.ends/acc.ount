(defun pt (list)
(mapc 'process-transaction list)
(ascii 0))

(defun process-transaction (trans)
(cond ((eq trans 'po) (terpri) (po))
      (t (terpri)(nice-print trans)(terpri)
       (apply (function (lambda (act number symbol thing kind price c&t date comments)
	      (cond ((memq act '(bought sold))
		     ((lambda (position)
			      (cond ((assoc position *positions*)
				     (print-result (cdr (assoc position *positions*))
						   trans))
				    (t (setq *positions* (cons (cons position trans)
							      *positions*)))))
		      (list number symbol thing kind))
		     (cond ((eq act 'bought)
			    (setq *cash* (-$ *cash* (times number price) c&t)))
			   (t (setq *cash* (-$ (+$ *cash* (times number price))
					       c&t))))
		     (setq *c&t* (+$ c&t *c&t*)))
		    ((eq act 'transfer)
		     (setq *cash* (+$ *cash* number))
		     (setq *total-invested* (+$ *total-invested* number)))
		    ((eq act 'dividend)
		     (setq *dividends* (plus *dividends* number))
		     (setq *cash* (+$ *cash* number))
		     (setq *profit* (+$ *profit* number))
		     (setq *net-profit* (+$ *net-profit* number))
		     (setq *total-invested* (-$ *total-invested* number)))
		    ((eq act 'interest) ;;paid out
		     (setq *interest* (plus *interest* number))
		     (setq *profit* (-$ *profit* number))
		     (setq *net-profit* (-$ *net-profit* number))
		     (setq *cash* (-$ *cash* number)))
		    (t (nice-print (list act 'is 'not 'an 'action))))))
	      trans))))


(defun print-result (old-trans new-trans)
       (apply (function (lambda
			 (act1 number1 symbol1 thing1 kind1 price1 c&t1 date1 comments1
			  act2 number2 symbol2 thing2 kind2 price2 c&t2 date2 comments2)
	      (cond ((eq act1 act2)	
		     (setq *positions* (cons (cons position trans)  *positions*)))
		    (t (nice-print
	       (list 'on date1 'i act1 number1 thing1 'of symbol1 kind1 'at price1))
	      (and comments1 (nice-print comments1))
	      (nice-print
	       (list 'and 'then 'on date2 'i act2 'them 'for price2))
	      (and comments2 (nice-print comments2))
	      (setq profit
		    (times number (cond ((eq act1 'sold)
					 (-$ price1 price2))
					(t (-$ price2 price1)))))
	      (setq net-profit (-$ profit c&t1 c&t2))
	      (nice-print (list 'so 'i (cond ((minusp net-profit) 'lost)
					       (t 'made))
				 net-profit 'or profit 'before 'commisions))
	      (setq *profit* (+$ profit *profit*))
	      (setq *net-profit* (+$ net-profit *net-profit*))
	      (setq *positions* (remove-position position *positions*))))))	      
	      (append old-trans new-trans)))
			 

(defun nice-print (list)
(terpri)
(mapc '(lambda (element)
	(and element (princ element) (princ '/ )))
       list))

(defun remove-position (position positions)
       (do ((i positions (cdr i))
	    (so-far nil))
	   ((null i) so-far)
	   (cond ((equal position (caar i))
		  (return (append (reverse so-far) (cdr i))))
		 (t (setq so-far (cons (car i) so-far))))))

(defun init nil
       (setq *positions* nil
	     *profit* 0.0
	     *net-profit* 0.0
	     *cash* 0.0
	     *total-invested* 0.0
	     *c&t* 0.0
	     *interest* 0.0
	     *dividends* 0.0))

(defun po nil
(mapc (function (lambda (variable)
			(nice-print (list variable '= (symeval variable)))))
            '(*profit* 
	     *net-profit* 
	     *cash* 
	     *total-invested* 
	     *c&t* 
	     *interest* 
	     *dividends* ))
(grindef *positions*))
	     

(defun sort-trans (trans)
(sort trans (function (lambda (tran1 tran2)
			      ((lambda (date1 date2)
			  (not (cond ((> (caddr date1) (caddr date2)))
				    ((< (caddr date1) (caddr date2)) nil)
				    ((cond
				      ((> (car date1) (car date2)))
				      ((< (car date1) (car date2)) nil )
				      ((cond ((> (cadr date1) (cadr date2)))
					     ((< (cadr date1) (cadr date2)) nil ))))))))
			       (cadddr (cddddr tran1))
			       (cadddr (cddddr tran2)))))))
			       

