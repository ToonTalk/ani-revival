15 make 'active []
20 if emptyp :stop make 'stop 1000000 else make 'stop first :stop
30 make 'time 0
40 if :time = :stop stop
50 if memberp :time :starts activate reverse thing word 't :time erasename word 't :time
60 if memberp :time :ends deactivate :time
70 run.active
80 if not emptyp :moviename addto :moviename [wait :speed]
90 make 'time :time + 1
100 go 40
end


