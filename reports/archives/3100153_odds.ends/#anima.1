;this defines a scheduler as a actor that receives various messages such as
;do .. in .. frames  or do ... after .. n frames ...

to make.scheduler
10 make.obj 'scheduler
20 remember [kind.of actor] 'scheduler
30 scheduler [if receive do $code in ?n [or frame frames] then schedule :$code :time + :?n make 'last.time :time + :?n]
40 scheduler [if receive do $code at ?start then schedule :$code :?start make 'last.time :?start]
50 scheduler [if receive go $stop then run.schedule :$stop ']
60 scheduler [if receive make.movie ?name ?length then make.movie :?name :?length]
70 scheduler [if receive [or dont don't] $code at ?time then deschedule :$code:?time]
80 scheduler [if receive do $code after ?n $more [or frames frame] then schedule :$code :last.time + :?n make 'last.time :last.time + :?n]
90 scheduler [if receive do $code at that time then schedule :$code :last.time]
end



;this runs the schedule until stop frames or nothing left that is scheduled
to run.schedule :stop :moviename
