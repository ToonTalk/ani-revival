;this is for forget but probably should be flushed
to forget :item :obj
10 remove word '? :obj first :item
20 remove word first :item :obj last :item
end

;this is the function that munges procedures so that they can receive more
;types of commands
;note text must go  replace it with a property of the actor called "st.num or such

to receive :pattern :action :procedure
10 run ( list 'ed :procedure )
20 local 'st.nums local 'st.num local 'line local 'fword local 'fwords
25 make 'fwords []
30 make 'st.nums last ( first butfirst butfirst text :procedure )
33 make 'fword fword :pattern
38 if first :fword = '$ make 'st.num 9000 go 70
39 if first :fword = 'or make 'fwords butfirst :fword make 'fword first :fwords make 'fwords butfirst :fwords
40 make 'st.num assoc :fword :st.nums
45 if emptyp :st.nums make 'st.num 100 go 205
50 if emptyp :st.num make 'st.num ( last last :st.nums ) + 100 go 200
60 make 'st.num first :st.num
70 make 'line assoc :st.num text :procedure
80 if emptyp :line go 250
90 if first butfirst butfirst butfirst :line = :pattern go 250
100 make 'st.num :st.num + 5
110 go 70
200 run ( list ( :st.num - 1 ) 'go 9000 )
205 make 'st.nums lput ( list :fword :st.num ) :st.nums
207 if emptyp :fwords go 220
210 if emptyp :fwords go 220 else make 'fword first :fwords make 'fwords butfirst :fwords go 205
220 run ( sentence 20 [make 'st.num assoc fword :message] ( list :st.nums ) )
250 run ( sentence :st.num [if match :message] ( list :pattern ) :action 'stop )
260 run [end]
end

;this creates new actors that receive the basic messages

to define.actor
10 make.actor 'actor
20 receive [handle ?obj [$ receive $pattern then $action]] [receive :$pattern :$action :?obj] 'actor
25 receive [$ receive $pattern then $action] [receive :$pattern :$action 'actor] 'actor
30 actor [if receive handle ?obj [remember $thing] then remember :$thing :?obj]
40 actor [if receive handle ?obj [tell me $thing] then op up.find :$thing :?obj]
50 actor [if receive handle ?obj [forget $thing] then forget :$thing :?obj]
60 actor [if receive handle ?obj [replace $thing] then replace :$thing :?obj]
70 actor [if receive handle ?obj [$pattern no longer $action] then remove.receive :$pattern :$action :?obj]
80 actor [if receive handle ?obj [do $message] then scheduler (se 'do (list :?obj :$message ))]
90 actor [if receive handle ?obj [make ?name] then run (list word 'make. :?obj word '' :?name )]
end

;this defines turtle like objects as actors that can take turtle messages plus
;grow reappear, reappear as .., size, speed, etc.

to define.obj
10 make.actor 'obj
20 remember [kind.of actor] 'obj
30 obj [if receive handle ?actor [[or fd forward] ?amt] then move.obj :?actor 'fd :?amt]
35 obj [if receive handle ?actor [[or bk back] ?amt] then move.obj :?actor 'bk :?amt]
40 obj [if receive handle ?actor [[or rt right] ?angle] then turn.obj :?actor 'rt :?angle]
45 obj [if receive handle ?actor [[or lt left] ?angle] then turn.obj :?actor 'lt :?angle]
50 obj [if receive handle ?actor [hide] then hide.obj :?actor]
60 obj [if receive handle ?actor [show] then show.obj :?actor]
70 obj [if receive handle ?actor [[or pd pendown]] then replace [pen.state down] :?actor]
80 obj [if receive handle ?actor [[or pu penup]] then replace [pen.state up] :?actor]
90 obj [if receive handle ?actor [draw] then run how.to.draw? :?actor]
100 obj [if receive handle ?actor [reappear] then appear :?actor :?actor 'true]
110 obj [if receive handle ?actor [reappear as $ ?other] then appear :?other :?actor 'true]
120 obj [remember size 50]
130 obj [remember obj.state [0 0 0]]
140 obj [remember speed 30]
150 obj [remember sym.angle 360]
160 obj [remember grain 30]
165 obj [if receive handle ?actor [appear] then appear :?actor :?actor 'false]
170 obj [if receive handle ?actor [look like $ ?other] then appear :?other :?actor 'false]
180 obj [if receive handle ?actor [grow ?n] then grow :?n :?actor]
190 obj [if receive handle ?actor [appear rotated ?angle $] then rotate :?actor :?angle]
200 obj [if receive handle ?actor [single frame $command] then make 'single.frame 'true (if op? :$command op tell :?actor :$command else tell :?actor :$command ) make 'single.frame 'false]
210 obj [if receive handle ?actor [size?] then op f up.find [size ?] :?actor]
220 obj [if receive handle ?actor [state?] then op f up.find [obj.state ?] :?actor]
230 obj [if receive handle ?actor [speed?] then op f up.find [speed ?] :?actor]
240 obj [if receive handle ?actor [rotation.speed?] then op f up.find [rotation.speed ?] :?actor]
250 obj [remember rotation.speed 30]
end

