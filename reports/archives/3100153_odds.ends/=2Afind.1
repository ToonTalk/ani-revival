(DECLARE (SPECIAL PRED))

(DEFUN FIND-ALL (PRED)  (FIND-ALL1 (MAKOBLIST NIL))) 

(DEFUN FIND-ALL1 (L) 
       (DO ((I L (CDR I)) (ANS ))
	   ((NULL I) ANS)
	   (COND ((ATOM (CAR I))
		  (AND (FUNCALL PRED 
			 (CAR I)) (SETQ ANS (CONS (CAR I) ANS))))
		 (T (SETQ ANS (APPEND ANS (FIND-ALL1 (CAR I)))))))) 

(DEFUN EXPR-CODE (THING) 
       (OR (GET THING 'EXPR)
	 (GET THING 'MACRO)
	   (GET THING 'FEXPR)
	   (GET THING 'LEXPR))) 
