

(DECLARE (*FEXPR COUNTER)) 

(DEFUN COUNTER FEXPR (FILENAME) 
       (APPLY (FUNCTION UREAD) FILENAME)
       (SETQ EOF '(NIL))
       (IOC Q)
       (DO ((NCHAR (TYI EOF) (TYI EOF))
	    (NOW 0.)
	    (DELIMITERS '(32. 46. 44. 10. 13. 63. 33. 12.))
	    (IN-A-WORD NIL))
	   ((EQ EOF NCHAR)
	    (LIST NOW 'WORDS 'IN 'FILE FILENAME))
	   (COND ((AND IN-A-WORD (MEMQ NCHAR DELIMITERS))
		  (SETQ NOW (1+ NOW))
		  (SETQ IN-A-WORD NIL))
		 ((MEMQ NCHAR DELIMITERS))
		 (T (SETQ IN-A-WORD T))))) 
