(princ '|0 KSTID DSK:ken;smallt kst|) (terpri)
(princ '|1 HEIGHT|) (terpri)
(princ '|1 BASE LINE|) (terpri)
(princ '|0 COLUMN POSITION ADJUSTMENT|)(terpri)
