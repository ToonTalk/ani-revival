(DECLARE (SPECIAL M O N C H I L D R E)
	(*FEXPR INIT))

(DEFUN INIT FEXPR (WORD) 
       (DO ((LETTERS (EXPLODE WORD) (CDR LETTERS)))
	   ((NULL LETTERS) 'DONE)
	   (COND ((SETQ NOL (GET (CAR LETTERS) 'NUMBER))
		  (PUTPROP (CAR LETTERS) (ADD1 NOL) 'NUMBER))
		 (T (PUTPROP (CAR LETTERS) 1. 'NUMBER))))) 

(DEFUN SELECTOR NIL 
       (UREAD BIG DICT)
       (IOC Q)
       (PROG NIL 
 L	     (ZERO-OUT)
	     (COND ((OKAY (SETQ TEMP
				(OR (READ)
				    (RETURN (PRINT 'FINISHED)))))
		    (PRINT TEMP)))
	     (GO L))) 

(DEFUN OKAY (WORD) 
       (DO ((LETTERS (EXPLODE WORD) (CDR LETTERS)))
	    ((NULL LETTERS) 'FINE)
	    (COND ((SETQ NOL (GET (CAR LETTERS) 'NUMBER))
		   (COND ((> (SET (CAR LETTERS)
				  (ADD1 (EVAL (CAR LETTERS))))
				  NOL)
			     (RETURN NIL))))
		  (T (RETURN NIL))))) 

(DEFUN ZERO-OUT NIL
(MAPC (FUNCTION (LAMBDA (LET) (SET LET 0.)))(EXPLODE 'MOONCHILDREN)))