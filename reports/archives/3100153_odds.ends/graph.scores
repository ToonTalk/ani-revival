(cs)
(tvsize 550 300)
(turtlesize 300)
(ht)
(defun z (x y z w delx)
       (cs)(pu)(delxy delx -125) (pd)
       (plot scores x y z w))

(defun plot (numbers range height width *how-often*)
(setq label-how-often  *how-often*)
       (do ((i (sort (append numbers nil) '<) (cdr I))
	    (end range)
	    (total (apply '+ numbers))
	    (bucket 0))
	   ((null i) (plot-bucket (* bucket height)
				  width (- end range))
	    (//$ (float total) (float (length numbers))))
	   (cond ((> (car i) end)
		  (plot-bucket (* bucket height) width (- end range))
		  (setq bucket 0)
		  (setq end (+ end range))
		  (setq i (cons 'dummy i)))
		 (t (setq bucket (1+ bucket))))))

(defun plot-bucket (height width end)
       (cond ((> height 0)
	      (rectangle height width)))
       (cond ((= label-how-often 0)
	      (bk 12)
	      (mark end)
	      (fd 12)
	      (setq label-how-often *how-often*)))
       (setq label-how-often (1- label-how-often))
       (pd)
       (delx width))

       
(setq pat 'horizlines)

(defun rectangle (h w)
       (fd h)(rt 90) (fd w)(rt 90) (fd h) (rt 90) (fd w) (rt 90)
       (pu)
       (rt 45)
       (fd w)
       (shade pat)
       (bk w)
       (lt 45)
       (pd))
       
       