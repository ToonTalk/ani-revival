;;this is all that Director need know to display the scene NO-LONGER-KEPT-APART
(DEFINE NO-LONGER-KEPT-APART DIRECTOR-SCENE (SET YOUR SUBSCENES TO ((SUBSCENE-OF NO-LONGER-KEPT-APART 1)))) 

(DEFINE (SUBSCENE-OF NO-LONGER-KEPT-APART 1) DIRECTOR-SUBSCENE (SET YOUR SCENE TO NO-LONGER-KEPT-APART) (SET YOUR CONVEY-TASKS TO (CONVEY-TASK-3)) (SET YOUR (LOCATION-OF PRINCE) TO (PLACE: WHERE (XY-POSITION 0.26167551 -0.38230241) WHY (ENDED UP HERE IN KEPT-APART) STATUS COOL)) (SET YOUR (LOCATION-OF FAIRY-GODMOTHER) TO (PLACE: WHERE (XY-POSITION 0.0 0.0) WHY (ENDED UP HERE IN KEPT-APART) STATUS COOL)) (SET YOUR (LOCATION-OF STEP-MOTHER) TO (PLACE: WHERE (XY-POSITION 0.11906155 -0.18438756) WHY (ENDED UP HERE IN KEPT-APART) STATUS COOL)) (SET YOUR (LOCATION-OF CINDERELLA) TO (PLACE: WHERE (XY-POSITION 0.017514613 -0.023774467) WHY (ENDED UP HERE IN KEPT-APART) STATUS COOL)) (SET YOUR STRETCHED-BY TO 2.5) (SET YOUR MOVEMENTS TO ((AND (ACTIVITY-OF CHASEE-RUNS-AWAY 1) (ACTIVITY-OF CHASER-PURSUES 1)))) (SET YOUR SPECIAL-DYNAMICS TO (|(SPECIAL-DYNAMICS-OF STEP-MOTHER IN (SUBSCENE-OF NO-LONGER-KEPT-APART 1))-13| |(SPECIAL-DYNAMICS-OF FAIRY-GODMOTHER IN (SUBSCENE-OF NO-LONGER-KEPT-APART 1))-14|)) (SET YOUR PLANS TO ((ACTIVITY-OF CHASEE-RUNS-AWAY 1) (ACTIVITY-OF CHASER-PURSUES 1))) (SET YOUR RUNNING-TIME TO 3.025)) 
(DEFINE (ACTIVITY-OF CHASEE-RUNS-AWAY 1) PLAN (SET YOUR BEGIN-TIME TO 0.0) (SET YOUR SUBSCENE TO (SUBSCENE-OF NO-LONGER-KEPT-APART 1)) (SET YOUR PLANS TO ((SEQUENCE: (ASK STEP-MOTHER SET YOUR SPECIAL-DYNAMICS TO |(SPECIAL-DYNAMICS-OF STEP-MOTHER IN (SUBSCENE-OF NO-LONGER-KEPT-APART 1))-13|) (ASK STEP-MOTHER INITIALIZE YOUR CURVATURE-SIGN TOWARDS (GOOD-DISTANCE-FROM-AND-OFFSTAGE (AWAY-FROM (VICINITY-OF CINDERELLA) (VICINITY-OF PRINCE)))) (ASK (ACTIVITY-OF CHASEE-RUNS-AWAY 1) CAUSE (STEP-MOTHER) TO GRADUALLY GO IN ARC CAREFUL OF COLLISIONS TO (GOOD-DISTANCE-FROM-AND-OFFSTAGE (AWAY-FROM (VICINITY-OF CINDERELLA) (VICINITY-OF PRINCE))) AS MOVING-TARGET STOPPING IF (MOVE-ONLY-ORIGINAL-DISTANCE (QUOTE (SUBSCENE-OF NO-LONGER-KEPT-APART 1)))))))) 
(DEFINE (ACTIVITY-OF CHASER-PURSUES 1) PLAN (SET YOUR BEGIN-TIME TO (AFTER (BEGINNING-OF (ACTIVITY-OF CHASEE-RUNS-AWAY 1)) 0.5)) (SET YOUR SUBSCENE TO (SUBSCENE-OF NO-LONGER-KEPT-APART 1)) (SET YOUR PLANS TO ((SEQUENCE: (ASK FAIRY-GODMOTHER SET YOUR SPECIAL-DYNAMICS TO |(SPECIAL-DYNAMICS-OF FAIRY-GODMOTHER IN (SUBSCENE-OF NO-LONGER-KEPT-APART 1))-14|) (ASK FAIRY-GODMOTHER INITIALIZE YOUR CURVATURE-SIGN TOWARDS (SMALL-WAY-FROM-PLUS-SIZE (VICINITY-OF STEP-MOTHER) (VICINITY-OF FAIRY-GODMOTHER) STEP-MOTHER)) (ASK (ACTIVITY-OF CHASER-PURSUES 1) CAUSE (FAIRY-GODMOTHER) TO GRADUALLY GO IN ARC REGARDLESS OF COLLISIONS TO (SMALL-WAY-FROM-PLUS-SIZE (VICINITY-OF STEP-MOTHER) (VICINITY-OF FAIRY-GODMOTHER) STEP-MOTHER) AS MOVING-TARGET STOPPING IF (STOP-WHEN-THERE-THEN (QUOTE (SUBSCENE-OF NO-LONGER-KEPT-APART 1)) (STOP-PLAN (QUOTE (ACTIVITY-OF CHASEE-RUNS-AWAY 1))))))))) 
(DEFINE (SPECIAL-DYNAMICS-OF FAIRY-GODMOTHER IN (SUBSCENE-OF NO-LONGER-KEPT-APART 1)) SPECIAL-DYNAMICS (SET YOUR OFFSPRING TO (|(SPECIAL-DYNAMICS-OF FAIRY-GODMOTHER IN (SUBSCENE-OF NO-LONGER-KEPT-APART 1))-14| |(SPECIAL-DYNAMICS-OF FAIRY-GODMOTHER IN (SUBSCENE-OF NO-LONGER-KEPT-APART 1))-12| |(SPECIAL-DYNAMICS-OF FAIRY-GODMOTHER IN (SUBSCENE-OF NO-LONGER-KEPT-APART 1))-10| |(SPECIAL-DYNAMICS-OF FAIRY-GODMOTHER IN (SUBSCENE-OF NO-LONGER-KEPT-APART 1))-8| |(SPECIAL-DYNAMICS-OF FAIRY-GODMOTHER IN (SUBSCENE-OF NO-LONGER-KEPT-APART 1))-6| |(SPECIAL-DYNAMICS-OF FAIRY-GODMOTHER IN (SUBSCENE-OF NO-LONGER-KEPT-APART 1))-5| |(SPECIAL-DYNAMICS-OF FAIRY-GODMOTHER IN (SUBSCENE-OF NO-LONGER-KEPT-APART 1))-4| |(SPECIAL-DYNAMICS-OF FAIRY-GODMOTHER IN (SUBSCENE-OF NO-LONGER-KEPT-APART 1))-2| |(SPECIAL-DYNAMICS-OF FAIRY-GODMOTHER IN (SUBSCENE-OF NO-LONGER-KEPT-APART 1))-1|)) (SET YOUR PATH-JAGGEDNESS TO HIGH) (SET YOUR PATH-CURVATURE TO LOW) (SET YOUR PATH-LENGTH TO SHORT) (SET YOUR DELIBERATENESS TO LOW) (SET YOUR REPETIVENESS TO LOW) (SET YOUR ACCELERATION TO MEDIUM) (SET YOUR RHYTHMIC-LEVEL TO LOW) (SET YOUR ACTIVITY-LEVEL TO LOW) (SET YOUR SPEED TO HIGH) (SET YOUR (PATH-CURVATURE FACTOR) TO 0.5)) 
