;;this is all that Director need know to display the scene NO-LONGER-KEPT-APART
(DEFINE NO-LONGER-KEPT-APART DIRECTOR-SCENE (SET YOUR SUBSCENES TO ((SUBSCENE-OF NO-LONGER-KEPT-APART 1)))) 

(DEFINE (SUBSCENE-OF NO-LONGER-KEPT-APART 1) DIRECTOR-SUBSCENE (SET YOUR SCENE TO NO-LONGER-KEPT-APART) (SET YOUR CONVEY-TASKS TO (CONVEY-TASK-3)) (SET YOUR (LOCATION-OF PRINCE) TO (PLACE: WHERE (XY-POSITION 0.26167551 -0.38230241) WHY (ENDED UP HERE IN KEPT-APART) STATUS COOL)) (SET YOUR (LOCATION-OF FAIRY-GODMOTHER) TO (PLACE: WHERE (XY-POSITION 0.0 0.0) WHY (ENDED UP HERE IN KEPT-APART) STATUS COOL)) (SET YOUR (LOCATION-OF STEP-MOTHER) TO (PLACE: WHERE (XY-POSITION 0.11906155 -0.18438756) WHY (ENDED UP HERE IN KEPT-APART) STATUS COOL)) (SET YOUR (LOCATION-OF CINDERELLA) TO (PLACE: WHERE (XY-POSITION 0.017514613 -0.023774467) WHY (ENDED UP HERE IN KEPT-APART) STATUS COOL)) (SET YOUR STRETCHED-BY TO 0.0) (SET YOUR RUNNING-TIME TO 0.0)) 
(DEFINE (SPECIAL-DYNAMICS-OF FAIRY-GODMOTHER IN (SUBSCENE-OF NO-LONGER-KEPT-APART 1)) SPECIAL-DYNAMICS (SET YOUR OFFSPRING TO (|(SPECIAL-DYNAMICS-OF FAIRY-GODMOTHER IN (SUBSCENE-OF NO-LONGER-KEPT-APART 1))-2| |(SPECIAL-DYNAMICS-OF FAIRY-GODMOTHER IN (SUBSCENE-OF NO-LONGER-KEPT-APART 1))-1|)) (SET YOUR PATH-JAGGEDNESS TO HIGH) (SET YOUR PATH-CURVATURE TO LOW) (SET YOUR PATH-LENGTH TO SHORT) (SET YOUR DELIBERATENESS TO LOW) (SET YOUR REPETIVENESS TO LOW) (SET YOUR ACCELERATION TO MEDIUM) (SET YOUR RHYTHMIC-LEVEL TO LOW) (SET YOUR ACTIVITY-LEVEL TO LOW) (SET YOUR SPEED TO HIGH) (SET YOUR (PATH-CURVATURE FACTOR) TO 0.5)) 
(DEFINE |(SPECIAL-DYNAMICS-OF FAIRY-GODMOTHER IN (SUBSCENE-OF NO-LONGER-KEPT-APART 1))-1| (SPECIAL-DYNAMICS-OF FAIRY-GODMOTHER IN (SUBSCENE-OF NO-LONGER-KEPT-APART 1)) (SET YOUR (SPEED FACTOR) TO 1.6)) 
(DEFINE |(SPECIAL-DYNAMICS-OF FAIRY-GODMOTHER IN (SUBSCENE-OF NO-LONGER-KEPT-APART 1))-2| (SPECIAL-DYNAMICS-OF FAIRY-GODMOTHER IN (SUBSCENE-OF NO-LONGER-KEPT-APART 1)) (SET YOUR (SPEED FACTOR) TO 1.4)) 