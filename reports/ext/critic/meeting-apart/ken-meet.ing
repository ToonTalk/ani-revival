(DEFINE (ACTIVITY-OF TURN-CHARACTER 1) PLAN (SET YOUR BEGIN-TIME TO 0.0) (SET YOUR SUBSCENE TO (SUBSCENE-OF MEETING 2)) (SET YOUR PLANS TO ((SEQUENCE: (ASK CINDERELLA SET YOUR SPECIAL-DYNAMICS TO |(SPECIAL-DYNAMICS-OF CINDERELLA IN (SUBSCENE-OF MEETING 2))-3|) (ASK (ACTIVITY-OF TURN-CHARACTER 1) CAUSE CINDERELLA TO GRADUALLY TURN 60.0 DEGREES STOPPING IF (STOP-WHEN-TURNED (QUOTE (SUBSCENE-OF MEETING 2)))))))) 
