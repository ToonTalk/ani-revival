;;this is all that Director need know to display the scene MEETING
(DEFINE MEETING DIRECTOR-SCENE (SET YOUR SUBSCENES TO ((SUBSCENE-OF MEETING 1) (SUBSCENE-OF MEETING 2) (SUBSCENE-OF MEETING 3) (SUBSCENE-OF MEETING 4) (SUBSCENE-OF MEETING 5)))) 

(DEFINE (SUBSCENE-OF MEETING 1) DIRECTOR-SUBSCENE (SET YOUR SCENE TO MEETING) (SET YOUR CONVEY-TASKS TO (CONVEY-TASK-4)) (SET YOUR (LOCATION-OF PRINCE) TO (PLACE: WHERE (XY-POSITION 0.26167551 -0.38230241) WHY (ENDED UP HERE IN NO-LONGER-KEPT-APART) STATUS COOL)) (SET YOUR (LOCATION-OF FAIRY-GODMOTHER) TO (PLACE: WHERE (XY-POSITION 0.26454807 -0.38163569) WHY (ENDED UP HERE IN NO-LONGER-KEPT-APART) STATUS COOL)) (SET YOUR (LOCATION-OF STEP-MOTHER) TO (PLACE: WHERE (XY-POSITION 0.11906155 -0.18438756) WHY (ENDED UP HERE IN NO-LONGER-KEPT-APART) STATUS COOL)) (SET YOUR (LOCATION-OF CINDERELLA) TO (PLACE: WHERE (XY-POSITION 0.26501096 -0.38105156) WHY (ENDED UP HERE IN NO-LONGER-KEPT-APART) STATUS COOL)) (SET YOUR STRETCHED-BY TO 1.0) (SET YOUR MOVEMENTS TO ((AND (ACTIVITY-OF EXIT-BY-CHARACTER 2) (ACTIVITY-OF EXIT-BY-CHARACTER 1)))) (SET YOUR SPECIAL-DYNAMICS TO (|(SPECIAL-DYNAMICS-OF STEP-MOTHER IN (SUBSCENE-OF MEETING 1))-2| |(SPECIAL-DYNAMICS-OF FAIRY-GODMOTHER IN (SUBSCENE-OF MEETING 1))-1|)) (SET YOUR PLANS TO ((ACTIVITY-OF EXIT-BY-CHARACTER 2) (ACTIVITY-OF EXIT-BY-CHARACTER 1))) (SET YOUR RUNNING-TIME TO 1.65)) 
(DEFINE (ACTIVITY-OF EXIT-BY-CHARACTER 2) PLAN (SET YOUR BEGIN-TIME TO 0.0) (SET YOUR SUBSCENE TO (SUBSCENE-OF MEETING 1)) (SET YOUR PLANS TO ((SEQUENCE: (ASK STEP-MOTHER SET YOUR SPECIAL-DYNAMICS TO |(SPECIAL-DYNAMICS-OF STEP-MOTHER IN (SUBSCENE-OF MEETING 1))-2|) (ASK STEP-MOTHER INITIALIZE YOUR CURVATURE-SIGN TOWARDS (SMALL-DISTANCE-FROM-AND-OFFSTAGE (VICINITY-OF STEP-MOTHER))) (ASK (ACTIVITY-OF EXIT-BY-CHARACTER 2) CAUSE (STEP-MOTHER) TO GRADUALLY GO IN ARC REGARDLESS OF COLLISIONS TO (SMALL-DISTANCE-FROM-AND-OFFSTAGE (VICINITY-OF STEP-MOTHER)) AS STATIONARY-TARGET STOPPING IF (STOP-WHEN-THERE (QUOTE (SUBSCENE-OF MEETING 1)))))))) 
(DEFINE (ACTIVITY-OF EXIT-BY-CHARACTER 1) PLAN (SET YOUR BEGIN-TIME TO 0.0) (SET YOUR SUBSCENE TO (SUBSCENE-OF MEETING 1)) (SET YOUR PLANS TO ((SEQUENCE: (ASK FAIRY-GODMOTHER SET YOUR SPECIAL-DYNAMICS TO |(SPECIAL-DYNAMICS-OF FAIRY-GODMOTHER IN (SUBSCENE-OF MEETING 1))-1|) (ASK FAIRY-GODMOTHER INITIALIZE YOUR CURVATURE-SIGN TOWARDS (SMALL-DISTANCE-FROM-AND-OFFSTAGE (VICINITY-OF FAIRY-GODMOTHER))) (ASK (ACTIVITY-OF EXIT-BY-CHARACTER 1) CAUSE (FAIRY-GODMOTHER) TO GRADUALLY GO IN ARC REGARDLESS OF COLLISIONS TO (SMALL-DISTANCE-FROM-AND-OFFSTAGE (VICINITY-OF FAIRY-GODMOTHER)) AS STATIONARY-TARGET STOPPING IF (STOP-WHEN-THERE (QUOTE (SUBSCENE-OF MEETING 1)))))))) 
