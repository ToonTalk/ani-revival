;;this is all that Director need know to display the scene NO-LONGER-KEPT-APART
(DEFINE NO-LONGER-KEPT-APART DIRECTOR-SCENE (SET YOUR SUBSCENES TO ((SUBSCENE-OF NO-LONGER-KEPT-APART 1)))) 

(DEFINE (SUBSCENE-OF NO-LONGER-KEPT-APART 1) DIRECTOR-SUBSCENE (SET YOUR SCENE TO NO-LONGER-KEPT-APART) (SET YOUR CONVEY-TASKS TO (CONVEY-TASK-3)) (SET YOUR (LOCATION-OF PRINCE) TO (PLACE: WHERE (XY-POSITION 0.26167551 -0.38230241) WHY (ENDED UP HERE IN KEPT-APART) STATUS COOL)) (SET YOUR (LOCATION-OF FAIRY-GODMOTHER) TO (PLACE: WHERE (XY-POSITION 0.0 0.0) WHY (ENDED UP HERE IN KEPT-APART) STATUS COOL)) (SET YOUR (LOCATION-OF STEP-MOTHER) TO (PLACE: WHERE (XY-POSITION 0.10139604 -0.18581339) WHY (ENDED UP HERE IN KEPT-APART) STATUS COOL)) (SET YOUR (LOCATION-OF CINDERELLA) TO (PLACE: WHERE (XY-POSITION -0.0050912987 -0.028305873) WHY (ENDED UP HERE IN KEPT-APART) STATUS COOL)) (SET YOUR STRETCHED-BY TO 1.0) (SET YOUR MOVEMENTS TO ((ACTIVITY-OF MAKE-GUARDING-MORE-INTERESTING 1) (REPEAT 3 (AND (ACTIVITY-OF PRISONER-ESCAPES 1) (ACTIVITY-OF GUARD-CHASES 1) (ACTIVITY-OF PRISONER-ESCAPES-AGAIN-PLAN 1) (ACTIVITY-OF RESUME-GUARD 1)) THEN NOTE THAT (END-OF (ACTIVITY-OF MAKE-GUARDING-MORE-INTERESTING 1)) HAPPENED))) (SET YOUR SPECIAL-DYNAMICS TO (|(SPECIAL-DYNAMICS-OF CINDERELLA IN (SUBSCENE-OF NO-LONGER-KEPT-APART 1))-10| |(SPECIAL-DYNAMICS-OF STEP-MOTHER IN (SUBSCENE-OF NO-LONGER-KEPT-APART 1))-9-1| |(SPECIAL-DYNAMICS-OF STEP-MOTHER IN (SUBSCENE-OF NO-LONGER-KEPT-APART 1))-9-2| |(SPECIAL-DYNAMICS-OF FAIRY-GODMOTHER IN (SUBSCENE-OF NO-LONGER-KEPT-APART 1))-8-1| |(SPECIAL-DYNAMICS-OF FAIRY-GODMOTHER IN (SUBSCENE-OF NO-LONGER-KEPT-APART 1))-8-2|)) (SET YOUR PLANS TO ((ACTIVITY-OF MAKE-GUARDING-MORE-INTERESTING 1) (ACTIVITY-OF PRISONER-ESCAPES 1) (ACTIVITY-OF PRISONER-ESCAPES-AGAIN-PLAN 1) (ACTIVITY-OF GUARD-CHASES 1) (ACTIVITY-OF RESUME-GUARD 1))) (SET YOUR RUNNING-TIME TO 11.017857)) 
(DEFINE (ACTIVITY-OF MAKE-GUARDING-MORE-INTERESTING 1) PLAN (SET YOUR BEGIN-TIME TO 0.0) (SET YOUR SUBSCENE TO (SUBSCENE-OF NO-LONGER-KEPT-APART 1)) (SET YOUR PLANS TO ((SEQUENCE: (ASK CINDERELLA SET YOUR SPECIAL-DYNAMICS TO |(SPECIAL-DYNAMICS-OF CINDERELLA IN (SUBSCENE-OF NO-LONGER-KEPT-APART 1))-10|) (ASK CINDERELLA INITIALIZE YOUR CURVATURE-SIGN TOWARDS (FAR-FROM-BOTH (VICINITY-OF CINDERELLA) (VICINITY-OF STEP-MOTHER))) (ASK (ACTIVITY-OF MAKE-GUARDING-MORE-INTERESTING 1) CAUSE (CINDERELLA) TO GRADUALLY GO IN ARC CAREFUL OF COLLISIONS TO (FAR-FROM-BOTH (VICINITY-OF CINDERELLA) (VICINITY-OF STEP-MOTHER)) AS STATIONARY-TARGET STOPPING IF (MOVE-ONLY-ORIGINAL-DISTANCE (QUOTE (SUBSCENE-OF NO-LONGER-KEPT-APART 1)))))))) 
(DEFINE (ACTIVITY-OF PRISONER-ESCAPES 1) PLAN (SET YOUR BEGIN-TIME TO 0.0) (SET YOUR SUBSCENE TO (SUBSCENE-OF NO-LONGER-KEPT-APART 1)) (SET YOUR PLANS TO ((SEQUENCE: (ASK STEP-MOTHER SET YOUR SPECIAL-DYNAMICS TO |(SPECIAL-DYNAMICS-OF STEP-MOTHER IN (SUBSCENE-OF NO-LONGER-KEPT-APART 1))-9-1|) (ASK STEP-MOTHER INITIALIZE YOUR CURVATURE-SIGN TOWARDS (VICINITY-OF CINDERELLA)) (ASK (ACTIVITY-OF PRISONER-ESCAPES 1) CAUSE (STEP-MOTHER) TO GRADUALLY GO IN ARC CAREFUL OF COLLISIONS TO (VICINITY-OF CINDERELLA) AS MOVING-TARGET STOPPING IF (MOVE-ONLY-ORIGINAL-DISTANCE (QUOTE (SUBSCENE-OF NO-LONGER-KEPT-APART 1)))))))) 
(DEFINE (ACTIVITY-OF PRISONER-ESCAPES-AGAIN-PLAN 1) PLAN (SET YOUR BEGIN-TIME TO (AFTER (END-OF (ACTIVITY-OF GUARD-CHASES 1)) 0.5)) (SET YOUR SUBSCENE TO (SUBSCENE-OF NO-LONGER-KEPT-APART 1)) (SET YOUR PLANS TO ((SEQUENCE: (ASK STEP-MOTHER SET YOUR SPECIAL-DYNAMICS TO |(SPECIAL-DYNAMICS-OF STEP-MOTHER IN (SUBSCENE-OF NO-LONGER-KEPT-APART 1))-9-2|) (ASK STEP-MOTHER INITIALIZE YOUR CURVATURE-SIGN TOWARDS (CURRENT-GOAL-OF CINDERELLA)) (ASK (ACTIVITY-OF PRISONER-ESCAPES-AGAIN-PLAN 1) CAUSE (STEP-MOTHER) TO GRADUALLY GO IN ARC CAREFUL OF COLLISIONS TO (CURRENT-GOAL-OF CINDERELLA) AS MOVING-TARGET STOPPING IF (MOVE-ONLY-ORIGINAL-DISTANCE (QUOTE (SUBSCENE-OF NO-LONGER-KEPT-APART 1)))))))) 
(DEFINE (ACTIVITY-OF GUARD-CHASES 1) PLAN (SET YOUR BEGIN-TIME TO 0.75) (SET YOUR SUBSCENE TO (SUBSCENE-OF NO-LONGER-KEPT-APART 1)) (SET YOUR PLANS TO ((SEQUENCE: (ASK FAIRY-GODMOTHER SET YOUR SPECIAL-DYNAMICS TO |(SPECIAL-DYNAMICS-OF FAIRY-GODMOTHER IN (SUBSCENE-OF NO-LONGER-KEPT-APART 1))-8-1|) (ASK FAIRY-GODMOTHER INITIALIZE YOUR CURVATURE-SIGN TOWARDS (SMALL-WAY-FROM-PLUS-SIZE (VICINITY-OF STEP-MOTHER) (VICINITY-OF CINDERELLA) STEP-MOTHER)) (ASK (ACTIVITY-OF GUARD-CHASES 1) CAUSE (FAIRY-GODMOTHER) TO GRADUALLY GO IN ARC REGARDLESS OF COLLISIONS TO (SMALL-WAY-FROM-PLUS-SIZE (VICINITY-OF STEP-MOTHER) (VICINITY-OF CINDERELLA) STEP-MOTHER) AS MOVING-TARGET STOPPING IF (STOP-WHEN-THERE-THEN (QUOTE (SUBSCENE-OF NO-LONGER-KEPT-APART 1)) (STOP-PLAN (QUOTE (ACTIVITY-OF PRISONER-ESCAPES 1))))))))) 
(DEFINE (ACTIVITY-OF RESUME-GUARD 1) PLAN (SET YOUR BEGIN-TIME TO (AFTER (END-OF (ACTIVITY-OF GUARD-CHASES 1)) 1.25)) (SET YOUR SUBSCENE TO (SUBSCENE-OF NO-LONGER-KEPT-APART 1)) (SET YOUR PLANS TO ((SEQUENCE: (ASK FAIRY-GODMOTHER SET YOUR SPECIAL-DYNAMICS TO |(SPECIAL-DYNAMICS-OF FAIRY-GODMOTHER IN (SUBSCENE-OF NO-LONGER-KEPT-APART 1))-8-2|) (ASK FAIRY-GODMOTHER INITIALIZE YOUR CURVATURE-SIGN TOWARDS (SMALL-WAY-FROM-PLUS-SIZE (VICINITY-OF STEP-MOTHER) (CURRENT-GOAL-OF STEP-MOTHER) STEP-MOTHER)) (ASK (ACTIVITY-OF RESUME-GUARD 1) CAUSE (FAIRY-GODMOTHER) TO GRADUALLY GO IN ARC REGARDLESS OF COLLISIONS TO (SMALL-WAY-FROM-PLUS-SIZE (VICINITY-OF STEP-MOTHER) (CURRENT-GOAL-OF STEP-MOTHER) STEP-MOTHER) AS MOVING-TARGET STOPPING IF (STOP-WHEN-MOVED-ORIGINAL-DISTANCE-THEN (QUOTE (SUBSCENE-OF NO-LONGER-KEPT-APART 1)) (STOP-PLAN (QUOTE (ACTIVITY-OF PRISONER-ESCAPES-AGAIN-PLAN 1))))))))) 
