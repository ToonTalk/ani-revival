;;this is all that Director need know to display the scene THE-FINISH
(DEFINE THE-FINISH DIRECTOR-SCENE (SET YOUR SUBSCENES TO ((SUBSCENE-OF THE-FINISH 1)))) 

(DEFINE (SUBSCENE-OF THE-FINISH 1) DIRECTOR-SUBSCENE (SET YOUR SCENE TO THE-FINISH) (SET YOUR ESTABLISH-TASKS TO (ESTABLISH-TASK-6 ESTABLISH-TASK-5)) (SET YOUR (LOCATION-OF TORTOISE) TO (PLACE: WHERE (XY-POSITION 0.14005043 -0.17314974) WHY (ENDED UP HERE IN THE-RACE) STATUS COOL)) (SET YOUR (LOCATION-OF HARE) TO (PLACE: WHERE (XY-POSITION 0.13109515 -0.03468642) WHY (ENDED UP HERE IN THE-RACE) STATUS COOL)) (SET YOUR STRETCHED-BY TO 0.0) (SET YOUR INITIAL-ACTIONS TO ((ASK TORTOISE TO SET YOUR SPECIAL-DYNAMICS TO (SPECIAL-DYNAMICS-OF TORTOISE IN (SUBSCENE-OF THE-FINISH 1))) (RUN (ACTIVITY-OF WAITING-TO-WANDER 1) THEN SEE IF EVERYBODY IS DONE) (RUN (ACTIVITY-OF WANDERING-WHILE-CHANGES-RUN 1) THEN SEE IF EVERYBODY IS DONE))) (SET YOUR (CHANGES-FOR TORTOISE) TO ((GRADUALLY CHANGE LOOK BY 1.5 FACTOR FOR COLOR-INTENSITY AT HIGH SPEED) (GRADUALLY CHANGE BY 0.66666667 FACTOR FOR PATH-JAGGEDNESS AT HIGH SPEED) (GRADUALLY CHANGE BY 1.5 FACTOR FOR DELIBERATENESS AT HIGH SPEED) (GRADUALLY CHANGE BY 1.5 FACTOR FOR ACTIVITY-LEVEL AT HIGH SPEED) (GRADUALLY CHANGE BY 1.5 FACTOR FOR SPEED AT HIGH SPEED) (GRADUALLY CHANGE BY 1.5 FACTOR FOR RHYTHMIC-LEVEL AT HIGH SPEED) (GRADUALLY CHANGE BY 1.5 FACTOR FOR ACCELERATION AT HIGH SPEED) (GRADUALLY CHANGE BY 2.0 FACTOR FOR PATH-LENGTH AT HIGH SPEED) (GRADUALLY CHANGE BY 2.0 FACTOR FOR PATH-CURVATURE AT HIGH SPEED))) (SET YOUR SPECIAL-DYNAMICS TO (|(SPECIAL-DYNAMICS-OF TORTOISE IN (SUBSCENE-OF THE-FINISH 1))-1|)) (SET YOUR PLANS TO ((ACTIVITY-OF WANDERING-WHILE-CHANGES-RUN 1) (ACTIVITY-OF WAITING-TO-WANDER 1) (ACTIVITY-OF WANDER-AROUND 2))) (SET YOUR MOVEMENTS TO ((AND (ACTIVITY-OF WANDER-AROUND 2)))) (SET YOUR RUNNING-TIME TO 1.732868)) 
(DEFINE (ACTIVITY-OF WANDERING-WHILE-CHANGES-RUN 1) PLAN (SET YOUR BEGIN-TIME TO (AFTER (END-OF (ACTIVITY-OF WAITING-TO-WANDER 1)) 0.0)) (SET YOUR SUBSCENE TO (SUBSCENE-OF THE-FINISH 1)) (SET YOUR PLANS TO ((ASK (ACTIVITY-OF WANDERING-WHILE-CHANGES-RUN 1) WANDER TORTOISE WHILE CHANGES RUN IN (SUBSCENE-OF THE-FINISH 1))))) 
(DEFINE (ACTIVITY-OF WAITING-TO-WANDER 1) PLAN (SET YOUR BEGIN-TIME TO (AFTER (BEGINNING-OF (SUBSCENE-OF THE-FINISH 1)) 0.0)) (SET YOUR SUBSCENE TO (SUBSCENE-OF THE-FINISH 1)) (SET YOUR PLANS TO ((ASK (ACTIVITY-OF WAITING-TO-WANDER 1) WAIT UNTIL TORTOISE IS MOVED BY NOTHING IN ((SUBSCENE-OF THE-FINISH 1)) OR (SUBSCENE-OF THE-FINISH 1) CHANGES END)))) 
(DEFINE (ACTIVITY-OF WANDER-AROUND 2) PLAN (SET YOUR BEGIN-TIME TO 0.0) (SET YOUR SUBSCENE TO (SUBSCENE-OF THE-FINISH 1)) (SET YOUR PLANS TO ((SEQUENCE: (SEQUENCE: (ASK TORTOISE SET YOUR SPECIAL-DYNAMICS TO |(SPECIAL-DYNAMICS-OF TORTOISE IN (SUBSCENE-OF THE-FINISH 1))-1|) (ASK TORTOISE INITIALIZE YOUR CURVATURE-SIGN TOWARDS (GOOD-DISTANCE-FROM (VICINITY-OF TORTOISE))) (ASK (ACTIVITY-OF WANDER-AROUND 2) CAUSE (TORTOISE) TO GRADUALLY GO IN ARC CAREFUL OF COLLISIONS TO (GOOD-DISTANCE-FROM (VICINITY-OF TORTOISE)) AS STATIONARY-TARGET STOPPING IF (STOP-IF-EITHER-WANTS-TO (STOP-AFTER-SO-MANY-SECONDS 1.732868) (STOP-WHEN-THERE (QUOTE (SUBSCENE-OF THE-FINISH 1)))))))))) 
(DEFINE (SPECIAL-DYNAMICS-OF TORTOISE IN (SUBSCENE-OF THE-FINISH 1)) SPECIAL-DYNAMICS (SET YOUR OFFSPRING TO (|(SPECIAL-DYNAMICS-OF TORTOISE IN (SUBSCENE-OF THE-FINISH 1))-1|)) (SET YOUR PATH-JAGGEDNESS TO LOW) (SET YOUR PATH-CURVATURE TO MEDIUM) (SET YOUR PATH-LENGTH TO MEDIUM) (SET YOUR DELIBERATENESS TO HIGH) (SET YOUR REPETIVENESS TO HIGH) (SET YOUR ACCELERATION TO MEDIUM) (SET YOUR RHYTHMIC-LEVEL TO MEDIUM) (SET YOUR ACTIVITY-LEVEL TO HIGH) (SET YOUR SPEED TO HIGH)) 
(DEFINE |(SPECIAL-DYNAMICS-OF TORTOISE IN (SUBSCENE-OF THE-FINISH 1))-1| (SPECIAL-DYNAMICS-OF TORTOISE IN (SUBSCENE-OF THE-FINISH 1)) (SET YOUR (SPEED FACTOR) TO 1.0)) 
(ASK HARE TAKE LOOK (LOOK: SHAPE EIGHT-POINTED-STAR ANGLE 135 CENTER-OFFSET NIL ANI-SIZE 0.07 LOOK-COLOR (0.0 1.0 0.45))) 
(ASK TORTOISE TAKE LOOK (LOOK: SHAPE SQUARE ANGLE 90 CENTER-OFFSET NIL ANI-SIZE 0.036 LOOK-COLOR (270.0 0.35 0.65))) 