;;this is all that Director need know to display the scene THE-RACE
(DEFINE THE-RACE DIRECTOR-SCENE (SET YOUR SUBSCENES TO ((SUBSCENE-OF THE-RACE 1) (SUBSCENE-OF THE-RACE 2)))) 

(DEFINE (SUBSCENE-OF THE-RACE 1) DIRECTOR-SUBSCENE (SET YOUR SCENE TO THE-RACE) (SET YOUR CONVEY-TASKS TO (CONVEY-TASK-1)) (SET YOUR (LOCATION-OF TORTOISE) TO (PLACE: WHERE (XY-POSITION -0.31516219 -0.27305599) WHY (ENDED UP HERE IN THE-BOAST) STATUS COOL)) (SET YOUR (LOCATION-OF HARE) TO (PLACE: WHERE (XY-POSITION -0.19595312 -0.26813927) WHY (ENDED UP HERE IN THE-BOAST) STATUS COOL)) (SET YOUR STRETCHED-BY TO 0.96592434) (SET YOUR MOVEMENTS TO ((REPEAT 5 (AND (ACTIVITY-OF PUSHER-COMES-IN-CONTACT 1) (ACTIVITY-OF MOVING-TOGETHER 1) (ACTIVITY-OF PUSHEE-COASTS 1) (ACTIVITY-OF PUSHEE-MOVES-AWAY 1))))) (SET YOUR SPECIAL-DYNAMICS TO (|(SPECIAL-DYNAMICS-OF HARE IN (SUBSCENE-OF THE-RACE 1))-13-1| |(SPECIAL-DYNAMICS-OF HARE IN (SUBSCENE-OF THE-RACE 1))-13-2| |(SPECIAL-DYNAMICS-OF HARE IN (SUBSCENE-OF THE-RACE 1))-13-3| |(SPECIAL-DYNAMICS-OF TORTOISE IN (SUBSCENE-OF THE-RACE 1))-14|)) (SET YOUR PLANS TO ((ACTIVITY-OF PUSHER-COMES-IN-CONTACT 1) (ACTIVITY-OF MOVING-TOGETHER 1) (ACTIVITY-OF PUSHEE-COASTS 1) (ACTIVITY-OF PUSHEE-MOVES-AWAY 1))) (SET YOUR RUNNING-TIME TO 24.0)) 
(DEFINE (ACTIVITY-OF PUSHER-COMES-IN-CONTACT 1) PLAN (SET YOUR BEGIN-TIME TO 0.5) (SET YOUR SUBSCENE TO (SUBSCENE-OF THE-RACE 1)) (SET YOUR PLANS TO ((SEQUENCE: (ASK HARE SET YOUR SPECIAL-DYNAMICS TO |(SPECIAL-DYNAMICS-OF HARE IN (SUBSCENE-OF THE-RACE 1))-13-1|) (ASK HARE INITIALIZE YOUR CURVATURE-SIGN TOWARDS (CONTACT-WITH TORTOISE BY HARE)) (ASK (ACTIVITY-OF PUSHER-COMES-IN-CONTACT 1) CAUSE (HARE) TO GRADUALLY GO IN ARC REGARDLESS OF COLLISIONS TO (CONTACT-WITH TORTOISE BY HARE) AS MOVING-TARGET STOPPING IF (STOP-WHEN-THERE (QUOTE (SUBSCENE-OF THE-RACE 1)))))))) 
(DEFINE (ACTIVITY-OF MOVING-TOGETHER 1) PLAN (SET YOUR BEGIN-TIME TO (AFTER (END-OF (ACTIVITY-OF PUSHER-COMES-IN-CONTACT 1)) 0.05)) (SET YOUR SUBSCENE TO (SUBSCENE-OF THE-RACE 1)) (SET YOUR PLANS TO ((SEQUENCE: (ASK HARE SET YOUR SPECIAL-DYNAMICS TO |(SPECIAL-DYNAMICS-OF HARE IN (SUBSCENE-OF THE-RACE 1))-13-2|) (ASK HARE INITIALIZE YOUR CURVATURE-SIGN TOWARDS (DISTANCE-TOWARDS-FROM (VICINITY-OF HARE) (VICINITY-OF TORTOISE) 0.134)) (ASK (ACTIVITY-OF MOVING-TOGETHER 1) CAUSE (HARE TORTOISE) TO GRADUALLY GO IN ARC CAREFUL OF COLLISIONS TO (DISTANCE-TOWARDS-FROM (VICINITY-OF HARE) (VICINITY-OF TORTOISE) 0.134) AS STATIONARY-TARGET STOPPING IF (STOP-WHEN-THERE (QUOTE (SUBSCENE-OF THE-RACE 1)))))))) 
(DEFINE (ACTIVITY-OF PUSHEE-COASTS 1) PLAN (SET YOUR BEGIN-TIME TO (AFTER (END-OF (ACTIVITY-OF MOVING-TOGETHER 1)) 0.05)) (SET YOUR SUBSCENE TO (SUBSCENE-OF THE-RACE 1)) (SET YOUR PLANS TO ((SEQUENCE: (ASK TORTOISE SET YOUR SPECIAL-DYNAMICS TO |(SPECIAL-DYNAMICS-OF HARE IN (SUBSCENE-OF THE-RACE 1))-13-3|) (ASK TORTOISE INITIALIZE YOUR CURVATURE-SIGN TOWARDS (DISTANCE-AWAY-FROM (VICINITY-OF TORTOISE) (VICINITY-OF HARE) 0.1)) (ASK (ACTIVITY-OF PUSHEE-COASTS 1) CAUSE (TORTOISE) TO GRADUALLY GO IN ARC CAREFUL OF COLLISIONS TO (DISTANCE-AWAY-FROM (VICINITY-OF TORTOISE) (VICINITY-OF HARE) 0.1) AS STATIONARY-TARGET STOPPING IF (STOP-WHEN-THERE (QUOTE (SUBSCENE-OF THE-RACE 1)))))))) 
(DEFINE (ACTIVITY-OF PUSHEE-MOVES-AWAY 1) PLAN (SET YOUR BEGIN-TIME TO (AFTER (END-OF (ACTIVITY-OF PUSHEE-COASTS 1)) 0.0)) (SET YOUR SUBSCENE TO (SUBSCENE-OF THE-RACE 1)) (SET YOUR PLANS TO ((SEQUENCE: (ASK TORTOISE SET YOUR SPECIAL-DYNAMICS TO |(SPECIAL-DYNAMICS-OF TORTOISE IN (SUBSCENE-OF THE-RACE 1))-14|) (ASK TORTOISE INITIALIZE YOUR CURVATURE-SIGN TOWARDS (A-SMALL-DISTANCE-AWAY-FROM-AND-TOWARDS-CENTER (VICINITY-OF TORTOISE) (VICINITY-OF HARE))) (ASK (ACTIVITY-OF PUSHEE-MOVES-AWAY 1) CAUSE (TORTOISE) TO GRADUALLY GO IN ARC CAREFUL OF COLLISIONS TO (A-SMALL-DISTANCE-AWAY-FROM-AND-TOWARDS-CENTER (VICINITY-OF TORTOISE) (VICINITY-OF HARE)) AS STATIONARY-TARGET STOPPING IF (STOP-WHEN-THERE (QUOTE (SUBSCENE-OF THE-RACE 1)))))))) 
(DEFINE (SUBSCENE-OF THE-RACE 2) DIRECTOR-SUBSCENE (SET YOUR SCENE TO THE-RACE) (SET YOUR CONVEY-TASKS TO (CONVEY-TASK-2)) (SET YOUR (LOCATION-OF HARE) TO (PLACE: WHERE (SYMBOLIC-POSITION (MOVE-FROM-XY-POSITION (VICINITY-OF HARE) (VICINITY-OF TORTOISE) 0.134 KEEP-ON-STAGE)) WHY (AND MOVE-CHARACTER (ENDED UP HERE IN THE-BOAST)) STATUS COOL)) (SET YOUR (LOCATION-OF TORTOISE) TO (PLACE: WHERE (SYMBOLIC-POSITION DONT-KNOW-ENUF) WHY (AND MOVE-CHARACTER (ENDED UP HERE IN THE-BOAST)) STATUS COOL)) (SET YOUR STRETCHED-BY TO 1.0) (SET YOUR MOVEMENTS TO ((AND (ACTIVITY-OF CHASEE-RUNS-AWAY 1) (ACTIVITY-OF CHASER-PURSUES 1)))) (SET YOUR SPECIAL-DYNAMICS TO (|(SPECIAL-DYNAMICS-OF HARE IN (SUBSCENE-OF THE-RACE 2))-15| |(SPECIAL-DYNAMICS-OF TORTOISE IN (SUBSCENE-OF THE-RACE 2))-16|)) (SET YOUR PLANS TO ((ACTIVITY-OF CHASEE-RUNS-AWAY 1) (ACTIVITY-OF CHASER-PURSUES 1))) (SET YOUR RUNNING-TIME TO 1.5442857)) 
(DEFINE (ACTIVITY-OF CHASEE-RUNS-AWAY 1) PLAN (SET YOUR BEGIN-TIME TO 0.0) (SET YOUR SUBSCENE TO (SUBSCENE-OF THE-RACE 2)) (SET YOUR PLANS TO ((SEQUENCE: (ASK HARE SET YOUR SPECIAL-DYNAMICS TO |(SPECIAL-DYNAMICS-OF HARE IN (SUBSCENE-OF THE-RACE 2))-15|) (ASK HARE INITIALIZE YOUR CURVATURE-SIGN TOWARDS (DISTANCE-AWAY-FROM (VICINITY-OF HARE) (VICINITY-OF TORTOISE) 0.25)) (ASK (ACTIVITY-OF CHASEE-RUNS-AWAY 1) CAUSE (HARE) TO GRADUALLY GO IN ARC CAREFUL OF COLLISIONS TO (DISTANCE-AWAY-FROM (VICINITY-OF HARE) (VICINITY-OF TORTOISE) 0.25) AS MOVING-TARGET STOPPING IF (MOVE-ONLY-ORIGINAL-DISTANCE (QUOTE (SUBSCENE-OF THE-RACE 2)))))))) 
(DEFINE (ACTIVITY-OF CHASER-PURSUES 1) PLAN (SET YOUR BEGIN-TIME TO (AFTER (BEGINNING-OF (ACTIVITY-OF CHASEE-RUNS-AWAY 1)) 0.5)) (SET YOUR SUBSCENE TO (SUBSCENE-OF THE-RACE 2)) (SET YOUR PLANS TO ((SEQUENCE: (ASK TORTOISE SET YOUR SPECIAL-DYNAMICS TO |(SPECIAL-DYNAMICS-OF TORTOISE IN (SUBSCENE-OF THE-RACE 2))-16|) (ASK TORTOISE INITIALIZE YOUR CURVATURE-SIGN TOWARDS (SMALL-WAY-FROM-PLUS-SIZE (VICINITY-OF HARE) (VICINITY-OF TORTOISE) HARE)) (ASK (ACTIVITY-OF CHASER-PURSUES 1) CAUSE (TORTOISE) TO GRADUALLY GO IN ARC REGARDLESS OF COLLISIONS TO (SMALL-WAY-FROM-PLUS-SIZE (VICINITY-OF HARE) (VICINITY-OF TORTOISE) HARE) AS MOVING-TARGET STOPPING IF (STOP-WHEN-THERE-THEN (QUOTE (SUBSCENE-OF THE-RACE 2)) (STOP-PLAN (QUOTE (ACTIVITY-OF CHASEE-RUNS-AWAY 1))))))))) 
