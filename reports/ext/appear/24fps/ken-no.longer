(ASK CINDERELLA TAKE LOOK (LOOK: SHAPE HEXAGON ANGLE 60 CENTER-OFFSET NIL ANI-SIZE 0.036 LOOK-COLOR (270.0 0.35 0.65))) 
(ASK STEP-MOTHER TAKE LOOK (LOOK: SHAPE TRIANGLE ANGLE 120 CENTER-OFFSET (RIGHT 30) ANI-SIZE 0.07 LOOK-COLOR (30.0 0.35 0.45))) 
(ASK FAIRY-GODMOTHER TAKE LOOK (LOOK: SHAPE EIGHT-POINTED-STAR ANGLE 135 CENTER-OFFSET NIL ANI-SIZE 0.05 LOOK-COLOR (270.0 0.65 0.85))) 
(ASK PRINCE TAKE LOOK (LOOK: SHAPE CIRCLE ANGLE 5 CENTER-OFFSET NIL ANI-SIZE 0.07 LOOK-COLOR (0.0 1.0 0.85))) 