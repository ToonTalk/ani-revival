;;this is all that Director need know to display the scene NO-LONGER-KEPT-APART
(DEFINE NO-LONGER-KEPT-APART DIRECTOR-SCENE (SET YOUR SUBSCENES TO ((SUBSCENE-OF NO-LONGER-KEPT-APART 1)))) 

(DEFINE (SUBSCENE-OF NO-LONGER-KEPT-APART 1) DIRECTOR-SUBSCENE (SET YOUR SCENE TO NO-LONGER-KEPT-APART) (SET YOUR CONVEY-TASKS TO (CONVEY-TASK-3)) (SET YOUR (LOCATION-OF PRINCE) TO (PLACE: WHERE (XY-POSITION 0.25690998 -0.38220899) WHY (ENDED UP HERE IN KEPT-APART) STATUS COOL)) (SET YOUR (LOCATION-OF FAIRY-GODMOTHER) TO (PLACE: WHERE (XY-POSITION 0.0 0.0) WHY (ENDED UP HERE IN KEPT-APART) STATUS COOL)) (SET YOUR (LOCATION-OF STEP-MOTHER) TO (PLACE: WHERE (XY-POSITION 0.10988811 -0.1940235) WHY (ENDED UP HERE IN KEPT-APART) STATUS COOL)) (SET YOUR (LOCATION-OF CINDERELLA) TO (PLACE: WHERE (XY-POSITION 0.0086311168 -0.05846042) WHY (ENDED UP HERE IN KEPT-APART) STATUS COOL)) (SET YOUR STRETCHED-BY TO 1.0) (SET YOUR MOVEMENTS TO ((AND (ACTIVITY-OF GETTING-ON-STAGE 1) (ACTIVITY-OF GOES-TO-TO-ACCOMPANY 1) (ACTIVITY-OF ACCOMPANYING-EACH-OTHER 1)))) (SET YOUR SPECIAL-DYNAMICS TO (|(SPECIAL-DYNAMICS-OF CINDERELLA IN (SUBSCENE-OF NO-LONGER-KEPT-APART 1))-13| |(SPECIAL-DYNAMICS-OF FAIRY-GODMOTHER IN (SUBSCENE-OF NO-LONGER-KEPT-APART 1))-12| |(SPECIAL-DYNAMICS-OF FAIRY-GODMOTHER IN (SUBSCENE-OF NO-LONGER-KEPT-APART 1))-12-1|)) (SET YOUR PLANS TO ((ACTIVITY-OF GETTING-ON-STAGE 1) (ACTIVITY-OF GOES-TO-TO-ACCOMPANY 1) (ACTIVITY-OF ACCOMPANYING-EACH-OTHER 1))) (SET YOUR RUNNING-TIME TO 3.98)) 
(DEFINE (ACTIVITY-OF GETTING-ON-STAGE 1) PLAN (SET YOUR BEGIN-TIME TO 0.0) (SET YOUR SUBSCENE TO (SUBSCENE-OF NO-LONGER-KEPT-APART 1)) (SET YOUR PLANS TO ((SEQUENCE: (ASK CINDERELLA SET YOUR SPECIAL-DYNAMICS TO |(SPECIAL-DYNAMICS-OF CINDERELLA IN (SUBSCENE-OF NO-LONGER-KEPT-APART 1))-13|) (ASK CINDERELLA INITIALIZE YOUR CURVATURE-SIGN TOWARDS (ON-STAGE-NEAR CINDERELLA (VICINITY-OF FAIRY-GODMOTHER))) (ASK (ACTIVITY-OF GETTING-ON-STAGE 1) CAUSE (CINDERELLA) TO GRADUALLY GO IN ARC CAREFUL OF COLLISIONS TO (ON-STAGE-NEAR CINDERELLA (VICINITY-OF FAIRY-GODMOTHER)) AS STATIONARY-TARGET STOPPING IF (STOP-WHEN-THERE (QUOTE (SUBSCENE-OF NO-LONGER-KEPT-APART 1)))))))) 
(DEFINE (ACTIVITY-OF GOES-TO-TO-ACCOMPANY 1) PLAN (SET YOUR BEGIN-TIME TO 0.5) (SET YOUR SUBSCENE TO (SUBSCENE-OF NO-LONGER-KEPT-APART 1)) (SET YOUR PLANS TO ((SEQUENCE: (ASK FAIRY-GODMOTHER SET YOUR SPECIAL-DYNAMICS TO |(SPECIAL-DYNAMICS-OF FAIRY-GODMOTHER IN (SUBSCENE-OF NO-LONGER-KEPT-APART 1))-12|) (ASK FAIRY-GODMOTHER INITIALIZE YOUR CURVATURE-SIGN TOWARDS (CONTACT-WITH CINDERELLA BY FAIRY-GODMOTHER)) (ASK (ACTIVITY-OF GOES-TO-TO-ACCOMPANY 1) CAUSE (FAIRY-GODMOTHER) TO GRADUALLY GO IN ARC CAREFUL OF COLLISIONS TO (CONTACT-WITH CINDERELLA BY FAIRY-GODMOTHER) AS MOVING-TARGET STOPPING IF (STOP-WHEN-THERE-THEN (QUOTE (SUBSCENE-OF NO-LONGER-KEPT-APART 1)) (STOP-PLAN (QUOTE (ACTIVITY-OF GETTING-ON-STAGE 1))))))))) 
(DEFINE (ACTIVITY-OF ACCOMPANYING-EACH-OTHER 1) PLAN (SET YOUR BEGIN-TIME TO (AFTER (END-OF (ACTIVITY-OF GOES-TO-TO-ACCOMPANY 1)) 0.5)) (SET YOUR SUBSCENE TO (SUBSCENE-OF NO-LONGER-KEPT-APART 1)) (SET YOUR PLANS TO ((SEQUENCE: (ASK FAIRY-GODMOTHER SET YOUR SPECIAL-DYNAMICS TO |(SPECIAL-DYNAMICS-OF FAIRY-GODMOTHER IN (SUBSCENE-OF NO-LONGER-KEPT-APART 1))-12-1|) (ASK FAIRY-GODMOTHER INITIALIZE YOUR CURVATURE-SIGN TOWARDS (VICINITY-OF PRINCE)) (ASK (ACTIVITY-OF ACCOMPANYING-EACH-OTHER 1) CAUSE (FAIRY-GODMOTHER CINDERELLA) TO GRADUALLY GO IN ARC CAREFUL OF COLLISIONS TO (VICINITY-OF PRINCE) AS STATIONARY-TARGET STOPPING IF (STOP-IF-EITHER-WANTS-TO (STOP-AFTER-SO-MANY-SECONDS 2.98) (STOP-WHEN-THERE (QUOTE (SUBSCENE-OF NO-LONGER-KEPT-APART 1))))))))) 
(DEFINE (SPECIAL-DYNAMICS-OF FAIRY-GODMOTHER IN (SUBSCENE-OF NO-LONGER-KEPT-APART 1)) SPECIAL-DYNAMICS (SET YOUR OFFSPRING TO (|(SPECIAL-DYNAMICS-OF FAIRY-GODMOTHER IN (SUBSCENE-OF NO-LONGER-KEPT-APART 1))-12| |(SPECIAL-DYNAMICS-OF FAIRY-GODMOTHER IN (SUBSCENE-OF NO-LONGER-KEPT-APART 1))-11| |(SPECIAL-DYNAMICS-OF FAIRY-GODMOTHER IN (SUBSCENE-OF NO-LONGER-KEPT-APART 1))-10| |(SPECIAL-DYNAMICS-OF FAIRY-GODMOTHER IN (SUBSCENE-OF NO-LONGER-KEPT-APART 1))-8| |(SPECIAL-DYNAMICS-OF FAIRY-GODMOTHER IN (SUBSCENE-OF NO-LONGER-KEPT-APART 1))-7| |(SPECIAL-DYNAMICS-OF FAIRY-GODMOTHER IN (SUBSCENE-OF NO-LONGER-KEPT-APART 1))-6| |(SPECIAL-DYNAMICS-OF FAIRY-GODMOTHER IN (SUBSCENE-OF NO-LONGER-KEPT-APART 1))-5| |(SPECIAL-DYNAMICS-OF FAIRY-GODMOTHER IN (SUBSCENE-OF NO-LONGER-KEPT-APART 1))-3| |(SPECIAL-DYNAMICS-OF FAIRY-GODMOTHER IN (SUBSCENE-OF NO-LONGER-KEPT-APART 1))-2| |(SPECIAL-DYNAMICS-OF FAIRY-GODMOTHER IN (SUBSCENE-OF NO-LONGER-KEPT-APART 1))-1|)) (SET YOUR PATH-JAGGEDNESS TO HIGH) (SET YOUR PATH-CURVATURE TO LOW) (SET YOUR PATH-LENGTH TO SHORT) (SET YOUR DELIBERATENESS TO LOW) (SET YOUR REPETIVENESS TO LOW) (SET YOUR ACCELERATION TO MEDIUM) (SET YOUR RHYTHMIC-LEVEL TO LOW) (SET YOUR ACTIVITY-LEVEL TO LOW) (SET YOUR SPEED TO HIGH) (SET YOUR (PATH-CURVATURE FACTOR) TO 0.5)) 
(DEFINE |(SPECIAL-DYNAMICS-OF FAIRY-GODMOTHER IN (SUBSCENE-OF NO-LONGER-KEPT-APART 1))-1| (SPECIAL-DYNAMICS-OF FAIRY-GODMOTHER IN (SUBSCENE-OF NO-LONGER-KEPT-APART 1)) (SET YOUR (SPEED FACTOR) TO 1.6)) 
(DEFINE |(SPECIAL-DYNAMICS-OF FAIRY-GODMOTHER IN (SUBSCENE-OF NO-LONGER-KEPT-APART 1))-2| (SPECIAL-DYNAMICS-OF FAIRY-GODMOTHER IN (SUBSCENE-OF NO-LONGER-KEPT-APART 1)) (SET YOUR (SPEED FACTOR) TO 1.4)) 
