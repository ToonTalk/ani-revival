;;this is all that Director need know to display the scene THE-DANCE
(DEFINE THE-DANCE DIRECTOR-SCENE (SET YOUR SUBSCENES TO ((SUBSCENE-OF THE-DANCE 1) (SUBSCENE-OF THE-DANCE 2) (SUBSCENE-OF THE-DANCE 3) (SUBSCENE-OF THE-DANCE 4)))) 

(DEFINE (SUBSCENE-OF THE-DANCE 1) DIRECTOR-SUBSCENE (SET YOUR SCENE TO THE-DANCE) (SET YOUR ESTABLISH-TASKS TO (ESTABLISH-TASK-6)) (SET YOUR CONVEY-TASKS TO (CONVEY-TASK-2)) (SET YOUR (LOCATION-OF PRINCE) TO (PLACE: WHERE (XY-POSITION 0.15976822 -0.15467745) WHY (ENDED UP HERE IN LEARNING) STATUS COOL)) (SET YOUR (LOCATION-OF FAIRY-GODMOTHER) TO (PLACE: WHERE (XY-POSITION 0.0 0.0) WHY (ENDED UP HERE IN LEARNING) STATUS COOL)) (SET YOUR (LOCATION-OF STEP-MOTHER) TO (PLACE: WHERE (XY-POSITION 0.0 0.0) WHY (ENDED UP HERE IN LEARNING) STATUS COOL)) (SET YOUR (LOCATION-OF CINDERELLA) TO (PLACE: WHERE (XY-POSITION 0.16200376 -0.15459522) WHY (ENDED UP HERE IN LEARNING) STATUS COOL)) (SET YOUR STRETCHED-BY TO 1.0) (SET YOUR MOVEMENTS TO ((AND (ACTIVITY-OF GETTING-ON-STAGE 1) (ACTIVITY-OF GOES-TO-TO-ACCOMPANY 1) (ACTIVITY-OF ACCOMPANYING-EACH-OTHER 1)))) (SET YOUR INITIAL-ACTIONS TO ((ASK CINDERELLA TO SET YOUR SPECIAL-DYNAMICS TO (SPECIAL-DYNAMICS-OF CINDERELLA IN (SUBSCENE-OF THE-DANCE 1))))) (SET YOUR (CHANGES-FOR CINDERELLA) TO ((GRADUALLY CHANGE BY 1.5 FACTOR FOR ACTIVITY-LEVEL AT HIGH SPEED) (GRADUALLY CHANGE BY 1.5 FACTOR FOR SPEED AT HIGH SPEED) (GRADUALLY CHANGE BY 1.5 FACTOR FOR RHYTHMIC-LEVEL AT HIGH SPEED) (GRADUALLY CHANGE BY 1.5 FACTOR FOR ACCELERATION AT HIGH SPEED) (GRADUALLY CHANGE BY 2.0 FACTOR FOR PATH-LENGTH AT HIGH SPEED))) (SET YOUR SPECIAL-DYNAMICS TO (|(SPECIAL-DYNAMICS-OF CINDERELLA IN (SUBSCENE-OF THE-DANCE 1))-5| |(SPECIAL-DYNAMICS-OF CINDERELLA IN (SUBSCENE-OF THE-DANCE 1))-5-1| |(SPECIAL-DYNAMICS-OF PRINCE IN (SUBSCENE-OF THE-DANCE 1))-6|)) (SET YOUR PLANS TO ((ACTIVITY-OF GOES-TO-TO-ACCOMPANY 1) (ACTIVITY-OF ACCOMPANYING-EACH-OTHER 1) (ACTIVITY-OF GETTING-ON-STAGE 1))) (SET YOUR RUNNING-TIME TO 5.63)) 
(DEFINE (ACTIVITY-OF GOES-TO-TO-ACCOMPANY 1) PLAN (SET YOUR BEGIN-TIME TO 0.5) (SET YOUR SUBSCENE TO (SUBSCENE-OF THE-DANCE 1)) (SET YOUR PLANS TO ((SEQUENCE: (ASK CINDERELLA SET YOUR SPECIAL-DYNAMICS TO |(SPECIAL-DYNAMICS-OF CINDERELLA IN (SUBSCENE-OF THE-DANCE 1))-5|) (ASK CINDERELLA INITIALIZE YOUR CURVATURE-SIGN TOWARDS (CONTACT-WITH PRINCE BY CINDERELLA)) (ASK (ACTIVITY-OF GOES-TO-TO-ACCOMPANY 1) CAUSE (CINDERELLA) TO GRADUALLY GO IN ARC CAREFUL OF COLLISIONS TO (CONTACT-WITH PRINCE BY CINDERELLA) AS MOVING-TARGET STOPPING IF (STOP-WHEN-THERE-THEN (QUOTE (SUBSCENE-OF THE-DANCE 1)) (STOP-PLAN (QUOTE (ACTIVITY-OF GETTING-ON-STAGE 1))))))))) 
(DEFINE (ACTIVITY-OF ACCOMPANYING-EACH-OTHER 1) PLAN (SET YOUR BEGIN-TIME TO (AFTER (END-OF (ACTIVITY-OF GOES-TO-TO-ACCOMPANY 1)) 0.5)) (SET YOUR SUBSCENE TO (SUBSCENE-OF THE-DANCE 1)) (SET YOUR PLANS TO ((SEQUENCE: (ASK CINDERELLA SET YOUR SPECIAL-DYNAMICS TO |(SPECIAL-DYNAMICS-OF CINDERELLA IN (SUBSCENE-OF THE-DANCE 1))-5-1|) (ASK CINDERELLA INITIALIZE YOUR CURVATURE-SIGN TOWARDS (GOOD-DISTANCE-FROM (VICINITY-OF CINDERELLA))) (ASK (ACTIVITY-OF ACCOMPANYING-EACH-OTHER 1) CAUSE (CINDERELLA PRINCE) TO GRADUALLY GO IN ARC CAREFUL OF COLLISIONS TO (GOOD-DISTANCE-FROM (VICINITY-OF CINDERELLA)) AS STATIONARY-TARGET STOPPING IF (STOP-IF-EITHER-WANTS-TO (STOP-AFTER-SO-MANY-SECONDS 4.63) (STOP-WHEN-THERE (QUOTE (SUBSCENE-OF THE-DANCE 1))))))))) 
