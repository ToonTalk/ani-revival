;;this is all that Director need know to display the scene LEARNING
(DEFINE LEARNING DIRECTOR-SCENE (SET YOUR SUBSCENES TO ((SUBSCENE-OF LEARNING 1) (SUBSCENE-OF LEARNING 2)))) 

(DEFINE (SUBSCENE-OF LEARNING 1) DIRECTOR-SUBSCENE (SET YOUR SCENE TO LEARNING) (SET YOUR CONVEY-TASKS TO (CONVEY-TASK-1)) (SET YOUR (LOCATION-OF PRINCE) TO (PLACE: WHERE (XY-POSITION 0.15976822 -0.15467745) WHY (ENDED UP HERE IN WALLFLOWER) STATUS COOL)) (SET YOUR (LOCATION-OF FAIRY-GODMOTHER) TO (PLACE: WHERE (XY-POSITION 0.0 0.0) WHY (ENDED UP HERE IN WALLFLOWER) STATUS COOL)) (SET YOUR (LOCATION-OF STEP-MOTHER) TO (PLACE: WHERE (XY-POSITION 0.0 0.0) WHY (ENDED UP HERE IN WALLFLOWER) STATUS COOL)) (SET YOUR (LOCATION-OF CINDERELLA) TO (PLACE: WHERE (XY-POSITION 0.16200376 -0.15459522) WHY (ENDED UP HERE IN WALLFLOWER) STATUS COOL)) (SET YOUR PARASITES TO ((SUBSCENE-OF LEARNING 2))) (SET YOUR RUNNING-TIME TO 16.0) (SET YOUR STRETCHED-BY TO 1.6) (SET YOUR INITIAL-ACTIONS TO ((ASK CINDERELLA TO SET YOUR SPECIAL-DYNAMICS TO (SPECIAL-DYNAMICS-OF CINDERELLA IN (SUBSCENE-OF LEARNING 1))))) (SET YOUR PLANS TO ((ACTIVITY-OF WANDERING-WHILE-CHANGING 3) (ACTIVITY-OF WANDERING-WHILE-CHANGING 4) (ACTIVITY-OF BRIDGING-THE-GAP 2))) (SET YOUR MOVEMENTS TO ((AND (ACTIVITY-OF BRIDGING-THE-GAP 2) (SEQUENCE: (ACTIVITY-OF WANDERING-WHILE-CHANGING 3) (ACTIVITY-OF WANDERING-WHILE-CHANGING 4))))) (SET YOUR SPECIAL-DYNAMICS TO (|(SPECIAL-DYNAMICS-OF CINDERELLA IN (SUBSCENE-OF LEARNING 1))-3| |(SPECIAL-DYNAMICS-OF CINDERELLA IN (SUBSCENE-OF LEARNING 1))-4|))) 
(DEFINE (ACTIVITY-OF WANDERING-WHILE-CHANGING 3) PLAN (SET YOUR BEGIN-TIME TO 0.0) (SET YOUR SUBSCENE TO (SUBSCENE-OF LEARNING 1)) (SET YOUR PLANS TO ((SEQUENCE: (ASK CINDERELLA SET YOUR SPECIAL-DYNAMICS TO |(SPECIAL-DYNAMICS-OF CINDERELLA IN (SUBSCENE-OF LEARNING 1))-3|) (ASK CINDERELLA INITIALIZE YOUR CURVATURE-SIGN TOWARDS (GOOD-DISTANCE-FROM (VICINITY-OF CINDERELLA))) (ASK (ACTIVITY-OF WANDERING-WHILE-CHANGING 3) CAUSE (CINDERELLA) TO GRADUALLY GO IN ARC CAREFUL OF COLLISIONS TO (GOOD-DISTANCE-FROM (VICINITY-OF CINDERELLA)) AS STATIONARY-TARGET STOPPING IF (STOP-IF-EITHER-WANTS-TO (STOP-AFTER-SO-MANY-SECONDS 8.0) (STOP-WHEN-THERE (QUOTE (SUBSCENE-OF LEARNING 1))))))))) 
(DEFINE (ACTIVITY-OF WANDERING-WHILE-CHANGING 4) PLAN (SET YOUR BEGIN-TIME TO 0.0) (SET YOUR SUBSCENE TO (SUBSCENE-OF LEARNING 1)) (SET YOUR PLANS TO ((SEQUENCE: (ASK CINDERELLA SET YOUR SPECIAL-DYNAMICS TO |(SPECIAL-DYNAMICS-OF CINDERELLA IN (SUBSCENE-OF LEARNING 1))-4|) (ASK CINDERELLA INITIALIZE YOUR CURVATURE-SIGN TOWARDS (GOOD-DISTANCE-FROM (VICINITY-OF CINDERELLA))) (ASK (ACTIVITY-OF WANDERING-WHILE-CHANGING 4) CAUSE (CINDERELLA) TO GRADUALLY GO IN ARC CAREFUL OF COLLISIONS TO (GOOD-DISTANCE-FROM (VICINITY-OF CINDERELLA)) AS STATIONARY-TARGET STOPPING IF (STOP-IF-EITHER-WANTS-TO (STOP-AFTER-SO-MANY-SECONDS 8.0) (STOP-WHEN-THERE (QUOTE (SUBSCENE-OF LEARNING 1))))))))) 
(DEFINE (ACTIVITY-OF BRIDGING-THE-GAP 2) PLAN (SET YOUR BEGIN-TIME TO 0.0) (SET YOUR SUBSCENE TO (SUBSCENE-OF LEARNING 1)) (SET YOUR PLANS TO ((AND (ASK CINDERELLA GRADUALLY CHANGE BY 2.0 FACTOR FOR SPEED IN 16.0 SECONDS) (ASK CINDERELLA GRADUALLY CHANGE LOOK BY 1.3888889 FACTOR FOR SIZE IN 16.0 SECONDS) (ASK CINDERELLA GRADUALLY CHANGE LOOK TO (LOOK: SHAPE OCTAGON ANGLE 45 CENTER-OFFSET NIL) IN 16.0 SECONDS))))) 
(DEFINE (SUBSCENE-OF LEARNING 2) DIRECTOR-SUBSCENE (SET YOUR SCENE TO LEARNING) (SET YOUR ESTABLISH-TASKS TO (ESTABLISH-TASK-3)) (SET YOUR (CINDERELLA SPEED) TO MEDIUM) (SET YOUR STRETCHED-BY TO 0.0) (SET YOUR INITIAL-ACTIONS TO ((ASK CINDERELLA TO SET YOUR SPECIAL-DYNAMICS TO (SPECIAL-DYNAMICS-OF CINDERELLA IN (SUBSCENE-OF LEARNING 2))))) (SET YOUR (CHANGES-FOR CINDERELLA) TO ((GRADUALLY CHANGE LOOK BY 1.25 FACTOR FOR COLOR-INTENSITY AT MEDIUM SPEED) (GRADUALLY CHANGE BY 1.25 FACTOR FOR ACTIVITY-LEVEL AT MEDIUM SPEED) (GRADUALLY CHANGE BY 1.25 FACTOR FOR SPEED AT MEDIUM SPEED) (GRADUALLY CHANGE BY 1.25 FACTOR FOR RHYTHMIC-LEVEL AT MEDIUM SPEED) (GRADUALLY CHANGE BY 1.25 FACTOR FOR ACCELERATION AT MEDIUM SPEED) (GRADUALLY CHANGE BY 2.0 FACTOR FOR PATH-LENGTH AT HIGH SPEED))) (SET YOUR BEGIN-TIME TO (AFTER (BEGINNING-OF (SUBSCENE-OF LEARNING 1)) 10.0)) (SET YOUR STATUS TO (PARASITE-ON (SUBSCENE-OF LEARNING 1))) (SET YOUR (LOCATION-OF CINDERELLA) TO (PLACE: WHERE (XY-POSITION -0.375 0.375) WHY (AND MOVE-CHARACTER (ENDED UP HERE IN WALLFLOWER)) STATUS COOL)) (SET YOUR RUNNING-TIME TO 6.0)) 
(DEFINE (SPECIAL-DYNAMICS-OF CINDERELLA IN (SUBSCENE-OF LEARNING 1)) SPECIAL-DYNAMICS (SET YOUR OFFSPRING TO (|(SPECIAL-DYNAMICS-OF CINDERELLA IN (SUBSCENE-OF LEARNING 1))-4| |(SPECIAL-DYNAMICS-OF CINDERELLA IN (SUBSCENE-OF LEARNING 1))-3| |(SPECIAL-DYNAMICS-OF CINDERELLA IN (SUBSCENE-OF LEARNING 1))-2| |(SPECIAL-DYNAMICS-OF CINDERELLA IN (SUBSCENE-OF LEARNING 1))-1|)) (SET YOUR PATH-JAGGEDNESS TO MEDIUM) (SET YOUR PATH-CURVATURE TO HIGH) (SET YOUR PATH-LENGTH TO MEDIUM) (SET YOUR DELIBERATENESS TO MEDIUM) (SET YOUR REPETIVENESS TO MEDIUM) (SET YOUR ACCELERATION TO LOW) (SET YOUR RHYTHMIC-LEVEL TO HIGH) (SET YOUR ACTIVITY-LEVEL TO HIGH) (SET YOUR SPEED TO LOW)) 
(DEFINE |(SPECIAL-DYNAMICS-OF CINDERELLA IN (SUBSCENE-OF LEARNING 1))-1| (SPECIAL-DYNAMICS-OF CINDERELLA IN (SUBSCENE-OF LEARNING 1)) (SET YOUR (SPEED FACTOR) TO 1.0)) 
(DEFINE |(SPECIAL-DYNAMICS-OF CINDERELLA IN (SUBSCENE-OF LEARNING 1))-2| (SPECIAL-DYNAMICS-OF CINDERELLA IN (SUBSCENE-OF LEARNING 1)) (SET YOUR (SPEED FACTOR) TO 1.0)) 
(DEFINE |(SPECIAL-DYNAMICS-OF CINDERELLA IN (SUBSCENE-OF LEARNING 1))-3| (SPECIAL-DYNAMICS-OF CINDERELLA IN (SUBSCENE-OF LEARNING 1)) (SET YOUR (SPEED FACTOR) TO 1.0)) 
(DEFINE |(SPECIAL-DYNAMICS-OF CINDERELLA IN (SUBSCENE-OF LEARNING 1))-4| (SPECIAL-DYNAMICS-OF CINDERELLA IN (SUBSCENE-OF LEARNING 1)) (SET YOUR (SPEED FACTOR) TO 1.0)) 
(DEFINE (SPECIAL-DYNAMICS-OF CINDERELLA IN (SUBSCENE-OF LEARNING 2)) SPECIAL-DYNAMICS (SET YOUR PATH-JAGGEDNESS TO MEDIUM) (SET YOUR PATH-CURVATURE TO HIGH) (SET YOUR PATH-LENGTH TO MEDIUM) (SET YOUR DELIBERATENESS TO MEDIUM) (SET YOUR REPETIVENESS TO MEDIUM) (SET YOUR ACCELERATION TO LOW) (SET YOUR RHYTHMIC-LEVEL TO HIGH) (SET YOUR ACTIVITY-LEVEL TO HIGH) (SET YOUR SPEED TO MEDIUM)) 
(ASK CINDERELLA TAKE LOOK (LOOK: SHAPE HEXAGON ANGLE 60 CENTER-OFFSET NIL ANI-SIZE 0.036 LOOK-COLOR (270.0 0.35 0.65))) 
(ASK STEP-MOTHER TAKE LOOK (LOOK: SHAPE TRIANGLE ANGLE 120 CENTER-OFFSET (RIGHT 30) ANI-SIZE 0.07 LOOK-COLOR (240.0 0.35 0.45))) 
(ASK FAIRY-GODMOTHER TAKE LOOK (LOOK: SHAPE EIGHT-POINTED-STAR ANGLE 135 CENTER-OFFSET NIL ANI-SIZE 0.05 LOOK-COLOR (30.0 0.65 0.85))) 
(ASK PRINCE TAKE LOOK (LOOK: SHAPE CIRCLE ANGLE 5 CENTER-OFFSET NIL ANI-SIZE 0.07 LOOK-COLOR (0.0 1.0 0.85))) 