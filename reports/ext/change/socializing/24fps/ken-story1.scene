;;this is all that Director need know to display the scene WALLFLOWER
(DEFINE WALLFLOWER DIRECTOR-SCENE (SET YOUR SUBSCENES TO ((SUBSCENE-OF WALLFLOWER 1) (SUBSCENE-OF WALLFLOWER 2)))) 

(DEFINE (SUBSCENE-OF WALLFLOWER 1) DIRECTOR-SUBSCENE (SET YOUR SCENE TO WALLFLOWER) (SET YOUR ESTABLISH-TASKS TO (ESTABLISH-TASK-2)) (SET YOUR CONVEY-TASKS TO (CONVEY-TASK-2)) (SET YOUR STRETCHED-BY TO 0.0) (SET YOUR INITIAL-ACTIONS TO ((ASK CINDERELLA TO SET YOUR SPECIAL-DYNAMICS TO (SPECIAL-DYNAMICS-OF CINDERELLA IN (SUBSCENE-OF WALLFLOWER 1))))) (SET YOUR (CHANGES-FOR CINDERELLA) TO ((GRADUALLY CHANGE LOOK BY 0.88888889 FACTOR FOR COLOR-INTENSITY AT LOW SPEED) (GRADUALLY CHANGE BY 0.88888889 FACTOR FOR ACTIVITY-LEVEL AT LOW SPEED) (GRADUALLY CHANGE BY 0.88888889 FACTOR FOR SPEED AT LOW SPEED) (GRADUALLY CHANGE BY 0.88888889 FACTOR FOR RHYTHMIC-LEVEL AT LOW SPEED) (GRADUALLY CHANGE BY 0.88888889 FACTOR FOR ACCELERATION AT LOW SPEED))) (SET YOUR (LOCATION-OF CINDERELLA) TO (PLACE: WHERE (SCREEN-POSITION MIDDLE MIDDLE) WHY (SO THAT (WANDER-AROUND CINDERELLA)) STATUS (PLACED BY (SUBSCENE-OF WALLFLOWER 1)))) (SET YOUR SPECIAL-DYNAMICS TO (|(SPECIAL-DYNAMICS-OF CINDERELLA IN (SUBSCENE-OF WALLFLOWER 1))-3|)) (SET YOUR PLANS TO ((ACTIVITY-OF WANDER-AROUND 2))) (SET YOUR RUNNING-TIME TO 1.1778304)) 
(DEFINE (ACTIVITY-OF WANDER-AROUND 2) PLAN (SET YOUR BEGIN-TIME TO 0.0) (SET YOUR SUBSCENE TO (SUBSCENE-OF WALLFLOWER 1)) (SET YOUR PLANS TO ((SEQUENCE: (SEQUENCE: (ASK CINDERELLA SET YOUR SPECIAL-DYNAMICS TO |(SPECIAL-DYNAMICS-OF CINDERELLA IN (SUBSCENE-OF WALLFLOWER 1))-3|) (ASK CINDERELLA INITIALIZE YOUR CURVATURE-SIGN TOWARDS (GOOD-DISTANCE-FROM (VICINITY-OF CINDERELLA))) (ASK (ACTIVITY-OF WANDER-AROUND 2) CAUSE (CINDERELLA) TO GRADUALLY GO IN ARC CAREFUL OF COLLISIONS TO (GOOD-DISTANCE-FROM (VICINITY-OF CINDERELLA)) AS STATIONARY-TARGET STOPPING IF (STOP-IF-EITHER-WANTS-TO (STOP-AFTER-SO-MANY-SECONDS 1.1778304) (STOP-WHEN-THERE (QUOTE (SUBSCENE-OF WALLFLOWER 1)))))))))) 
(DEFINE (SUBSCENE-OF WALLFLOWER 2) DIRECTOR-SUBSCENE (SET YOUR SCENE TO WALLFLOWER) (SET YOUR CONVEY-TASKS TO (CONVEY-TASK-3)) (SET YOUR (CINDERELLA ACCELERATION) TO LOW) (SET YOUR (CINDERELLA RHYTHMIC-LEVEL) TO HIGH) (SET YOUR (CINDERELLA SPEED) TO LOW) (SET YOUR (CINDERELLA ACTIVITY-LEVEL) TO HIGH) (SET YOUR STRETCHED-BY TO 1.343785) (SET YOUR (LOCATION-OF PRINCE) TO (PLACE: WHERE (MEDIUM-DISTANCE-FROM-AND-OFFSTAGE (VICINITY-OF CINDERELLA)) WHY (SO THAT (GOES-TO-AND-ACCOMPANIES CINDERELLA PRINCE)) STATUS (PLACED BY (SUBSCENE-OF WALLFLOWER 2)))) (SET YOUR MOVEMENTS TO ((AND (ACTIVITY-OF GETTING-ON-STAGE 1) (ACTIVITY-OF GOES-TO-TO-ACCOMPANY 1) (ACTIVITY-OF ACCOMPANYING-EACH-OTHER 1)))) (SET YOUR SPECIAL-DYNAMICS TO (|(SPECIAL-DYNAMICS-OF CINDERELLA IN (SUBSCENE-OF WALLFLOWER 2))-4| |(SPECIAL-DYNAMICS-OF CINDERELLA IN (SUBSCENE-OF WALLFLOWER 2))-4-1| |(SPECIAL-DYNAMICS-OF PRINCE IN (SUBSCENE-OF WALLFLOWER 2))-5|)) (SET YOUR PLANS TO ((ACTIVITY-OF GOES-TO-TO-ACCOMPANY 1) (ACTIVITY-OF ACCOMPANYING-EACH-OTHER 1) (ACTIVITY-OF GETTING-ON-STAGE 1))) (SET YOUR RUNNING-TIME TO 12.0)) 
(DEFINE (ACTIVITY-OF GOES-TO-TO-ACCOMPANY 1) PLAN (SET YOUR BEGIN-TIME TO 0.5) (SET YOUR SUBSCENE TO (SUBSCENE-OF WALLFLOWER 2)) (SET YOUR PLANS TO ((SEQUENCE: (ASK CINDERELLA SET YOUR SPECIAL-DYNAMICS TO |(SPECIAL-DYNAMICS-OF CINDERELLA IN (SUBSCENE-OF WALLFLOWER 2))-4|) (ASK CINDERELLA INITIALIZE YOUR CURVATURE-SIGN TOWARDS (CONTACT-WITH PRINCE BY CINDERELLA)) (ASK (ACTIVITY-OF GOES-TO-TO-ACCOMPANY 1) CAUSE (CINDERELLA) TO GRADUALLY GO IN ARC CAREFUL OF COLLISIONS TO (CONTACT-WITH PRINCE BY CINDERELLA) AS MOVING-TARGET STOPPING IF (STOP-WHEN-THERE-THEN (QUOTE (SUBSCENE-OF WALLFLOWER 2)) (STOP-PLAN (QUOTE (ACTIVITY-OF GETTING-ON-STAGE 1))))))))) 
(DEFINE (ACTIVITY-OF ACCOMPANYING-EACH-OTHER 1) PLAN (SET YOUR BEGIN-TIME TO (AFTER (END-OF (ACTIVITY-OF GOES-TO-TO-ACCOMPANY 1)) 0.5)) (SET YOUR SUBSCENE TO (SUBSCENE-OF WALLFLOWER 2)) (SET YOUR PLANS TO ((SEQUENCE: (ASK CINDERELLA SET YOUR SPECIAL-DYNAMICS TO |(SPECIAL-DYNAMICS-OF CINDERELLA IN (SUBSCENE-OF WALLFLOWER 2))-4-1|) (ASK CINDERELLA INITIALIZE YOUR CURVATURE-SIGN TOWARDS (GOOD-DISTANCE-FROM (VICINITY-OF CINDERELLA))) (ASK (ACTIVITY-OF ACCOMPANYING-EACH-OTHER 1) CAUSE (CINDERELLA PRINCE) TO GRADUALLY GO IN ARC CAREFUL OF COLLISIONS TO (GOOD-DISTANCE-FROM (VICINITY-OF CINDERELLA)) AS STATIONARY-TARGET STOPPING IF (STOP-IF-EITHER-WANTS-TO (STOP-AFTER-SO-MANY-SECONDS 11.0) (STOP-WHEN-THERE (QUOTE (SUBSCENE-OF WALLFLOWER 2))))))))) 
(DEFINE (ACTIVITY-OF GETTING-ON-STAGE 1) PLAN (SET YOUR BEGIN-TIME TO 0.0) (SET YOUR SUBSCENE TO (SUBSCENE-OF WALLFLOWER 2)) (SET YOUR PLANS TO ((SEQUENCE: (ASK PRINCE SET YOUR SPECIAL-DYNAMICS TO |(SPECIAL-DYNAMICS-OF PRINCE IN (SUBSCENE-OF WALLFLOWER 2))-5|) (ASK PRINCE INITIALIZE YOUR CURVATURE-SIGN TOWARDS (ON-STAGE-NEAR PRINCE (VICINITY-OF CINDERELLA))) (ASK (ACTIVITY-OF GETTING-ON-STAGE 1) CAUSE (PRINCE) TO GRADUALLY GO IN ARC CAREFUL OF COLLISIONS TO (ON-STAGE-NEAR PRINCE (VICINITY-OF CINDERELLA)) AS STATIONARY-TARGET STOPPING IF (STOP-WHEN-THERE (QUOTE (SUBSCENE-OF WALLFLOWER 2)))))))) 
(DEFINE (SPECIAL-DYNAMICS-OF CINDERELLA IN (SUBSCENE-OF WALLFLOWER 2)) SPECIAL-DYNAMICS (SET YOUR OFFSPRING TO (|(SPECIAL-DYNAMICS-OF CINDERELLA IN (SUBSCENE-OF WALLFLOWER 2))-4| |(SPECIAL-DYNAMICS-OF CINDERELLA IN (SUBSCENE-OF WALLFLOWER 2))-2| |(SPECIAL-DYNAMICS-OF CINDERELLA IN (SUBSCENE-OF WALLFLOWER 2))-1|)) (SET YOUR PATH-JAGGEDNESS TO MEDIUM) (SET YOUR PATH-CURVATURE TO HIGH) (SET YOUR PATH-LENGTH TO MEDIUM) (SET YOUR DELIBERATENESS TO MEDIUM) (SET YOUR REPETIVENESS TO MEDIUM) (SET YOUR ACCELERATION TO LOW) (SET YOUR RHYTHMIC-LEVEL TO HIGH) (SET YOUR ACTIVITY-LEVEL TO HIGH) (SET YOUR SPEED TO LOW)) 
(DEFINE |(SPECIAL-DYNAMICS-OF CINDERELLA IN (SUBSCENE-OF WALLFLOWER 2))-1| (SPECIAL-DYNAMICS-OF CINDERELLA IN (SUBSCENE-OF WALLFLOWER 2)) (SET YOUR (SPEED FACTOR) TO 0.8)) 
(DEFINE |(SPECIAL-DYNAMICS-OF CINDERELLA IN (SUBSCENE-OF WALLFLOWER 2))-2| (SPECIAL-DYNAMICS-OF CINDERELLA IN (SUBSCENE-OF WALLFLOWER 2)) (SET YOUR (SPEED FACTOR) TO 0.8)) 
(DEFINE |(SPECIAL-DYNAMICS-OF CINDERELLA IN (SUBSCENE-OF WALLFLOWER 2))-4| (SPECIAL-DYNAMICS-OF CINDERELLA IN (SUBSCENE-OF WALLFLOWER 2)) (SET YOUR OFFSPRING TO (|(SPECIAL-DYNAMICS-OF CINDERELLA IN (SUBSCENE-OF WALLFLOWER 2))-4-1|)) (SET YOUR (SPEED FACTOR) TO 0.74416667)) 
(DEFINE |(SPECIAL-DYNAMICS-OF CINDERELLA IN (SUBSCENE-OF WALLFLOWER 2))-4-1| |(SPECIAL-DYNAMICS-OF CINDERELLA IN (SUBSCENE-OF WALLFLOWER 2))-4| (SET YOUR (SPEED FACTOR) TO 0.59533333)) 
(DEFINE (SPECIAL-DYNAMICS-OF CINDERELLA IN (SUBSCENE-OF WALLFLOWER 1)) SPECIAL-DYNAMICS (SET YOUR OFFSPRING TO (|(SPECIAL-DYNAMICS-OF CINDERELLA IN (SUBSCENE-OF WALLFLOWER 1))-3|)) (SET YOUR PATH-JAGGEDNESS TO MEDIUM) (SET YOUR PATH-CURVATURE TO HIGH) (SET YOUR PATH-LENGTH TO MEDIUM) (SET YOUR DELIBERATENESS TO MEDIUM) (SET YOUR REPETIVENESS TO MEDIUM) (SET YOUR ACCELERATION TO LOW) (SET YOUR RHYTHMIC-LEVEL TO HIGH) (SET YOUR ACTIVITY-LEVEL TO HIGH) (SET YOUR SPEED TO LOW)) 
(DEFINE |(SPECIAL-DYNAMICS-OF CINDERELLA IN (SUBSCENE-OF WALLFLOWER 1))-3| (SPECIAL-DYNAMICS-OF CINDERELLA IN (SUBSCENE-OF WALLFLOWER 1)) (SET YOUR (SPEED FACTOR) TO 1.0)) 
(DEFINE (SPECIAL-DYNAMICS-OF PRINCE IN (SUBSCENE-OF WALLFLOWER 2)) SPECIAL-DYNAMICS (SET YOUR OFFSPRING TO (|(SPECIAL-DYNAMICS-OF PRINCE IN (SUBSCENE-OF WALLFLOWER 2))-5|)) (SET YOUR PATH-JAGGEDNESS TO LOW) (SET YOUR PATH-CURVATURE TO MEDIUM) (SET YOUR PATH-LENGTH TO LONG) (SET YOUR DELIBERATENESS TO MEDIUM) (SET YOUR REPETIVENESS TO HIGH) (SET YOUR ACCELERATION TO HIGH) (SET YOUR RHYTHMIC-LEVEL TO MEDIUM) (SET YOUR ACTIVITY-LEVEL TO MEDIUM) (SET YOUR SPEED TO HIGH)) 
(DEFINE |(SPECIAL-DYNAMICS-OF PRINCE IN (SUBSCENE-OF WALLFLOWER 2))-5| (SPECIAL-DYNAMICS-OF PRINCE IN (SUBSCENE-OF WALLFLOWER 2)) (SET YOUR (SPEED FACTOR) TO 0.74416667)) 
(ASK CINDERELLA TAKE LOOK (LOOK: SHAPE HEXAGON ANGLE 60 CENTER-OFFSET NIL ANI-SIZE 0.036 LOOK-COLOR (270.0 0.35 0.65))) 
(ASK STEP-MOTHER TAKE LOOK (LOOK: SHAPE TRIANGLE ANGLE 120 CENTER-OFFSET (RIGHT 30) ANI-SIZE 0.07 LOOK-COLOR (240.0 0.35 0.45))) 
(ASK FAIRY-GODMOTHER TAKE LOOK (LOOK: SHAPE EIGHT-POINTED-STAR ANGLE 135 CENTER-OFFSET NIL ANI-SIZE 0.05 LOOK-COLOR (30.0 0.65 0.85))) 
(ASK PRINCE TAKE LOOK (LOOK: SHAPE CIRCLE ANGLE 5 CENTER-OFFSET NIL ANI-SIZE 0.07 LOOK-COLOR (0.0 1.0 0.85))) 