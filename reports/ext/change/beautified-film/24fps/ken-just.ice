(DEFINE (SPECIAL-DYNAMICS-OF CINDERELLA IN (SUBSCENE-OF JUSTICE 1)) SPECIAL-DYNAMICS (SET YOUR OFFSPRING TO (|(SPECIAL-DYNAMICS-OF CINDERELLA IN (SUBSCENE-OF JUSTICE 1))-2|)) (SET YOUR PATH-JAGGEDNESS TO MEDIUM) (SET YOUR PATH-CURVATURE TO HIGH) (SET YOUR PATH-LENGTH TO MEDIUM) (SET YOUR DELIBERATENESS TO MEDIUM) (SET YOUR REPETIVENESS TO MEDIUM) (SET YOUR ACCELERATION TO LOW) (SET YOUR RHYTHMIC-LEVEL TO HIGH) (SET YOUR ACTIVITY-LEVEL TO HIGH) (SET YOUR SPEED TO LOW)) 
(DEFINE |(SPECIAL-DYNAMICS-OF CINDERELLA IN (SUBSCENE-OF JUSTICE 1))-2| (SPECIAL-DYNAMICS-OF CINDERELLA IN (SUBSCENE-OF JUSTICE 1)) (SET YOUR OFFSPRING TO (|(SPECIAL-DYNAMICS-OF CINDERELLA IN (SUBSCENE-OF JUSTICE 1))-2-3| |(SPECIAL-DYNAMICS-OF CINDERELLA IN (SUBSCENE-OF JUSTICE 1))-2-2| |(SPECIAL-DYNAMICS-OF CINDERELLA IN (SUBSCENE-OF JUSTICE 1))-2-1|)) (SET YOUR (SPEED FACTOR) TO 1.0)) 
