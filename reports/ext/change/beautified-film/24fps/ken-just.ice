;;this is all that Director need know to display the scene JUSTICE
(DEFINE JUSTICE DIRECTOR-SCENE (SET YOUR SUBSCENES TO ((SUBSCENE-OF JUSTICE 1)))) 

(DEFINE (SUBSCENE-OF JUSTICE 1) DIRECTOR-SUBSCENE (SET YOUR SCENE TO JUSTICE) (SET YOUR CONVEY-TASKS TO (CONVEY-TASK-8 CONVEY-TASK-7)) (SET YOUR ESTABLISH-TASKS TO (ESTABLISH-TASK-15)) (SET YOUR (LOCATION-OF PRINCE) TO (PLACE: WHERE (XY-POSITION -0.27212975 -0.28144122) WHY (ENDED UP HERE IN MEETING) STATUS COOL)) (SET YOUR (LOCATION-OF FAIRY-GODMOTHER) TO (PLACE: WHERE (XY-POSITION 0.17251129 -0.60000806) WHY (ENDED UP HERE IN MEETING) STATUS COOL)) (SET YOUR (LOCATION-OF STEP-MOTHER) TO (PLACE: WHERE (XY-POSITION 0.11001011 -0.6000833) WHY (ENDED UP HERE IN MEETING) STATUS COOL)) (SET YOUR (LOCATION-OF CINDERELLA) TO (PLACE: WHERE (XY-POSITION -0.34211041 -0.33061846) WHY (ENDED UP HERE IN MEETING) STATUS COOL)) (SET YOUR STRETCHED-BY TO 1.0) (SET YOUR MOVEMENTS TO ((AND (ACTIVITY-OF MOVE-NEAR-THE-GROUP 1) (ACTIVITY-OF TURN-TOWARDS-OTHERS 1)) (SEQUENCE: (REPEAT 4 (SEQUENCE: (AND (ACTIVITY-OF GOES-TO-CONTACT-OTHER 1) (ACTIVITY-OF GOES-TO-CONTACT-OTHER 2)) (AND (ACTIVITY-OF MOVE-APART-A-LITTLE 1) (ACTIVITY-OF MOVE-APART-A-LITTLE 2)))) (AND (ACTIVITY-OF GOES-TO-CONTACT-OTHER 3) (ACTIVITY-OF GOES-TO-CONTACT-OTHER 4))))) (SET YOUR PLANS TO ((ACTIVITY-OF GOES-TO-CONTACT-OTHER 2) (ACTIVITY-OF GOES-TO-CONTACT-OTHER 4) (ACTIVITY-OF MOVE-APART-A-LITTLE 2) (ACTIVITY-OF MOVE-NEAR-THE-GROUP 1) (ACTIVITY-OF GOES-TO-CONTACT-OTHER 1) (ACTIVITY-OF GOES-TO-CONTACT-OTHER 3) (ACTIVITY-OF MOVE-APART-A-LITTLE 1) (ACTIVITY-OF TURN-TOWARDS-OTHERS 1))) (SET YOUR SPECIAL-DYNAMICS TO (|(SPECIAL-DYNAMICS-OF CINDERELLA IN (SUBSCENE-OF JUSTICE 1))-2-1| |(SPECIAL-DYNAMICS-OF CINDERELLA IN (SUBSCENE-OF JUSTICE 1))-2-2-1| |(SPECIAL-DYNAMICS-OF CINDERELLA IN (SUBSCENE-OF JUSTICE 1))-2-3| |(SPECIAL-DYNAMICS-OF PRINCE IN (SUBSCENE-OF JUSTICE 1))-1-1| |(SPECIAL-DYNAMICS-OF PRINCE IN (SUBSCENE-OF JUSTICE 1))-1-2-1| |(SPECIAL-DYNAMICS-OF PRINCE IN (SUBSCENE-OF JUSTICE 1))-1-3| |(SPECIAL-DYNAMICS-OF STEP-MOTHER IN (SUBSCENE-OF JUSTICE 1))-3|)) (SET YOUR INITIAL-ACTIONS TO ((ASK STEP-MOTHER TO SET YOUR SPECIAL-DYNAMICS TO (SPECIAL-DYNAMICS-OF STEP-MOTHER IN (SUBSCENE-OF JUSTICE 1))))) (SET YOUR (CHANGES-FOR STEP-MOTHER) TO ((GRADUALLY CHANGE LOOK BY 0.66666667 FACTOR FOR COLOR-INTENSITY AT HIGH SPEED) (GRADUALLY CHANGE BY 0.66666667 FACTOR FOR ACTIVITY-LEVEL AT HIGH SPEED) (GRADUALLY CHANGE BY 0.66666667 FACTOR FOR SPEED AT HIGH SPEED) (GRADUALLY CHANGE BY 0.66666667 FACTOR FOR RHYTHMIC-LEVEL AT HIGH SPEED) (GRADUALLY CHANGE BY 0.66666667 FACTOR FOR ACCELERATION AT HIGH SPEED) (GRADUALLY CHANGE BY 2.0 FACTOR FOR PATH-LENGTH AT LOW SPEED))) (SET YOUR RUNNING-TIME TO 30.48)) 
(DEFINE (ACTIVITY-OF GOES-TO-CONTACT-OTHER 2) PLAN (SET YOUR BEGIN-TIME TO 0.0) (SET YOUR SUBSCENE TO (SUBSCENE-OF JUSTICE 1)) (SET YOUR PLANS TO ((SEQUENCE: (ASK CINDERELLA SET YOUR SPECIAL-DYNAMICS TO |(SPECIAL-DYNAMICS-OF CINDERELLA IN (SUBSCENE-OF JUSTICE 1))-2-1|) (ASK CINDERELLA INITIALIZE YOUR CURVATURE-SIGN TOWARDS (CONTACT-WITH PRINCE BY CINDERELLA)) (ASK (ACTIVITY-OF GOES-TO-CONTACT-OTHER 2) CAUSE (CINDERELLA) TO GRADUALLY GO IN ARC REGARDLESS OF COLLISIONS TO (CONTACT-WITH PRINCE BY CINDERELLA) AS MOVING-TARGET STOPPING IF (STOP-WHEN-THERE (QUOTE (SUBSCENE-OF JUSTICE 1)))))))) 
(DEFINE (ACTIVITY-OF GOES-TO-CONTACT-OTHER 4) PLAN (SET YOUR BEGIN-TIME TO 0.0) (SET YOUR SUBSCENE TO (SUBSCENE-OF JUSTICE 1)) (SET YOUR PLANS TO ((SEQUENCE: (ASK CINDERELLA SET YOUR SPECIAL-DYNAMICS TO |(SPECIAL-DYNAMICS-OF CINDERELLA IN (SUBSCENE-OF JUSTICE 1))-2-2-1|) (ASK CINDERELLA INITIALIZE YOUR CURVATURE-SIGN TOWARDS (CONTACT-WITH PRINCE BY CINDERELLA)) (ASK (ACTIVITY-OF GOES-TO-CONTACT-OTHER 4) CAUSE (CINDERELLA) TO GRADUALLY GO IN ARC REGARDLESS OF COLLISIONS TO (CONTACT-WITH PRINCE BY CINDERELLA) AS MOVING-TARGET STOPPING IF (STOP-WHEN-THERE (QUOTE (SUBSCENE-OF JUSTICE 1)))))))) 
(DEFINE (ACTIVITY-OF MOVE-APART-A-LITTLE 2) PLAN (SET YOUR BEGIN-TIME TO 1.0) (SET YOUR SUBSCENE TO (SUBSCENE-OF JUSTICE 1)) (SET YOUR PLANS TO ((SEQUENCE: (ASK CINDERELLA SET YOUR SPECIAL-DYNAMICS TO |(SPECIAL-DYNAMICS-OF CINDERELLA IN (SUBSCENE-OF JUSTICE 1))-2-3|) (ASK CINDERELLA INITIALIZE YOUR CURVATURE-SIGN TOWARDS (A-LITTLE-BIT-AWAY-FROM (VICINITY-OF CINDERELLA) (VICINITY-OF PRINCE))) (ASK (ACTIVITY-OF MOVE-APART-A-LITTLE 2) CAUSE (CINDERELLA) TO GRADUALLY GO IN ARC CAREFUL OF COLLISIONS TO (A-LITTLE-BIT-AWAY-FROM (VICINITY-OF CINDERELLA) (VICINITY-OF PRINCE)) AS STATIONARY-TARGET STOPPING IF (STOP-WHEN-MOVED-ORIGINAL-DISTANCE-THEN (QUOTE (SUBSCENE-OF JUSTICE 1)) (STOP-PLAN (QUOTE (ACTIVITY-OF MOVE-APART-A-LITTLE 1))))))))) 
(DEFINE (ACTIVITY-OF MOVE-NEAR-THE-GROUP 1) PLAN (SET YOUR BEGIN-TIME TO 0.0) (SET YOUR SUBSCENE TO (SUBSCENE-OF JUSTICE 1)) (SET YOUR PLANS TO ((SEQUENCE: (ASK STEP-MOTHER SET YOUR SPECIAL-DYNAMICS TO |(SPECIAL-DYNAMICS-OF STEP-MOTHER IN (SUBSCENE-OF JUSTICE 1))-3|) (ASK STEP-MOTHER INITIALIZE YOUR CURVATURE-SIGN TOWARDS (SMALL-DISTANCE-FROM-CENTER-OF (VICINITY-OF PRINCE) (VICINITY-OF CINDERELLA))) (ASK (ACTIVITY-OF MOVE-NEAR-THE-GROUP 1) CAUSE (STEP-MOTHER) TO GRADUALLY GO IN ARC CAREFUL OF COLLISIONS TO (SMALL-DISTANCE-FROM-CENTER-OF (VICINITY-OF PRINCE) (VICINITY-OF CINDERELLA)) AS MOVING-TARGET STOPPING IF (STOP-WHEN-THERE (QUOTE (SUBSCENE-OF JUSTICE 1)))))))) 
(DEFINE (ACTIVITY-OF GOES-TO-CONTACT-OTHER 1) PLAN (SET YOUR BEGIN-TIME TO 0.0) (SET YOUR SUBSCENE TO (SUBSCENE-OF JUSTICE 1)) (SET YOUR PLANS TO ((SEQUENCE: (ASK PRINCE SET YOUR SPECIAL-DYNAMICS TO |(SPECIAL-DYNAMICS-OF PRINCE IN (SUBSCENE-OF JUSTICE 1))-1-1|) (ASK PRINCE INITIALIZE YOUR CURVATURE-SIGN TOWARDS (CONTACT-WITH CINDERELLA BY PRINCE)) (ASK (ACTIVITY-OF GOES-TO-CONTACT-OTHER 1) CAUSE (PRINCE) TO GRADUALLY GO IN ARC REGARDLESS OF COLLISIONS TO (CONTACT-WITH CINDERELLA BY PRINCE) AS MOVING-TARGET STOPPING IF (STOP-WHEN-THERE (QUOTE (SUBSCENE-OF JUSTICE 1)))))))) 
(DEFINE (ACTIVITY-OF GOES-TO-CONTACT-OTHER 3) PLAN (SET YOUR BEGIN-TIME TO 0.0) (SET YOUR SUBSCENE TO (SUBSCENE-OF JUSTICE 1)) (SET YOUR PLANS TO ((SEQUENCE: (ASK PRINCE SET YOUR SPECIAL-DYNAMICS TO |(SPECIAL-DYNAMICS-OF PRINCE IN (SUBSCENE-OF JUSTICE 1))-1-2-1|) (ASK PRINCE INITIALIZE YOUR CURVATURE-SIGN TOWARDS (CONTACT-WITH CINDERELLA BY PRINCE)) (ASK (ACTIVITY-OF GOES-TO-CONTACT-OTHER 3) CAUSE (PRINCE) TO GRADUALLY GO IN ARC REGARDLESS OF COLLISIONS TO (CONTACT-WITH CINDERELLA BY PRINCE) AS MOVING-TARGET STOPPING IF (STOP-WHEN-THERE (QUOTE (SUBSCENE-OF JUSTICE 1)))))))) 
(DEFINE (ACTIVITY-OF MOVE-APART-A-LITTLE 1) PLAN (SET YOUR BEGIN-TIME TO 1.0) (SET YOUR SUBSCENE TO (SUBSCENE-OF JUSTICE 1)) (SET YOUR PLANS TO ((SEQUENCE: (ASK PRINCE SET YOUR SPECIAL-DYNAMICS TO |(SPECIAL-DYNAMICS-OF PRINCE IN (SUBSCENE-OF JUSTICE 1))-1-3|) (ASK PRINCE INITIALIZE YOUR CURVATURE-SIGN TOWARDS (A-LITTLE-BIT-AWAY-FROM (VICINITY-OF PRINCE) (VICINITY-OF CINDERELLA))) (ASK (ACTIVITY-OF MOVE-APART-A-LITTLE 1) CAUSE (PRINCE) TO GRADUALLY GO IN ARC CAREFUL OF COLLISIONS TO (A-LITTLE-BIT-AWAY-FROM (VICINITY-OF PRINCE) (VICINITY-OF CINDERELLA)) AS STATIONARY-TARGET STOPPING IF (STOP-WHEN-MOVED-ORIGINAL-DISTANCE-THEN (QUOTE (SUBSCENE-OF JUSTICE 1)) (STOP-PLAN (QUOTE (ACTIVITY-OF MOVE-APART-A-LITTLE 2))))))))) 
(DEFINE (ACTIVITY-OF TURN-TOWARDS-OTHERS 1) PLAN (SET YOUR SUBSCENE TO (SUBSCENE-OF JUSTICE 1)) (SET YOUR BEGIN-TIME TO (AFTER (END-OF (ACTIVITY-OF MOVE-NEAR-THE-GROUP 1)) 0.5)) (SET YOUR PLANS TO ((SEQUENCE: (ASK STEP-MOTHER SET YOUR SPECIAL-DYNAMICS TO |(SPECIAL-DYNAMICS-OF STEP-MOTHER IN (SUBSCENE-OF JUSTICE 1))-3|) (ASK (ACTIVITY-OF TURN-TOWARDS-OTHERS 1) GRADUALLY FACE STEP-MOTHER TOWARDS (VICINITY-OF PRINCE) PLUS 0.0) (ASK (ACTIVITY-OF TURN-TOWARDS-OTHERS 1) GRADUALLY FACE STEP-MOTHER TOWARDS (VICINITY-OF CINDERELLA) PLUS 0.0))))) 
(DEFINE (SPECIAL-DYNAMICS-OF PRINCE IN (SUBSCENE-OF JUSTICE 1)) SPECIAL-DYNAMICS (SET YOUR OFFSPRING TO (|(SPECIAL-DYNAMICS-OF PRINCE IN (SUBSCENE-OF JUSTICE 1))-1|)) (SET YOUR PATH-JAGGEDNESS TO LOW) (SET YOUR PATH-CURVATURE TO MEDIUM) (SET YOUR PATH-LENGTH TO LONG) (SET YOUR DELIBERATENESS TO MEDIUM) (SET YOUR REPETIVENESS TO HIGH) (SET YOUR ACCELERATION TO HIGH) (SET YOUR RHYTHMIC-LEVEL TO MEDIUM) (SET YOUR ACTIVITY-LEVEL TO MEDIUM) (SET YOUR SPEED TO HIGH)) 
