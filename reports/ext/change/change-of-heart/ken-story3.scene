;;this is all that Director need know to display the scene KIND-AGAIN
(DEFINE KIND-AGAIN DIRECTOR-SCENE (SET YOUR SUBSCENES TO ((SUBSCENE-OF KIND-AGAIN 1)))) 

(DEFINE (SUBSCENE-OF KIND-AGAIN 1) DIRECTOR-SUBSCENE (SET YOUR SCENE TO KIND-AGAIN) (SET YOUR ESTABLISH-TASKS TO (ESTABLISH-TASK-6 ESTABLISH-TASK-5)) (SET YOUR CONVEY-TASKS TO (CONVEY-TASK-3)) (SET YOUR (LOCATION-OF PRINCE) TO (PLACE: WHERE (XY-POSITION 0.3751072 -0.37488759) WHY (ENDED UP HERE IN CHANGE-OF-HEART) STATUS COOL)) (SET YOUR (LOCATION-OF FAIRY-GODMOTHER) TO (PLACE: WHERE (XY-POSITION 0.0 0.0) WHY (ENDED UP HERE IN CHANGE-OF-HEART) STATUS COOL)) (SET YOUR (LOCATION-OF STEP-MOTHER) TO (PLACE: WHERE (XY-POSITION 0.25934851 -0.31948068) WHY (ENDED UP HERE IN CHANGE-OF-HEART) STATUS COOL)) (SET YOUR (LOCATION-OF CINDERELLA) TO (PLACE: WHERE (XY-POSITION -0.054879334 0.14954058) WHY (ENDED UP HERE IN CHANGE-OF-HEART) STATUS COOL)) (SET YOUR STRETCHED-BY TO 1.0) (SET YOUR MOVEMENTS TO ((AND (ACTIVITY-OF GETTING-ON-STAGE 1) (ACTIVITY-OF GOES-TO-TO-ACCOMPANY 1) (ACTIVITY-OF ACCOMPANYING-EACH-OTHER 1)))) (SET YOUR INITIAL-ACTIONS TO ((ASK CINDERELLA TO SET YOUR SPECIAL-DYNAMICS TO (SPECIAL-DYNAMICS-OF CINDERELLA IN (SUBSCENE-OF KIND-AGAIN 1))))) (SET YOUR (CHANGES-FOR CINDERELLA) TO ((GRADUALLY CHANGE LOOK BY 1.25 FACTOR FOR COLOR-INTENSITY AT MEDIUM SPEED) (GRADUALLY CHANGE BY 1.25 FACTOR FOR ACTIVITY-LEVEL AT MEDIUM SPEED) (GRADUALLY CHANGE BY 1.25 FACTOR FOR SPEED AT MEDIUM SPEED) (GRADUALLY CHANGE BY 1.25 FACTOR FOR RHYTHMIC-LEVEL AT MEDIUM SPEED) (GRADUALLY CHANGE BY 1.25 FACTOR FOR ACCELERATION AT MEDIUM SPEED) (GRADUALLY CHANGE BY 2.0 FACTOR FOR PATH-LENGTH AT HIGH SPEED))) (SET YOUR SPECIAL-DYNAMICS TO (|(SPECIAL-DYNAMICS-OF CINDERELLA IN (SUBSCENE-OF KIND-AGAIN 1))-5| |(SPECIAL-DYNAMICS-OF STEP-MOTHER IN (SUBSCENE-OF KIND-AGAIN 1))-4| |(SPECIAL-DYNAMICS-OF STEP-MOTHER IN (SUBSCENE-OF KIND-AGAIN 1))-4-1|)) (SET YOUR PLANS TO ((ACTIVITY-OF GETTING-ON-STAGE 1) (ACTIVITY-OF GOES-TO-TO-ACCOMPANY 1) (ACTIVITY-OF ACCOMPANYING-EACH-OTHER 1))) (SET YOUR RUNNING-TIME TO 3.98)) 
(DEFINE (ACTIVITY-OF GETTING-ON-STAGE 1) PLAN (SET YOUR BEGIN-TIME TO 0.0) (SET YOUR SUBSCENE TO (SUBSCENE-OF KIND-AGAIN 1)) (SET YOUR PLANS TO ((SEQUENCE: (ASK CINDERELLA SET YOUR SPECIAL-DYNAMICS TO |(SPECIAL-DYNAMICS-OF CINDERELLA IN (SUBSCENE-OF KIND-AGAIN 1))-5|) (ASK CINDERELLA INITIALIZE YOUR CURVATURE-SIGN TOWARDS (ON-STAGE-NEAR CINDERELLA (VICINITY-OF STEP-MOTHER))) (ASK (ACTIVITY-OF GETTING-ON-STAGE 1) CAUSE (CINDERELLA) TO GRADUALLY GO IN ARC CAREFUL OF COLLISIONS TO (ON-STAGE-NEAR CINDERELLA (VICINITY-OF STEP-MOTHER)) AS STATIONARY-TARGET STOPPING IF (STOP-WHEN-THERE (QUOTE (SUBSCENE-OF KIND-AGAIN 1)))))))) 
(DEFINE (ACTIVITY-OF GOES-TO-TO-ACCOMPANY 1) PLAN (SET YOUR BEGIN-TIME TO 0.5) (SET YOUR SUBSCENE TO (SUBSCENE-OF KIND-AGAIN 1)) (SET YOUR PLANS TO ((SEQUENCE: (ASK STEP-MOTHER SET YOUR SPECIAL-DYNAMICS TO |(SPECIAL-DYNAMICS-OF STEP-MOTHER IN (SUBSCENE-OF KIND-AGAIN 1))-4|) (ASK STEP-MOTHER INITIALIZE YOUR CURVATURE-SIGN TOWARDS (CONTACT-WITH CINDERELLA BY STEP-MOTHER)) (ASK (ACTIVITY-OF GOES-TO-TO-ACCOMPANY 1) CAUSE (STEP-MOTHER) TO GRADUALLY GO IN ARC CAREFUL OF COLLISIONS TO (CONTACT-WITH CINDERELLA BY STEP-MOTHER) AS MOVING-TARGET STOPPING IF (STOP-WHEN-THERE-THEN (QUOTE (SUBSCENE-OF KIND-AGAIN 1)) (STOP-PLAN (QUOTE (ACTIVITY-OF GETTING-ON-STAGE 1))))))))) 
(DEFINE (ACTIVITY-OF ACCOMPANYING-EACH-OTHER 1) PLAN (SET YOUR BEGIN-TIME TO (AFTER (END-OF (ACTIVITY-OF GOES-TO-TO-ACCOMPANY 1)) 0.5)) (SET YOUR SUBSCENE TO (SUBSCENE-OF KIND-AGAIN 1)) (SET YOUR PLANS TO ((SEQUENCE: (ASK STEP-MOTHER SET YOUR SPECIAL-DYNAMICS TO |(SPECIAL-DYNAMICS-OF STEP-MOTHER IN (SUBSCENE-OF KIND-AGAIN 1))-4-1|) (ASK STEP-MOTHER INITIALIZE YOUR CURVATURE-SIGN TOWARDS (GOOD-DISTANCE-FROM (VICINITY-OF STEP-MOTHER))) (ASK (ACTIVITY-OF ACCOMPANYING-EACH-OTHER 1) CAUSE (STEP-MOTHER CINDERELLA) TO GRADUALLY GO IN ARC CAREFUL OF COLLISIONS TO (GOOD-DISTANCE-FROM (VICINITY-OF STEP-MOTHER)) AS STATIONARY-TARGET STOPPING IF (STOP-IF-EITHER-WANTS-TO (STOP-AFTER-SO-MANY-SECONDS 2.98) (STOP-WHEN-THERE (QUOTE (SUBSCENE-OF KIND-AGAIN 1))))))))) 
(DEFINE (SPECIAL-DYNAMICS-OF STEP-MOTHER IN (SUBSCENE-OF KIND-AGAIN 1)) SPECIAL-DYNAMICS (SET YOUR OFFSPRING TO (|(SPECIAL-DYNAMICS-OF STEP-MOTHER IN (SUBSCENE-OF KIND-AGAIN 1))-4| |(SPECIAL-DYNAMICS-OF STEP-MOTHER IN (SUBSCENE-OF KIND-AGAIN 1))-3| |(SPECIAL-DYNAMICS-OF STEP-MOTHER IN (SUBSCENE-OF KIND-AGAIN 1))-2| |(SPECIAL-DYNAMICS-OF STEP-MOTHER IN (SUBSCENE-OF KIND-AGAIN 1))-1|)) (SET YOUR PATH-JAGGEDNESS TO LOW) (SET YOUR PATH-CURVATURE TO MEDIUM) (SET YOUR PATH-LENGTH TO LONG) (SET YOUR DELIBERATENESS TO HIGH) (SET YOUR REPETIVENESS TO MEDIUM) (SET YOUR ACCELERATION TO MEDIUM) (SET YOUR RHYTHMIC-LEVEL TO MEDIUM) (SET YOUR ACTIVITY-LEVEL TO HIGH) (SET YOUR SPEED TO HIGH) (SET YOUR DOMINATES TO (CINDERELLA))) 
(DEFINE |(SPECIAL-DYNAMICS-OF STEP-MOTHER IN (SUBSCENE-OF KIND-AGAIN 1))-1| (SPECIAL-DYNAMICS-OF STEP-MOTHER IN (SUBSCENE-OF KIND-AGAIN 1)) (SET YOUR (SPEED FACTOR) TO 0.8)) 
(DEFINE |(SPECIAL-DYNAMICS-OF STEP-MOTHER IN (SUBSCENE-OF KIND-AGAIN 1))-2| (SPECIAL-DYNAMICS-OF STEP-MOTHER IN (SUBSCENE-OF KIND-AGAIN 1)) (SET YOUR (SPEED FACTOR) TO 0.8)) 
(DEFINE |(SPECIAL-DYNAMICS-OF STEP-MOTHER IN (SUBSCENE-OF KIND-AGAIN 1))-3| (SPECIAL-DYNAMICS-OF STEP-MOTHER IN (SUBSCENE-OF KIND-AGAIN 1)) (SET YOUR (SPEED FACTOR) TO 0.8)) 
(DEFINE |(SPECIAL-DYNAMICS-OF STEP-MOTHER IN (SUBSCENE-OF KIND-AGAIN 1))-4| (SPECIAL-DYNAMICS-OF STEP-MOTHER IN (SUBSCENE-OF KIND-AGAIN 1)) (SET YOUR OFFSPRING TO (|(SPECIAL-DYNAMICS-OF STEP-MOTHER IN (SUBSCENE-OF KIND-AGAIN 1))-4-1|)) (SET YOUR (SPEED FACTOR) TO 1.0)) 
(DEFINE |(SPECIAL-DYNAMICS-OF STEP-MOTHER IN (SUBSCENE-OF KIND-AGAIN 1))-4-1| |(SPECIAL-DYNAMICS-OF STEP-MOTHER IN (SUBSCENE-OF KIND-AGAIN 1))-4| (SET YOUR (SPEED FACTOR) TO 0.8)) 
(DEFINE (SPECIAL-DYNAMICS-OF CINDERELLA IN (SUBSCENE-OF KIND-AGAIN 1)) SPECIAL-DYNAMICS (SET YOUR OFFSPRING TO (|(SPECIAL-DYNAMICS-OF CINDERELLA IN (SUBSCENE-OF KIND-AGAIN 1))-5|)) (SET YOUR PATH-JAGGEDNESS TO MEDIUM) (SET YOUR PATH-CURVATURE TO HIGH) (SET YOUR PATH-LENGTH TO MEDIUM) (SET YOUR DELIBERATENESS TO MEDIUM) (SET YOUR REPETIVENESS TO MEDIUM) (SET YOUR ACCELERATION TO LOW) (SET YOUR RHYTHMIC-LEVEL TO HIGH) (SET YOUR ACTIVITY-LEVEL TO HIGH) (SET YOUR SPEED TO LOW)) 
(DEFINE |(SPECIAL-DYNAMICS-OF CINDERELLA IN (SUBSCENE-OF KIND-AGAIN 1))-5| (SPECIAL-DYNAMICS-OF CINDERELLA IN (SUBSCENE-OF KIND-AGAIN 1)) (SET YOUR (SPEED FACTOR) TO 1.0)) 
(ASK CINDERELLA TAKE LOOK (LOOK: SHAPE HEXAGON ANGLE 60 CENTER-OFFSET NIL ANI-SIZE 0.036 LOOK-COLOR (270.0 0.35 0.65))) 
(ASK STEP-MOTHER TAKE LOOK (LOOK: SHAPE TRIANGLE ANGLE 120 CENTER-OFFSET (RIGHT 30) ANI-SIZE 0.07 LOOK-COLOR (240.0 0.35 0.45))) 
(ASK FAIRY-GODMOTHER TAKE LOOK (LOOK: SHAPE EIGHT-POINTED-STAR ANGLE 135 CENTER-OFFSET NIL ANI-SIZE 0.05 LOOK-COLOR (30.0 0.65 0.85))) 
(ASK PRINCE TAKE LOOK (LOOK: SHAPE CIRCLE ANGLE 5 CENTER-OFFSET NIL ANI-SIZE 0.07 LOOK-COLOR (0.0 1.0 0.85))) 